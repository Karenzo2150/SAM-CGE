3354  *------------------------------------------------------------------
3355  *2.4.3  Numeraire
3356  *------------------------------------------------------------------
3357   
3358  *Numeraire closure 1: Fixed consumer price index
3359  IF(NUMERAIRE(SIMC) EQ 1,
3360  *   Fixed consumer price index
3361   CPI.FX = CPI0;
3362  *   Flexible domestic price index
3363   DPI.LO = -INF;
3364   DPI.UP = +INF;
3365   DPI.L  = DPI0;
3366  );
3367   
3368  *Numeraire closure 2: Fixed domestic price index
3369  IF(NUMERAIRE(SIMC) EQ 2,
3370  *   Flexible consumer price index
3371   CPI.LO = -INF;
3372   CPI.UP = +INF;
3373   CPI.L  = CPI0;
3374  *   Fixed domestic price index
3375   DPI.FX = DPI0;
3376  );
3377   
