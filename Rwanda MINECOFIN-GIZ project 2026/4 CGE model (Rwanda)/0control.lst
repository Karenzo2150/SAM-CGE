4928   r_STRUCBASE(RA,STRCOL) $(NOT r_STRUCBASE(RA,STRCOL)) = eps;
4929   r_TAXBASE(RA,TAXAC)    $(NOT r_TAXBASE(RA,TAXAC)   ) = eps;
