3961   TIADJ.FX    = TIADJSIM(SIMC);
3962  *   Fixed uniform direct taxes (TINS) for selected institutions
3963   DTI.FX      = DTISIM(SIMC);
3964  *   Fixed scaled composite commodity taxes (TQ) for selected commodities
3965   TQADJ.FX    = TQADJSIM(SIMC);
3966  *   Fixed uniform composite commodity taxes (TQ) for selected commodities
3967   DTQ.FX      = DTQSIM(SIMC);
3968  *   Fixed scaled activity taxes (TA) for selected activities
3969   TAADJ.FX    = TAADJSIM(SIMC);
3970  *   Fixed uniform activity taxes (TA) for selected activities
3971   DTA.FX      = DTASIM(SIMC);
3972  *   Fixed scaled import tariffs (TM) for selected commodities
3973   TMADJ.FX    = TMADJSIM(SIMC);
3974  *   Fixed uniform import tariffs (TM) for selected commodities
3975   DTM.FX      = DTMSIM(SIMC);
3976  *   Fixed scaled export taxes (TE) for selected commodities
3977   TEADJ.FX    = TEADJSIM(SIMC);
3978  *   Fixed uniform export taxes (TE) for selected commodities
3979   DTE.FX      = DTESIM(SIMC);
3980  *   Fixed scaled value-added taxes (TVA) for selected activities
3981   TVADJ.LO    = -INF;
3982   TVADJ.UP    = +INF;
3983   TVADJ.L     = TVADJSIM(SIMC);
3984  *   Fixed uniform value-added taxes (TVA) for selected activities
3985   DTV.FX      = DTVSIM(SIMC);
3986  *   Fixed scaled factor taxes (TF) for selected factors
3987   TFADJ.FX    = TFADJSIM(SIMC);
3988  *   Fixed uniform factor taxes (TF) for selected factors
3989   DTF.FX      = DTFSIM(SIMC);
3990  );
3991   
3992  *Government closure 14: Government savings are fixed and factor tax rates adjust (uniform adjustments to tax rates)
3993  IF(GOVCLOSE(SIMC) EQ 14,
3994  *   Flexible government savings
3995   GSAV.FX     = GSAVSIM(SIMC);
3996  *   Fixed scaled direct taxes (TINS) for selected institutions
3997   TIADJ.FX    = TIADJSIM(SIMC);
3998  *   Fixed uniform direct taxes (TINS) for selected institutions
3999   DTI.FX      = DTISIM(SIMC);
4000  *   Fixed scaled composite commodity taxes (TQ) for selected commodities
4001   TQADJ.FX    = TQADJSIM(SIMC);
4002  *   Fixed uniform composite commodity taxes (TQ) for selected commodities
4003   DTQ.FX      = DTQSIM(SIMC);
4004  *   Fixed scaled activity taxes (TA) for selected activities
4005   TAADJ.FX    = TAADJSIM(SIMC);
4006  *   Fixed uniform activity taxes (TA) for selected activities
4007   DTA.FX      = DTASIM(SIMC);
4008  *   Fixed scaled import tariffs (TM) for selected commodities
4009   TMADJ.FX    = TMADJSIM(SIMC);
4010  *   Fixed uniform import tariffs (TM) for selected commodities
4011   DTM.FX      = DTMSIM(SIMC);
4012  *   Fixed scaled export taxes (TE) for selected commodities
4013   TEADJ.FX    = TEADJSIM(SIMC);
4014  *   Fixed uniform export taxes (TE) for selected commodities
4015   DTE.FX      = DTESIM(SIMC);
4016  *   Fixed scaled value-added taxes (TVA) for selected activities
4017   TVADJ.FX    = TVADJSIM(SIMC);
4018  *   Fixed uniform value-added taxes (TVA) for selected activities
4019   DTV.FX      = DTVSIM(SIMC);
4020  *   Fixed scaled factor taxes (TF) for selected factors
4021   TFADJ.FX    = TFADJSIM(SIMC);
4022  *   Fixed uniform factor taxes (TF) for selected factors
4023   DTF.LO      = -INF;
4024   DTF.UP      = +INF;
4025   DTF.L       = DTFSIM(SIMC);
4026  );
4027   
4028  *Government closure 15: Government savings are fixed and factor tax rates adjust (scaled adjustments to tax rates)
4029  IF(GOVCLOSE(SIMC) EQ 15,
4030  *   Flexible government savings
4031   GSAV.FX     = GSAVSIM(SIMC);
4032  *   Fixed scaled direct taxes (TINS) for selected institutions
4033   TIADJ.FX    = TIADJSIM(SIMC);
4034  *   Fixed uniform direct taxes (TINS) for selected institutions
4035   DTI.FX      = DTISIM(SIMC);
4036  *   Fixed scaled composite commodity taxes (TQ) for selected commodities
4037   TQADJ.FX    = TQADJSIM(SIMC);
4038  *   Fixed uniform composite commodity taxes (TQ) for selected commodities
4039   DTQ.FX      = DTQSIM(SIMC);
