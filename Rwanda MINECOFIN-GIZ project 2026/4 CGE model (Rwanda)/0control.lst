2453   ATYPF(SIMAC,SIM)$(ORD(SIM)-1 EQ 5)  =  TYP5F(SIMAC);
2454   ATYPF(SIMAC,SIM)$(ORD(SIM)-1 EQ 6)  =  TYP6F(SIMAC);
2455   ATYPF(SIMAC,SIM)$(ORD(SIM)-1 EQ 7)  =  TYP7F(SIMAC);
2456   ATYPF(SIMAC,SIM)$(ORD(SIM)-1 EQ 8)  =  TYP8F(SIMAC);
2457   ATYPF(SIMAC,SIM)$(ORD(SIM)-1 EQ 9)  =  TYP9F(SIMAC);
2458   ATYPF(SIMAC,SIM)$(ORD(SIM)-1 EQ 10) = TYP10F(SIMAC);
2459   ATYPF(SIMAC,SIM)$(ORD(SIM)-1 EQ 11) = TYP11F(SIMAC);
