1069  *SMALL TRADE AND VALUE-ADDED SHARES ---------------------------
1070   
1071   ACTFACSHR(F,A)$SUM(FP, SAM(FP,A)) = SAM(F,A) / SUM(FP, SAM(FP,A));
1072   ACTVASHR(A) = SUM(F, SAM(F,A)) / SUM((F,AP), SAM(F,AP));
1073   
1074   EXPSHR(C)$SUM(A, SAM(A,C))
1075           = (SAM(C,'ROW') - TAXPAR('EXPTAX',C) - SUM(CTE, SAM(CTE,C))) / SUM(A, SAM(A,C));
1076   
1077   IMPSHR(C)$(SAM(C,'TOTAL') - SAM(C,'ROW') - TAXPAR('COMTAX',C))
1078           = (SAM('ROW',C) + TAXPAR('IMPTAX',C) + SUM(CTM, SAM(CTM,C))) / (SAM(C,'TOTAL') - SAM(C,'ROW') - TAXPAR('COMTAX',C));
1079   
1080   SHRCUTOFF('FAC') = 0.05;
1081   SHRCUTOFF('VA')  = 0.05;
1082   SHRCUTOFF('EXP') = 0.05;
1083   SHRCUTOFF('IMP') = 0.05;
1084   
1085  *If SHRCUTOFF is set at 1 or larger, no shares are eliminated from display
1086  *SHRCUTOFF(SHRITEM) = 1;
1087   
1088  *Eliminating shares that are above the cutoff from display.
1089   ACTFACSHR(F,A)$(NOT (ACTFACSHR(F,A) LT SHRCUTOFF('FAC'))) = 0;
1090   ACTVASHR(A)$(NOT (ACTVASHR(A) LT SHRCUTOFF('VA'))) = 0;
1091   EXPSHR(C)$(NOT (EXPSHR(C) LT SHRCUTOFF('EXP'))) = 0;
1092   IMPSHR(C)$(NOT (IMPSHR(C) LT SHRCUTOFF('IMP'))) = 0;
1093   
