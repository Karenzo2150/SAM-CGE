 613   
      PART 1.4: Import country data 
       This include file (includes\1base_data.inc) imports country data from the Excel selected
       by the user (base_%data%.xlsx) and makes any adjustments to the data prior to calibration.
       
      SECTIONS:
       1.4.1  Data sets and parameters 
       1.4.2  SAM adjustments
       1.4.3  Factor quantities
       1.4.4  SAM dependent set definitions 
 625   
 626   
 627  *------------------------------------------------------------------
 628  *1.4.1  Data sets and parameters
 629  *------------------------------------------------------------------
 630   
 631  SET
 632  *Subsets
 633   AAGR(A)            activities - agriculture
 634   ANAG(A)            activities - non-agruiculture
 635   AIND(A)            activities - industry
 636   ASRV(A)            activities - services
 637   CAGR(C)            commodities - agriculture
 638   CNAG(C)            commodities - non-agriculture
 639   CIND(C)            commodities - industry
 640   CSRV(C)            commodities - services
 641   FLAB(F)            factors - labor
 642   FLND(F)            factors - land
 643   FCAP(F)            factors - capital
 644   EN(INS)            enterprises
 645   TAXES(AC)          tax types in SAM
 646  *Data sets
 647   EF                 headings for elasticity tables         / ACES, ACCES, ELASAC, ELASCA, ELASPRD, ELASPRD2, SIGMAQ, SIGMAT /
 648   TX                 tax types in model                     / ACTTAX, COMTAX, EXPTAX, FACTAX, IMPTAX, INSTAX, VATTAX /
 649  *Data adjustments
 650   CXREM(C)           remove small export flows (zero out and move to stocks)
 651   CMREM(C)           remove small import flows (zero out and move to stocks)
 652   CXREX(C)           net out re-export flows (reduce imports until all production is exported)
 653   CXNET(C)           net out exports (zero exports and move to imports)
 654   CMNET(C)           net out imports (zero imports and move to exports)
 655  *Mappings
 656   MAPAC(A,C)         mapping from activities to commodities
 657   MAPTX(TX,AC)       mapping from SAM tax accounts to tax accounts TX
 658  ;
 659   
 660  SINGLETON SETS
 661   CTC(AC)            aggregate transactions cost
 662   CTD(AC)            domestic transactions cost account
 663   CTE(AC)            export transactions cost account
 664   CTM(AC)            import transactions cost account
 665   SI(AC)             savings-investment
 666   STK(AC)            inventory investment
 667  ;
 668   
 669  SCALAR
 670  *Control
 671   SAMSCALE           scaling factor for SAM values (muliplier)
 672   LABSCALE           scaling factor for labor factor quantity or wage data (muliplier)
 673   LNDSCALE           scaling factor for land factor quantity or rental rate data (muliplier)
 674   CAPSCALE           scaling factor for capital factor quantity or rental rate data (muliplier)
 675   POPSCALE           scaling factor for population (muliplier)
 676   QWBASE             country's factor data is either quantities (1) or wages (2)
 677   EXRBASE            base year exchange rate (LCUs per FCU)
 678  ;
 679   
 680  PARAMETER
 681  *SAM
 682   SAM(AC,ACP)        standard social accounting matrix (SAM)
 683  *Elasticities
 684   AELAS(A,EF)        activity based elasticities data
 685   CELAS(C,EF)        commodity based elasticities data
 686   FFORM(A,EF)        choice of production funtional forms
 687  *Demand
 688   FRISCH(H)          Frisch parameter for LES demand system
 689   HELAS(AC,H)        household expenditure elasticities (activity and commodity)
 690  *Factors
 691   QFSBASE(F)         base year total supply quantity for factor F
 692   QFBASE(A,F)        base year factor employment for factor F in activity A
 693  *Households
 694   HPOP(H)             base year population numbers for household H
 695   QFSHBASE(H,F)      base year factor endowments for household H
 696  *Calibration parameters
 697   SAMBALCHK(AC)      column minus row total for SAM
 698   TAXPAR(TX,AC)      tax payments by type of tax TX
 699  ;
 700   
 701  ALIAS
 702   (C,CPP), (ACNT,ACNTP), (EN,ENP), (INS,INSP), (INSD,INSDP), (INSDNG,INSDNGP,INSDNGPP)
 703  ;
 704   
 705  *Read input data from excel file
GDXIN   C:\Users\EARAGIE\IFPRI Dropbox\Emerta Aragie\Rwanda MINECOFIN-GIZ project 2026\4 CGE model (Rwanda)\data.gdx
 708  *Read sets and data
--- LOAD  AC = 1:AC
--- LOAD  A = 2:A
--- LOAD  C = 6:C
--- LOAD  F = 10:F
--- LOAD  INS = 14:INS
--- LOAD  AAGR = 3:AAGR
--- LOAD  AIND = 4:AIND
--- LOAD  ASRV = 5:ASRV
--- LOAD  CAGR = 7:CAGR
--- LOAD  CIND = 8:CIND
--- LOAD  CSRV = 9:CSRV
--- LOAD  FLAB = 11:FLAB
--- LOAD  FLND = 12:FLND
--- LOAD  FCAP = 13:FCAP
--- LOAD  INSD = 15:INSD
--- LOAD  INSDNG = 16:INSDNG
--- LOAD  EN = 17:EN
--- LOAD  H = 18:H
--- LOAD  GV = 19:GV
--- LOAD  CTC = 20:CTC
--- LOAD  CTD = 21:CTD
--- LOAD  CTE = 22:CTE
--- LOAD  CTM = 23:CTM
--- LOAD  RW = 24:RW
--- LOAD  SI = 25:SI
--- LOAD  STK = 26:STK
--- LOAD  TAXES = 27:TAXES
--- LOAD  MAPTX = 28:MAPTX
--- LOAD  MAPAC = 29:MAPAC
--- LOAD  SAMSCALE = 40:SAMSCALE
--- LOAD  LABSCALE = 41:LABSCALE
--- LOAD  LNDSCALE = 42:LNDSCALE
--- LOAD  CAPSCALE = 43:CAPSCALE
--- LOAD  POPSCALE = 44:POPSCALE
--- LOAD  CXREM = 47:CXREM
--- LOAD  CMREM = 48:CMREM
--- LOAD  CXREX = 49:CXREX
--- LOAD  CXNET = 50:CXNET
--- LOAD  CMNET = 51:CMNET
--- LOAD  QWBASE = 45:QWBASE
--- LOAD  EXRBASE = 46:EXRBASE
--- LOAD  SAM = 30:SAM
--- LOAD  AELAS = 31:AELAS
--- LOAD  CELAS = 32:CELAS
--- LOAD  FFORM = 33:FFORM
--- LOAD  FRISCH = 34:FRISCH
--- LOAD  HELAS = 35:HELAS
--- LOAD  QFSBASE = 36:QFSBASE
--- LOAD  QFBASE = 37:QFBASE
--- LOAD  HPOP = 38:HPOP
--- LOAD  QFSHBASE = 39:QFSHBASE
 714   
 715  *Further set definitions
 716  *  Activities with data in the SAM
 717   AA(A)$SAM('TOTAL',A)     = YES;
 718  *  Activities with top-level CES aggregation (otherwise Leontief)
 719   ACES(A)                  = NO;
 720   ALEO(A)$(NOT ACES(A))    = YES;
 721  *  Activities with CET output disaggregation (otherwise Leontief)
 722   ACCES(A)$AA(A)           = YES;
 723  *  Factors with data in the SAM
 724   FA(F)$SAM(F,'TOTAL')     = YES;
 725  *  Household-commodity and household-activity consumption combinations in the SAM
 726   HA(A,H)$SAM(A,H)         = YES;
 727   HC(C,H)$SAM(C,H)         = YES;
 728  *Nonagricultural activities and commodities
 729   ANAG(A)$(NOT AAGR(A))    = YES;
 730   CNAG(C)$(NOT CAGR(C))    = YES;
 731  *All accounts, except for TOTAL
 732   ACNT(AC)                 = YES;
 733   ACNT('TOTAL')            = NO;
 734   
 735  *Scaling SAM values and quantities data
 736   SAM(AC,ACP)      = SAM(AC,ACP)*SAMSCALE;
 737   QFBASE(A,FLAB)   = QFBASE(A,FLAB)*LABSCALE;
 738   QFBASE(A,FLND)   = QFBASE(A,FLND)*LNDSCALE;
 739   QFBASE(A,FCAP)   = QFBASE(A,FCAP)*CAPSCALE;
 740   HPOP(H)          = HPOP(H)*POPSCALE;
 741   
 742  *Check SAM balances before adjustments
 743   SAM('TOTAL',AC) = 0;
 744   SAM(AC,'TOTAL') = 0;
 745   SAM('TOTAL',AC) = SUM(ACNT, SAM(ACNT,AC));
 746   SAM(AC,'TOTAL') = SUM(ACNT, SAM(AC,ACNT));
 747   SAMBALCHK(AC)   = SAM('TOTAL',AC) - SAM(AC,'TOTAL');
 748   SAMBALCHK(AC)$(ABS(SAMBALCHK(AC)) LT 1E-6) = 0;
 749   
 750  *If account balances exceed a critical maximum value, SAMBAL.INC will balance the SAM exactly.
 751  *$INCLUDE includes\1sambal.inc
 752   
 753   
 754  *------------------------------------------------------------------
 755  *1.4.2  SAM adjustments
 756  *------------------------------------------------------------------
 757   
 758  *Minor adjustments are made in the SAM (when needed) to fit the model structure.
 759   
 760  *--- Remove small domestic supply values
 761  *    If there is a very small value for domestic sales, add the discrepancy to exports to ensure all domestic production is exported.
 762   
 763  PARAMETER
 764   CHKEXP(C)           activity with all exports to commodity
 765   EXPSHR(C)           share of domestic production that is exported
 766  ;
 767   
 768   EXPSHR(C)$SUM(A, SAM(A,C)) = (SAM(C,RW) - SUM(ACNT$MAPTX('EXPTAX',ACNT), SAM(ACNT,C)) - SUM(CTE, SAM(CTE,C))) / SUM(A, SAM(A,C));
 769   
 770  LOOP(C$(ABS(EXPSHR(C) - 1) LT 1E-4),
 771   CHKEXP(C) = EXPSHR(C);
 772   SAM(C,RW) = (SUM(A, SAM(A,C)) + SUM(ACNT$MAPTX('EXPTAX',ACNT), SAM(ACNT,C)) + SUM(CTE, SAM(CTE,C)));
 773  );
 774   
 775  *--- Eliminate payments of any account to itself
 776   
 777   SAM(ACNT,ACNT) = 0;
 778   
 779  *--- Remove or net out small trade flows (see Adjust sheet)
 780   
 781  *Remove small export flows (CXREM)
 782  *   Move export flows and taxes to change in stocks
 783   SAM(CXREM,STK) = SAM(CXREM,STK) + SAM(CXREM,RW) - SUM(ACNT$MAPTX('EXPTAX',ACNT), SAM(ACNT,CXREM));
 784  *   Eliminate export flows and taxes from SAM
 785   SAM(CXREM,RW)  = 0;
 786   SAM(ACNT,CXREM)$MAPTX('EXPTAX',ACNT) = 0;
 787   
 788  *Remove small import flows (CMREM)
 789  *   Move import flows and taxes to change in stocks
 790   SAM(CMREM,STK) = SAM(CMREM,STK) - SAM(RW,CMREM) - SUM(ACNT$MAPTX('IMPTAX',ACNT), SAM(ACNT,CMREM));
 791  *   Eliminate import flows and taxes from SAM
 792   SAM(RW,CMREM)  = 0;
 793   SAM(ACNT,CMREM)$MAPTX('IMPTAX',ACNT) = 0;
 794   
 795  *Net out exports (CXNET)
 796  *   Remove export flows and taxes from import flows
 797   SAM(RW,CXNET) = SAM(RW,CXNET) - SAM(CXNET,RW) - SUM(ACNT$MAPTX('EXPTAX',ACNT), SAM(ACNT,CXNET));
 798  *   Eliminate export flows and taxes from SAM
 799   SAM(CXNET,RW)  = 0;
 800   SAM(ACNT,CXNET)$MAPTX('EXPTAX',ACNT) = 0;
 801   
 802  *Net out imports (CMNET)
 803  *   Remove import flows and taxes from export flows
 804   SAM(CMNET,RW) = SAM(CMNET,RW) - SAM(RW,CMNET) - SUM(ACNT$MAPTX('IMPTAX',ACNT), SAM(ACNT,CMNET));
 805  *   Eliminate import flows and taxes from SAM
 806   SAM(RW,CMNET)  = 0;
 807   SAM(ACNT,CMNET)$MAPTX('IMPTAX',ACNT) = 0;
 808   
 809  *Manually re-balance SAM (move imbalances to rest of world)
 810  *   Update total value of stocks (since stocks now include the values of removed exports and imports)
 811   SAM(STK,SI)  = SUM(C, SAM(C,STK));
 812  *   Update government tax revenues (since import and export taxes may have been removed)
 813   SAM(GV,TAXES) = 0;
 814   SAM(GV,TAXES) = SUM(ACNT, SAM(TAXES,ACNT));
 815  *   Update government receipts from rest of world (since total import and export tax revenues may have changed)
 816   SAM(GV,RW) = 0;
 817   SAM(GV,RW) = SUM(ACNT, SAM(ACNT,GV) - SAM(GV,ACNT));
 818  *   Update current account balance (since trade flows and government foreign inflows may have changed)
 819   SAM(SI,RW)  = 0;
 820   SAM(SI,RW) = SUM(ACNT, SAM(RW,ACNT) - SAM(ACNT,RW));
 821   
 822  *--- Initialize tax accounts after adjustments
 823   
 824   TAXPAR('ACTTAX',A)    = SUM(ACP$MAPTX('ACTTAX',ACP), SAM(ACP,A));
 825   TAXPAR('COMTAX',C)    = SUM(ACP$MAPTX('COMTAX',ACP), SAM(ACP,C));
 826   TAXPAR('EXPTAX',C)    = SUM(ACP$MAPTX('EXPTAX',ACP), SAM(ACP,C));
 827   TAXPAR('FACTAX',F)    = SUM(ACP$MAPTX('FACTAX',ACP), SAM(ACP,F));
 828   TAXPAR('IMPTAX',C)    = SUM(ACP$MAPTX('IMPTAX',ACP), SAM(ACP,C));
 829   TAXPAR('INSTAX',INSD) = SUM(ACP$MAPTX('INSTAX',ACP), SAM(ACP,INSD));
 830   TAXPAR('VATTAX',A)    = SUM(ACP$MAPTX('VATTAX',ACP), SAM(ACP,A));
 831   
 832  *--- Compute transaction cost margins
 833   
 834  PARAMETER
 835   mDOMPRD(C)          domestic production (net of TRC)
 836   mDOMSAL(C)          domestic sales of domestically produced commodities (net of TRC)
 837   mEXPORT(C)          exports (net of TRC)
 838   mIMPORT(C)          imports (net of TRC)
 839   mMARGIN(C)          transaction cost margin (same for domestic imports and exports)
 840  ;
 841   
 842  *Domestic production (total net of TRC)
 843   mDOMPRD(C)$SUM(A, SAM(A,C)) = SUM(A, SAM(A,C));
 844   
 845  *Imports (net of TRC)
 846   mIMPORT(C)$SAM(RW,C) = SAM(RW,C) + TAXPAR('IMPTAX',C);
 847   
 848  *Transaction margin (implied to be the same for domestic imports and export)
 849   mMARGIN(C)$(mIMPORT(C) + mDOMPRD(C)) = SAM(CTC,C)/ (mIMPORT(C) + mDOMPRD(C));
 850   
 851  *Exports (net of TRC)
 852   mEXPORT(C)$(1 + mMARGIN(C)) = (SAM(C,RW) - TAXPAR('EXPTAX',C)) / (1 + mMARGIN(C));
 853   
 854  *Domestic sales of domestically produced commodities (net of TRC)
 855   mDOMSAL(C)$SUM(A, SAM(A,C)) = mDOMPRD(C) - mEXPORT(C);
 856   
 857  *Update SAM values with disaggregated commodity margin payment values
 858   SAM(CTE,C)$mEXPORT(C) = mEXPORT(C) * mMARGIN(C);
 859   SAM(CTM,C)$mIMPORT(C) = mIMPORT(C) * mMARGIN(C);
 860   SAM(CTD,C)$mDOMSAL(C) = mDOMSAL(C) * mMARGIN(C);
 861   
 862  *Update SAM values with disaggregated commodity margin receipts values
 863   SAM(C,CTE)$SUM(CP, SAM(CP,CTC)) = SAM(C,CTC)/SUM(CP, SAM(CP,CTC)) * SUM(CP, SAM(CTE,CP));
 864   SAM(C,CTM)$SUM(CP, SAM(CP,CTC)) = SAM(C,CTC)/SUM(CP, SAM(CP,CTC)) * SUM(CP, SAM(CTM,CP));
 865   SAM(C,CTD)$SUM(CP, SAM(CP,CTC)) = SAM(C,CTC)/SUM(CP, SAM(CP,CTC)) * SUM(CP, SAM(CTD,CP));
 866   
 867  *Remove aggregate transaction cost margin account
 868   SAM(CTC,AC) = 0;
 869   SAM(AC,CTC) = 0;
 870   
 871  *--- Check SAM balances after adjustments
 872   SAM('TOTAL',AC) = 0;
 873   SAM(AC,'TOTAL') = 0;
 874   SAM('TOTAL',AC) = SUM(ACNT, SAM(ACNT,AC));
 875   SAM(AC,'TOTAL') = SUM(ACNT, SAM(AC,ACNT));
 876   SAMBALCHK(AC)   = SAM('TOTAL',AC) - SAM(AC,'TOTAL');
 877   SAMBALCHK(AC)$(ABS(SAMBALCHK(AC)) LT 1E-6) = 0;
 878   
 879   
 880  *------------------------------------------------------------------
 881  *1.4.3  Factor quantities
 882  *------------------------------------------------------------------
 883   
 884  PARAMETER
 885   QF2BASE(F,A)        quantity of factor F employed by activity A (extracted data)
 886   QFSH2BASE(H,F)      household H endowmemt quantity of factor F (extracted data)
 887   WFH2BASE(H,F)       household H average earnings per unit of factor F (extracted data)
 888  ;
 889   
 890  *--- Factor employment by sector
 891   
 892  *If there is a SAM payment from A to F and neither supply nor demand quantities have been defined in
 893  *   the country data file, then SAM values are used as quantities and wages will equal 1.
 894   QF2BASE(F,A)$(SAM(F,A) AND (QFBASE(A,F) EQ 0 AND QFSBASE(F) EQ 0)) = SAM(F,A);
 895   
 896  *If country's factor employment data is quantities
 897  IF(QWBASE EQ 1,
 898  *If there are aggregate supplies of QFSBASE(F), then the supply is allocated across sectors according
 899  *   to factor payment shares. In this case, factor wages will be the same across sectors.
 900   QF2BASE(F,A)$(SAM(F,A) AND QFSBASE(F)) = QFSBASE(F)*SAM(F,A) / SUM(AP, SAM(F,AP));
 901   
 902  *If SAM(F,A) exists and sectoral factor quantities QFBASE(F,A) have been specified in the country data
 903  *   file, then they are used. The QF(F,A) values are used even if QFSBASE(F) data have also been provided.
 904   QF2BASE(F,A)$(QFBASE(A,F) AND SAM(F,A)) = QFBASE(A,F);
 905  );
 906   
 907  *If country's factor employment data is average wages or rental rates
 908  IF(QWBASE EQ 2,
 909  *If there are aggregate wages in QFSBASE(F), then SAM values are divided by the economywide wage to derive
 910  *   sector employment quantities. In this case, employment across sectors is proportional to SAM values.
 911   QF2BASE(F,A)$(SAM(F,A) AND QFSBASE(F)) = SUM(AP, SAM(F,AP)) / QFSBASE(F);
 912   
 913  *If SAM(F,A) exists and sectoral factor wages QFBASE(F,A) have been specified in the country data
 914  *   file, then the SAM value is divided by the sector-specific wage to derive employment quantities.
 915   QF2BASE(F,A)$(QFBASE(A,F) AND SAM(F,A)) = SAM(F,A) / QFBASE(A,F);
 916  );
 917   
 918  *--- Household factor endowment (used to calibrate SHIF)
 919   
 920  *If country's household factor endowment data is quantities
 921  IF(QWBASE EQ 1,
 922  *If there is a factor-to-household payment in the SAM, then use the supplied factor endowment data (even if zero).
 923   QFSH2BASE(H,F)$SAM(H,F) = QFSHBASE(H,F);
 924  );
 925   
 926  *If country's factor endowment data is average wages or rental rates
 927  IF(QWBASE EQ 2,
 928  *If there is a factor-to-household payment in the SAM, then divide this by the supplied factor earnings rate data (if available).
 929   QFSH2BASE(H,F)$(SAM(H,F) AND QFSHBASE(H,F)) = SAM(H,F)/ QFSHBASE(H,F);
 930  );
 931   
 932  *If there is a factor-to-household payment in SAM, but there is no reported household ownership of OR EARNINGS FROM that
 933  *   factor, then treat the factor-to-household payment in the SAM as the household's endowment.
 934   QFSH2BASE(H,F)$(SAM(H,F) AND QFSHBASE(H,F) EQ 0) = SAM(H,F);
 935   
 936  *Scale factor endownments across households to match the total factor supply quantity estimated above.
 937   QFSH2BASE(H,F)$SUM(HP, QFSH2BASE(HP,F)) = QFSH2BASE(H,F)/SUM(HP, QFSH2BASE(HP,F)) * SUM(A, QF2BASE(F,A));
 938   
 939   
 940  *------------------------------------------------------------------
 941  *1.4.4. SAM dependent set definitions
 942  *------------------------------------------------------------------
 943   
 944  *CD is the set for commodities with domestic sales of domestic output
 945  *   i.e., for which (value of sales at producer prices) > (value of exports at producer prices)
 946   CD(C)$(SUM(A, SAM(A,C)) GT (SAM(C,RW) - TAXPAR('EXPTAX',C) - SUM(CTE, SAM(CTE,C)))) = YES;
 947   CDN(C) = NOT CD(C);
 948   
 949  *CE is the set for commodities with exports
 950   CE(C)$SAM(C,RW) = YES;
 951   CEN(C) = NOT CE(C);
 952   
 953  *CE is the set for commodities with imports
 954   CM(C)$SAM(RW,C) = YES;
 955   CMN(C) = NOT CM(C);
 956   
 957  *CX is the set for commodities with domestic sales
 958   CX(C)$SUM(A, SAM(A,C)) = YES;
 959   
 960  *CT is the set for commodities with demand from transaction cost margins
 961   CT(C)$(SUM(CTD, SAM(C,CTD)) + SUM(CTE, SAM(C,CTE)) + SUM(CTM, SAM(C,CTM))) = YES;
 962   
 963  *Mapping between activities and commodities in the supply matrix
 964  * MAPAC(A,C)$SAM(A,C) = YES;
 965   
 966  *If activity has no intermediate inputs, then Leontief function must be used at the top of the technology nest
 967   ACES(A)$(NOT ALEO(A)) = YES;
 968   
 969  *Run diagnostic checks on country data
