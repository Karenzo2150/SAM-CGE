---- CESVAPRD  =E=  CES value-added production function for activity A

CESVAPRD(asorg)..  - (1)*QF(flab-rn,asorg) - (1)*QF(flab-rp,asorg) - (1)*QF(flab-rs,asorg) - (1)*QF(flab-rt,asorg) - (1)*QF(flab-un,asorg) - (1)*QF(flab-up,asorg) - (1)*QF(flab-us,asorg) - (1)*QF(flab-ut,asorg) - (1)*QF(flab-kn,asorg) - (1)*QF(flab-kp,asorg) - (1)*QF(flab-ks,asorg) - (1)*QF(flab-kt,asorg) - (1)*QF(flnd,asorg) - (1)*QF(fcap-c,asorg) + QVA(asorg) =E= 0 ; (LHS = 0)
     
CESVAPRD(amaiz)..  - (1)*QF(flab-rn,amaiz) - (1)*QF(flab-rp,amaiz) - (1)*QF(flab-rs,amaiz) - (1)*QF(flab-rt,amaiz) - (1)*QF(flab-un,amaiz) - (1)*QF(flab-up,amaiz) - (1)*QF(flab-us,amaiz) - (1)*QF(flab-ut,amaiz) - (1)*QF(flab-kn,amaiz) - (1)*QF(flab-kp,amaiz) - (1)*QF(flab-ks,amaiz) - (1)*QF(flab-kt,amaiz) - (1)*QF(flnd,amaiz) - (1)*QF(fcap-c,amaiz) + QVA(amaiz) =E= 0 ; (LHS = 0)
     
