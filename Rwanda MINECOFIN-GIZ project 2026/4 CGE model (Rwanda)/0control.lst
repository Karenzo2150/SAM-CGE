2500  *------------------------------------------------------------------
2501  *2.1.2  Define closure parameters
2502  *------------------------------------------------------------------
2503   
       This section first checks that the user-selected closure choices imported from Excel are valid - if not, they are set to
       default values. Valid choices are then assigned to different closure parameters containing the rules for each simulation. 
2508   
2509  PARAMETER
2510  *Closure parameters
2511   NUMERAIRE(SIM)         numeraire
2512   SICLOSE(SIM)           savings-investment closures
2513   ROWCLOSE(SIM)          current account (rest of world) closures
2514   GOVCLOSE(SIM)          government account closures
2515   FACCLOSE(F,SIM)        factor market closures
2516  *Selecting which commodities, activities and institutions adjust under closure rules
2517   MPS01SIM(INS,SIM)      0-1 parameter for potential flexing of savings rates
2518   TA01SIM(A,SIM)         0-1 parameter for potential flexing of activity tax rates
2519   TE01SIM(C,SIM)         0-1 parameter for potential flexing of export tax rates
2520   TF01SIM(F,SIM)         0-1 parameter for potential flexing of factor tax rates
2521   TI01SIM(INS,SIM)       0-1 parameter for potential flexing of direct tax rates
2522   TM01SIM(C,SIM)         0-1 parameter for potential flexing of import tariff rates
2523   TQ01SIM(C,SIM)         0-1 parameter for potential flexing of sales tax rates
2524   TV01SIM(A,SIM)         0-1 parameter for potential flexing of value-added tax rates
2525  *Fixed factors by activity
2526   AFIXCAP(A,SIM)         activities with fixed capital (even with general capital mobility)
2527   AFIXLND(A,SIM)         activities with fixed land (even with general land mobility)
2528  ;
2529   
2530  TABLE CLOSBOUNDS(MCLOSEAC,*)   Closure bounds and default values
2531                          MIN MAX DEF
2532   NUMERAIRE              1   2   1
2533   SAVINGS-INVESTMENT     1   5   3
2534   CURRENT-ACCOUNT        1   2   1
2535   GOVERNMENT-ACCOUNT     1   15  1
2536   FACTORS                1   3   1
2537  ;
2538   
2539  *For user-selected macro and factor closures outside of permissable bounds, set to default values
2540   MCLOSE(MCLOSEAC,SIM)$(MCLOSE(MCLOSEAC,SIM) LT CLOSBOUNDS(MCLOSEAC,'MIN') OR MCLOSE(MCLOSEAC,SIM) GT CLOSBOUNDS(MCLOSEAC,'MAX')) = CLOSBOUNDS(MCLOSEAC,'DEF');
2541   FCLOSE(F,SIM)$(FCLOSE(F,SIM) LT CLOSBOUNDS('FACTORS','MIN') OR FCLOSE(F,SIM) GT CLOSBOUNDS('FACTORS','MAX')) = CLOSBOUNDS('FACTORS','DEF');
2542   
2543  *Set macro-closures to default values
2544   NUMERAIRE(SIM) = CLOSBOUNDS('NUMERAIRE','DEF');
2545   SICLOSE(SIM)   = CLOSBOUNDS('SAVINGS-INVESTMENT','DEF');
2546   ROWCLOSE(SIM)  = CLOSBOUNDS('CURRENT-ACCOUNT','DEF');
2547   GOVCLOSE(SIM)  = CLOSBOUNDS('GOVERNMENT-ACCOUNT','DEF');
2548   
2549  *For non-base simulations, macro-closures are replaced with imported simulation data (if within max-min bounds)
2550   NUMERAIRE(SIMNB) = MCLOSE('NUMERAIRE',SIMNB);
2551   SICLOSE(SIMNB)   = MCLOSE('SAVINGS-INVESTMENT',SIMNB);
2552   ROWCLOSE(SIMNB)  = MCLOSE('CURRENT-ACCOUNT',SIMNB);
2553   GOVCLOSE(SIMNB)  = MCLOSE('GOVERNMENT-ACCOUNT',SIMNB);
2554   
2555  *For closures with flexible savings or tax rates, the default is that the rates of all domestic non-government institutions adjust.
2556   MPS01SIM(INS,SIM) = 1;
2557   TI01SIM(INS,SIM)  = 1;
2558   TA01SIM(A,SIM)    = 1;
2559   TV01SIM(A,SIM)    = 1;
2560   TE01SIM(C,SIM)    = 1;
2561   TM01SIM(C,SIM)    = 1;
2562   TQ01SIM(C,SIM)    = 1;
2563   TF01SIM(F,SIM)    = 1;
2564   
2565  *For non-base simulations, replace with zero if imported Excel data has value of 2 (i.e., exclude from shock or closure).
2566   MPS01SIM(INSDNG,SIMNB)$(ASIMH(INSDNG,'SAVE',SIMNB) EQ 2) = 0;
2567   TI01SIM(INSDNG,SIMNB)$(ASIMH(INSDNG,'TAX',SIMNB) EQ 2)   = 0;
2568   TA01SIM(A,SIMNB)$(ASIMA(A,'TAX',SIMNB) EQ 2)             = 0;
2569   TV01SIM(A,SIMNB)$(ASIMA(A,'TAX',SIMNB) EQ 2)             = 0;
2570   TE01SIM(C,SIMNB)$(ASIMC(C,'TAX',SIMNB) EQ 2)             = 0;
2571   TM01SIM(C,SIMNB)$(ASIMC(C,'TAX',SIMNB) EQ 2)             = 0;
2572   TQ01SIM(C,SIMNB)$(ASIMC(C,'TAX',SIMNB) EQ 2)             = 0;
2573   TF01SIM(F,SIMNB)$(ASIMF(F,'TAX',SIMNB) EQ 2)             = 0;
2574   
2575  *If savings or tax rates are excluded (fixed) for all activities, factors or instiutions, then generate an error.
2576  *  Note: should rather choose a SI or GOV closure rule that fixes all savings or tax rates - also any closure that
2577  *        assumes at least rates are flexible will no longer work.
2578   MPS01SIM(INSDNG,SIM)$(SUM(INSDNGP, MPS01SIM(INSDNGP,SIM)) EQ 0) = 1/0;
2579   TI01SIM(INSDNG,SIM)$(SUM(INSDNGP, TI01SIM(INSDNGP,SIM)) EQ 0)   = 1/0;
2580   TA01SIM(A,SIM)$(SUM(AP, TA01SIM(AP,SIM)) EQ 0)                  = 1/0;
2581   TV01SIM(A,SIM)$(SUM(AP, TV01SIM(AP,SIM)) EQ 0)                  = 1/0;
2582   TE01SIM(C,SIM)$(SUM(CP, TE01SIM(CP,SIM)) EQ 0)                  = 1/0;
2583   TM01SIM(C,SIM)$(SUM(CP, TM01SIM(CP,SIM)) EQ 0)                  = 1/0;
2584   TQ01SIM(C,SIM)$(SUM(CP, TQ01SIM(CP,SIM)) EQ 0)                  = 1/0;
2585   TF01SIM(F,SIM)$(SUM(FP, TF01SIM(FP,SIM)) EQ 0)                  = 1/0;
2586   
2587  *Sectors with fixed capital stocks
2588   AFIXCAP(A,SIM) = NO;
2589   AFIXCAP(A,SIM)$(ASIMA(A,'FIXCAP',SIM) NE 0) = YES;
2590   
2591  *Sectors with fixed land stocks
2592   AFIXLND(A,SIM) = NO;
2593   AFIXLND(A,SIM)$(ASIMA(A,'FIXLND',SIM) NE 0) = YES;
2594   
2595  *Set factor closures to default value (1 = fully employed and mobile across activities)
2596   FACCLOSE(F,SIM) = 1;
2597   
2598  *For non-base simulations, replace with imported simulation data (if withint max-min bounds)
2599   FACCLOSE(F,SIMNB) = FCLOSE(F,SIMNB);
2600   
2601   
2602  *------------------------------------------------------------------
2603  *2.1.3  Define shock parameters
2604  *------------------------------------------------------------------
2605   
       This section declares and defines a number of shock parameters that are used within the simulation loop to adjust the values
      of parameters and exogenous variables in the base model. Shock parameters start with the variable or parameter name, followed
      by "SIM". Default values for all shock parameters are base year values.
2611   
2612  PARAMETERS
2613  *Commodity shock parameters
2614   PWESIM(C,SIM)          world price for exports
2615   PWMSIM(C,SIM)          world price for imports
2616   TEADJSIM(SIM)          export tax (TE) scaling factor
2617   DTESIM(SIM)            additive export tax (TE) adjustment
2618   TESIM(C,SIM)           export tax rate (commodity-specific)
2619   TMADJSIM(SIM)          import tariff (TM) scaling factor
2620   DTMSIM(SIM)            additive import tariff (TM) adjustment
2621   TMSIM(C,SIM)           import tariff rate (commodity-specific)
2622   TQADJSIM(SIM)          composite commodity tax (TQ) scaling factor
2623   DTQSIM(SIM)            additive sales tax (TQ) adjustment
2624   TQSIM(C,SIM)           sales tax rate (commodity-specific)
2625   ICESIM(C,CP,SIM)       export transaction costs
2626   ICMSIM(C,CP,SIM)       import transaction costs
2627   ICDSIM(C,CP,SIM)       domestic transaction costs
2628  *Activity shock parameters
2629   ALPHAVASIM(A,SIM)      total factor productivity (TFP)
2630   TAADJSIM(SIM)          activity tax (TA) scaling factor
2631   DTASIM(SIM)            additive activity tax (TA) adjustment
2632   TASIM(A,SIM)           activity tax rate (activity-specific)
2633   TVADJSIM(SIM)          value-added tax (TVA) scaling factor
2634   DTVSIM(SIM)            additive value-added tax (TVA) adjustment
2635   TVSIM(A,SIM)           value added tax rate (activity-specific)
2636  *Factor shock parameters
2637   WFSIM(F,SIM)           economywide wage-rental rate
2638   QFSSIM(F,SIM)          factor supply
2639   QFSIM(F,A,SIM)         factor demand
2640   ALPHAFSIM(F,A,SIM)     factor-specific productivity
2641   TFADJSIM(SIM)          direct factor tax (TF) scaling factor
2642   DTFSIM(SIM)            additive direct factor tax (TF) adjustment
2643   TFSIM(F,SIM)           factor tax rate (factor-specific)
2644   TRNSFSIM(F,INS,SIM)    factor transfers from government and rest of world
2645   SHIFSIM(INS,F,SIM)     share of factor income transferred to government and rest of world
2646  *Institution shock parameters
2647   POPSIM(H,SIM)          household populations
2648   MPSADJSIM(SIM)         institutional savings rate scaling factor
2649   DMPSSIM(SIM)           additive institutional savings rate adjustment
2650   MPSSIM(INS,SIM)        institutional savings rate (institution-specific)
2651   TIADJSIM(SIM)          direct tax (TINS) scaling factor
2652   DTISIM(SIM)            additive domestic institution tax (TINS) adjustment
2653   TISIM(INS,SIM)         direct tax rate (institution-specific)
2654   TRNSISIM(INS,INSP,SIM) domestic institution transfers from government and rest of world
2655   SHIISIM(INS,INS,SIM)   share of domestic non-government institution income transferred to government and rest of world
2656  *Macro shock parameters
2657   EXRSIM(SIM)            exchange rate
2658   FSAVSIM(SIM)           foreign savings
2659   IADJSIM(SIM)           investment adjustment factor
2660   INVSHRSIM(SIM)         investment share of absorption
2661   GSAVSIM(SIM)           government savings
2662   GADJSIM(SIM)           government spending
2663   GOVSHRSIM(SIM)         government consumption share of absorption
2664  ;
2665   
2666   
2667  *--- Initialize shock parameters to base year values ---
2668   
2669  *Commodity shocks
2670  *  World prices (PWE, PWM)
2671   PWESIM(C,SIMC) = pwe0(C);
2672   PWMSIM(C,SIMC) = pwm0(C);
2673  *  Export tax (TE) rate
2674   TEADJSIM(SIMC) = TEADJ0;
2675   DTESIM(SIMC)   = DTE0;
2676   TESIM(C,SIMC)  = TE0(C);
2677  *  Import tariff (TM) rate
2678   TMADJSIM(SIMC) = TMADJ0;
2679   DTMSIM(SIMC)   = DTM0;
2680   TMSIM(C,SIMC)  = TM0(C);
2681  *  Composite commodity tax (TQ) rate
2682   TQADJSIM(SIMC) = TQADJ0;
2683   DTQSIM(SIMC)   = DTQ0;
2684   TQSIM(C,SIMC)  = TQ0(C);
2685  *  Transaction costs (ice, icm, icd)
2686   ICESIM(C,CP,SIMC) = ice0(C,CP);
2687   ICMSIM(C,CP,SIMC) = icm0(C,CP);
2688   ICDSIM(C,CP,SIMC) = icd0(C,CP);
2689   
2690  *Activities
2691  *  Total factor productivity (TFP)
2692   ALPHAVASIM(A,SIMC) = alphava0(A);
2693  *  Activity tax (TA) rate
2694   TAADJSIM(SIMC) = TAADJ0;
2695   DTASIM(SIMC)   = DTA0;
2696   TASIM(A,SIMC)  = TA0(A);
2697  *  Value-added tax (TVA) rate
2698   TVADJSIM(SIMC) = TVADJ0;
2699   DTVSIM(SIMC)   = DTV0;
2700   TVSIM(A,SIMC)  = TV0(A);
2701   
2702  *Factors
2703  *  Economywide wage-rental rate (WF)
2704   WFSIM(F,SIMC) = WF0(F);
2705  *  Factor supply (QFS)
2706   QFSSIM(F,SIMC)  = QFS0(F);
2707  *  Factor demand (QF)
2708   QFSIM(F,A,SIMC) = QF0(F,A);
2709  *  Factor-specific productivity (alphaf)
2710   ALPHAFSIM(F,A,SIMC) = alphaf0(F,A);
2711  *  Direct factor tax (TF) rate
2712   TFADJSIM(SIMC) = TFADJ0;
2713   DTFSIM(SIMC)   = DTF0;
2714   TFSIM(F,SIMC)  = TF0(F);
2715  *  Share of factor income transferred to government and rest of world (shif)
2716   SHIFSIM(INS,F,SIMC) = shif0(INS,F);
2717  *  Factor transfers from government and rest of world (trnsf)
2718   TRNSFSIM(F,INS,SIMC)    = trnsf0(F,INS);
2719   
2720  *Institutions
2721  *  Household populations (POP)
2722   POPSIM(H,SIMC) = pop0(H);
2723  *  Institutional savings (MPS) rate
2724   MPSADJSIM(SIMC) = MPSADJ0;
2725   DMPSSIM(SIMC)   = DMPS0;
2726   MPSSIM(H,SIMC)  = MPS0(H);
2727  *  Direct tax (TI) rate
2728   TIADJSIM(SIMC) = TIADJ0;
2729   DTISIM(SIMC)   = DTI0;
2730   TISIM(H,SIMC)  = TI0(H);
2731  *  Share of domestic non-government institution income transferred to government and rest of world (shii)
2732   SHIISIM(INS,INSDNG,SIMC) = shii0(INS,INSDNG);
2733  *  Domestic non-government institution transfers from government and rest of world (trnsi)
2734   TRNSISIM(INS,INSP,SIMC) = trnsi0(INS,INSP);
2735   
2736  *Macro/scalar
2737  *  Exchange rate (EXR)
2738   EXRSIM(SIMC) = EXR0;
2739  *  Foreign savings (FSAV)
2740   FSAVSIM(SIMC) = FSAV0;
2741  *  Investment adjustment factor (IADJ)
2742   IADJSIM(SIMC) = IADJ0;
2743  *  Government savings (GSAV)
2744   GSAVSIM(SIMC) = GSAV0;
2745  *  Government spending (GADJ)
2746   GADJSIM(SIMC) = GADJ0;
2747  *  Investment share of absorption (INVSHR)
2748   INVSHRSIM(SIMC) = INVSHR0;
2749  *  Government share of absorption (GOVSHR)
2750   GOVSHRSIM(SIMC) = GOVSHR0;
2751   
2752   
2753  *--- Update shock parameters with imported baseline and shock simulation data ---
2754   
2755  *Commodity shocks
2756   
2757  *  World price for exports
2758   PWESIM(C,SIM)$(ATYPC('PWE',SIM) EQ 1) = pwe0(C) * (1+ASIMC(C,'PWE',SIM)/100);
2759   PWESIM(C,SIM)$(ATYPC('PWE',SIM) EQ 2) = pwe0(C) + ASIMC(C,'PWE',SIM);
2760   
2761  *  World price for imports
2762   PWMSIM(C,SIM)$(ATYPC('PWM',SIM) EQ 1) = pwm0(C) * (1+ASIMC(C,'PWM',SIM)/100);
2763   PWMSIM(C,SIM)$(ATYPC('PWM',SIM) EQ 2) = pwm0(C) + ASIMC(C,'PWM',SIM);
2764   
2765  *  Export tax (TE) rate
2766   TESIM(C,SIM)$(ATYPS('TE',SIM) EQ 1)  = TE0(C) * (1+ASIMS('TE',SIM)/100);
2767   TESIM(C,SIM)$(ATYPS('TE',SIM) EQ 2)  = TE0(C) + ASIMS('TE',SIM)/100;
2768   TESIM(C,SIM)$(ATYPC('TE',SIM) EQ 1 AND TESIM(C,SIM) EQ TE0(C))  = TE0(C) * (1+ASIMC(C,'TE',SIM)/100);
2769   TESIM(C,SIM)$(ATYPC('TE',SIM) EQ 2 AND TESIM(C,SIM) EQ TE0(C))  = TE0(C) + ASIMC(C,'TE',SIM)/100;
2770   
2771  *  Import tariff (TM) rate
2772   TMSIM(C,SIM)$(ATYPS('TM',SIM) EQ 1)  = TM0(C) * (1+ASIMS('TM',SIM)/100);
2773   TMSIM(C,SIM)$(ATYPS('TM',SIM) EQ 2)  = TM0(C) + ASIMS('TM',SIM)/100;
2774   TMSIM(C,SIM)$(ATYPC('TM',SIM) EQ 1 AND TMSIM(C,SIM) EQ TM0(C))  = TM0(C) * (1+ASIMC(C,'TM',SIM)/100);
2775   TMSIM(C,SIM)$(ATYPC('TM',SIM) EQ 2 AND TMSIM(C,SIM) EQ TM0(C))  = TM0(C) + ASIMC(C,'TM',SIM)/100;
2776   
2777  *  Composite commodity tax (TQ) rate
2778   TQSIM(C,SIM)$(ATYPS('TQ',SIM) EQ 1)  = TQ0(C) * (1+ASIMS('TQ',SIM)/100);
2779   TQSIM(C,SIM)$(ATYPS('TQ',SIM) EQ 2)  = TQ0(C) + ASIMS('TQ',SIM)/100;
2780   TQSIM(C,SIM)$(ATYPC('TQ',SIM) EQ 1 AND TQSIM(C,SIM) EQ TQ0(C))  = TQ0(C) * (1+ASIMC(C,'TQ',SIM)/100);
2781   TQSIM(C,SIM)$(ATYPC('TQ',SIM) EQ 2 AND TQSIM(C,SIM) EQ TQ0(C))  = TQ0(C) + ASIMC(C,'TQ',SIM)/100;
2782   
2783  *  Export transaction costs
2784  *    Only apply shock if commodity is a supplier of transaction cost demand (e.g., transport, trade services)
2785   ICESIM(C,CP,SIM)$(SUM(CPP, ice0(C,CPP)) AND ATYPC('ICE',SIM) EQ 1) = ice0(C,CP) * (1+ASIMC(CP,'ICE',SIM)/100);
2786   ICESIM(C,CP,SIM)$(SUM(CPP, ice0(C,CPP)) AND ATYPC('ICE',SIM) EQ 2) = ice0(C,CP) + ASIMC(CP,'ICE',SIM);
2787   
2788  *  Import transaction costs
2789  *    Only apply shock if commodity is a supplier of transaction cost demand (e.g., transport, trade services)
2790   ICMSIM(C,CP,SIM)$(SUM(CPP, icm0(C,CPP)) AND ATYPC('ICM',SIM) EQ 1) = icm0(C,CP) * (1+ASIMC(CP,'ICM',SIM)/100);
2791   ICMSIM(C,CP,SIM)$(SUM(CPP, icm0(C,CPP)) AND ATYPC('ICM',SIM) EQ 2) = icm0(C,CP) + ASIMC(CP,'ICM',SIM);
2792   
2793  *  Domestic transaction costs
2794  *    Only apply shock if commodity is a supplier of transaction cost demand (e.g., transport, trade services)
2795   ICDSIM(C,CP,SIM)$(SUM(CPP, icd0(C,CPP)) AND ATYPC('ICD',SIM) EQ 1) = icd0(C,CP) * (1+ASIMC(CP,'ICD',SIM)/100);
2796   ICDSIM(C,CP,SIM)$(SUM(CPP, icd0(C,CPP)) AND ATYPC('ICD',SIM) EQ 2) = icd0(C,CP) + ASIMC(CP,'ICD',SIM);
2797   
2798  *Activity shocks
2799   
2800  *  Total factor productivity (TFP)
2801   ALPHAVASIM(A,SIM)$(ATYPA('ALPHAVA',SIM) EQ 1) = alphava0(A) * (1+ASIMA(A,'ALPHAVA',SIM)/100);
2802   ALPHAVASIM(A,SIM)$(ATYPA('ALPHAVA',SIM) EQ 2) = alphava0(A) + ASIMA(A,'ALPHAVA',SIM);
2803   
2804  *  Activity tax (TA) rate
2805   TASIM(A,SIM)$(ATYPS('TA',SIM) EQ 1)  = TA0(A) * (1+ASIMS('TA',SIM)/100);
2806   TASIM(A,SIM)$(ATYPS('TA',SIM) EQ 2)  = TA0(A) + ASIMS('TA',SIM)/100;
2807   TASIM(A,SIM)$(ATYPA('TA',SIM) EQ 1 AND TASIM(A,SIM) EQ TA0(A))  = TA0(A) * (1+ASIMA(A,'TA',SIM)/100);
2808   TASIM(A,SIM)$(ATYPA('TA',SIM) EQ 2 AND TASIM(A,SIM) EQ TA0(A))  = TA0(A) + ASIMA(A,'TA',SIM)/100;
2809   
2810  *  Value-added tax (TVA) rate
2811   TVSIM(A,SIM)$(ATYPS('TV',SIM) EQ 1)  = TV0(A) * (1+ASIMS('TV',SIM)/100);
2812   TVSIM(A,SIM)$(ATYPS('TV',SIM) EQ 2)  = TV0(A) + ASIMS('TV',SIM)/100;
2813   TVSIM(A,SIM)$(ATYPA('TV',SIM) EQ 1 AND TVSIM(A,SIM) EQ TV0(A))  = TV0(A) * (1+ASIMA(A,'TV',SIM)/100);
2814   TVSIM(A,SIM)$(ATYPA('TV',SIM) EQ 2 AND TVSIM(A,SIM) EQ TV0(A))  = TV0(A) + ASIMA(A,'TV',SIM)/100;
2815   
2816  *Factor shocks
2817   
2818  *  Economywide wage-rental rate
2819  *    Shock is ineffective when factor is fully employed and variable WF is flexible (FACCLOS = 1)
2820   WFSIM(F,SIM)$(ATYPF('WF',SIM) EQ 1) = WF0(F) * (1+ASIMF(F,'WF',SIM)/100);
2821   WFSIM(F,SIM)$(ATYPF('WF',SIM) EQ 2) = WF0(F) + ASIMF(F,'WF',SIM);
2822   
2823  *  Factor supply
2824  *    Shock is ineffective when factor is unemployed or sector-specific and variable QFS is flexible (FACCLOS = 2,3)
2825   QFSSIM(F,SIM)$(ATYPF('QFS',SIM) EQ 1) = QFS0(F) * (1+ASIMF(F,'QFS',SIM)/100);
2826   QFSSIM(F,SIM)$(ATYPF('QFS',SIM) EQ 2) = QFS0(F) + ASIMF(F,'QFS',SIM);
2827   
2828  *  Factor demand (QF)
2829  *    Shock is ineffective when factor is unemployed or mobile across activities (FACCLOS = 1,3)
2830   QFSIM(FCAP,A,SIM)$(ASIMA(A,'FIXCAP',SIM) NE 0) = QFS0(FCAP) * (1+ASIMA(A,'FIXCAP',SIM)/100);
2831   QFSIM(FLND,A,SIM)$(ASIMA(A,'FIXLND',SIM) NE 0) = QFS0(FLND) + (1+ASIMA(A,'FIXLND',SIM)/100);
2832   
2833  *  Factor-specific productivity
2834  *    Shock is both factor- and sector-specific (activities excluded from shock are selected in the activity block on the simulation Excel worksheets).
2835   ALPHAFSIM(F,A,SIM)$(ATYPF('QFS',SIM) EQ 1 AND ASIMA(A,'ALPHAF',SIM) EQ 1) = alphaf0(F,A) * (1+ASIMF(F,'ALPHAF',SIM)/100);
2836   ALPHAFSIM(F,A,SIM)$(ATYPF('QFS',SIM) EQ 2 AND ASIMA(A,'ALPHAF',SIM) EQ 1) = alphaf0(F,A) + ASIMF(F,'ALPHAF',SIM);
2837   
2838  *  Direct factor tax (TF) rate
2839   TFSIM(F,SIM)$(ATYPS('TF',SIM) EQ 1)  = TF0(F) * (1+ASIMS('TF',SIM)/100);
2840   TFSIM(F,SIM)$(ATYPS('TF',SIM) EQ 2)  = TF0(F) + ASIMS('TF',SIM)/100;
2841   TFSIM(F,SIM)$(ATYPF('TF',SIM) EQ 1 AND TFSIM(F,SIM) EQ TF0(F))  = TF0(F) * (1+ASIMF(F,'TF',SIM)/100);
2842   TFSIM(F,SIM)$(ATYPF('TF',SIM) EQ 2 AND TFSIM(F,SIM) EQ TF0(F))  = TF0(F) + ASIMF(F,'TF',SIM)/100;
2843   
2844  *  Share of factor income transferred to government and rest of world (shif)
2845  *    Shock factor income transferred to government
2846   SHIFSIM(GV,F,SIMC)$(ATYPF('TRTG',SIMC) EQ 1) = shif0(GV,F) * (1+ASIMF(F,'TRTG',SIMC)/100);
2847   SHIFSIM(GV,F,SIMC)$(ATYPF('TRTG',SIMC) EQ 2) = shif0(GV,F) + ASIMF(F,'TRTG',SIMC)/100;
2848  *    Shock factor income transferred to rest of world
2849   SHIFSIM(RW,F,SIMC)$(ATYPF('TRTW',SIMC) EQ 1) = shif0(RW,F) * (1+ASIMF(F,'TRTW',SIMC)/100);
2850   SHIFSIM(RW,F,SIMC)$(ATYPF('TRTW',SIMC) EQ 2) = shif0(RW,F) + ASIMF(F,'TRTW',SIMC)/100;
2851  *    Recalculate non-government and non-ROW shares
2852   SHIFSIM(INSDNG,F,SIMC)$SUM(INSDNGP, shif0(INSDNGP,F))
2853      = SHIF0(INSDNG,F) / SUM(INSDNGP, shif0(INSDNGP,F)) * (1 - SHIFSIM(GV,F,SIMC) - SHIFSIM(RW,F,SIMC));
2854   
2855  *  Factor transfers from government and rest of world (trnsf)
2856  *    Shock government transfers to factors
2857   TRNSFSIM(F,GV,SIMC)$(ATYPF('TRFG',SIMC) EQ 1) = trnsf0(F,GV) * (1+ASIMF(F,'TRFG',SIMC)/100);
2858   TRNSFSIM(F,GV,SIMC)$(ATYPF('TRFG',SIMC) EQ 2) = trnsf0(F,GV) + ASIMF(F,'TRFG',SIMC);
2859  *    Shock rest of world transfers to factors
2860   TRNSFSIM(F,RW,SIMC)$(ATYPF('TRFW',SIMC) EQ 1) = trnsf0(F,RW) * (1+ASIMF(F,'TRFW',SIMC)/100);
2861   TRNSFSIM(F,RW,SIMC)$(ATYPF('TRFW',SIMC) EQ 2) = trnsf0(F,RW) + ASIMF(F,'TRFW',SIMC);
2862   
2863  *Institution shocks
2864   
2865  *  Household populations (POP)
2866   POPSIM(H,SIM)$(ATYPH('POP',SIM) EQ 1) = pop0(H) * (1+ASIMH(H,'POP',SIM)/100);
2867   POPSIM(H,SIM)$(ATYPH('POP',SIM) EQ 2) = pop0(H) * ASIMH(H,'POP',SIM);
2868   
2869  *  Institutional savings (MPS) rate
2870   MPSSIM(INSDNG,SIM)$(ATYPS('MPS',SIM) EQ 1)  = MPS0(INSDNG) * (1+ASIMS('MPS',SIM)/100);
2871   MPSSIM(INSDNG,SIM)$(ATYPS('MPS',SIM) EQ 2)  = MPS0(INSDNG) + ASIMS('MPS',SIM)/100;
2872   MPSSIM(INSDNG,SIM)$(ATYPH('MPS',SIM) EQ 1 AND MPSSIM(INSDNG,SIM) EQ MPS0(INSDNG))  = MPS0(INSDNG) * (1+ASIMH(INSDNG,'MPS',SIM)/100);
2873   MPSSIM(INSDNG,SIM)$(ATYPH('MPS',SIM) EQ 2 AND MPSSIM(INSDNG,SIM) EQ MPS0(INSDNG))  = MPS0(INSDNG) + ASIMH(INSDNG,'MPS',SIM)/100;
2874   
2875  *  Direct tax (TINS) rate
2876   TISIM(INSDNG,SIM)$(ATYPS('TI',SIM) EQ 1)  = TI0(INSDNG) * (1+ASIMS('TI',SIM)/100);
2877   TISIM(INSDNG,SIM)$(ATYPS('TI',SIM) EQ 2)  = TI0(INSDNG) + ASIMS('TI',SIM)/100;
2878   TISIM(INSDNG,SIM)$(ATYPH('TI',SIM) EQ 1 AND TISIM(INSDNG,SIM) EQ TI0(INSDNG))  = TI0(INSDNG) * (1+ASIMH(INSDNG,'TI',SIM)/100);
2879   TISIM(INSDNG,SIM)$(ATYPH('TI',SIM) EQ 2 AND TISIM(INSDNG,SIM) EQ TI0(INSDNG))  = TI0(INSDNG) + ASIMH(INSDNG,'TI',SIM)/100;
2880   
2881   
2882  *  Share of domestic non-government institution income transferred to government and rest of world (shii)
2883  *    Shock domestic non-government instituional income transferred to government
2884   SHIISIM(GV,INSDNG,SIMC)$(ATYPH('TRTG',SIMC) EQ 1) = shii0(GV,INSDNG) * (1+ASIMH(INSDNG,'TRTG',SIMC)/100);
2885   SHIISIM(GV,INSDNG,SIMC)$(ATYPH('TRTG',SIMC) EQ 2) = shii0(GV,INSDNG) + ASIMH(INSDNG,'TRTG',SIMC)/100;
2886  *    Shock institution income transferred to rest of world
2887   SHIISIM(RW,INSDNG,SIMC)$(ATYPH('TRTW',SIMC) EQ 1) = shii0(RW,INSDNG) * (1+ASIMH(INSDNG,'TRTW',SIMC)/100);
2888   SHIISIM(RW,INSDNG,SIMC)$(ATYPH('TRTW',SIMC) EQ 2) = shii0(RW,INSDNG) + ASIMH(INSDNG,'TRTW',SIMC)/100;
2889  *    Recalculate non-government and non-ROW shares
2890   SHIISIM(INSDNGP,INSDNG,SIMC)$(1 - shii0(GV,INSDNG) - shii0(RW,INSDNG))
2891      = shii0(INSDNGP,INSDNG) / (1 - shii0(GV,INSDNG) - shii0(RW,INSDNG)) * (1 - SHIISIM(GV,INSDNG,SIMC) - SHIISIM(RW,INSDNG,SIMC));
2892   
2893  *  Domestic non-government institution transfers from government and rest of world (trnsi)
2894  *    Shock government transfers to domestic non-government institutions
2895   TRNSISIM(INSDNG,GV,SIMC)$(ATYPH('TRFG',SIMC) EQ 1) = trnsi0(INSDNG,GV) * (1+ASIMH(INSDNG,'TRFG',SIMC)/100);
2896   TRNSISIM(INSDNG,GV,SIMC)$(ATYPH('TRFG',SIMC) EQ 2) = trnsi0(INSDNG,GV) + ASIMH(INSDNG,'TRFG',SIMC);
2897  *    Shock rest of world transfers to domestic non-government institutions
2898   TRNSISIM(INSDNG,RW,SIMC)$(ATYPH('TRFW',SIMC) EQ 1) = trnsi0(INSDNG,RW) * (1+ASIMH(INSDNG,'TRFW',SIMC)/100);
2899   TRNSISIM(INSDNG,RW,SIMC)$(ATYPH('TRFW',SIMC) EQ 2) = trnsi0(INSDNG,RW) + ASIMH(INSDNG,'TRFW',SIMC);
2900   
2901  *Macro/scalar shocks
2902   
2903  *  Exchange rate
2904  *    Shock is ineffective when variable EXR is flexible (ROWCLOS = 1)
2905   EXRSIM(SIM)$(ATYPS('EXR',SIM) EQ 1) = EXR0 * (1+ASIMS('EXR',SIM)/100);
2906   EXRSIM(SIM)$(ATYPS('EXR',SIM) EQ 2) = EXR0 * ASIMS('EXR',SIM);
2907   
2908  *  Foreign savings
2909  *    Shock is ineffective when variable FSAV is flexible (ROWCLOS = 2)
2910   FSAVSIM(SIM)$(ATYPS('FSAV',SIM) EQ 1) = FSAV0 * (1+ASIMS('FSAV',SIM)/100);
2911   FSAVSIM(SIM)$(ATYPS('FSAV',SIM) EQ 2) = FSAV0 + ASIMS('FSAV',SIM);
2912   
2913  *  Investment adjustment factor
2914  *    Shock is ineffective when variable IADJ is flexible (SICLOS = 3,4,5)
2915   IADJSIM(SIM)$(ATYPS('IADJ',SIM) EQ 1) = IADJ0 * (1+ASIMS('IADJ',SIM)/100);
2916   IADJSIM(SIM)$(ATYPS('IADJ',SIM) EQ 2) = IADJ0 + ASIMS('IADJ',SIM)/100;
2917   
2918  *  Investment share of absorption
2919  *    Shock is ineffective when variable INVSHR is flexible (SICLOS = 1,2,3)
2920   INVSHRSIM(SIM)$(ATYPS('INVSHR',SIM) EQ 1) = INVSHR0 * (1+ASIMS('INVSHR',SIM)/100);
2921   INVSHRSIM(SIM)$(ATYPS('INVSHR',SIM) EQ 2) = INVSHR0 + ASIMS('INVSHR',SIM)/100;
2922   
2923  *  Government savings
2924  *    Shock is ineffective when variable GSAV is flexible (GOVCLOS = 1)
2925   GSAVSIM(SIM)$(ATYPS('GSAV',SIM) EQ 1) = GSAV0 * (1+ASIMS('GSAV',SIM)/100);
2926   GSAVSIM(SIM)$(ATYPS('GSAV',SIM) EQ 2) = GSAV0 + ASIMS('GSAV',SIM);
2927   
2928  *  Government spending
2929  *    Shock is ineffective when variable GADJ is flexible (SICLOS = 4,5)
2930   GADJSIM(SIM)$(ATYPS('GADJ',SIM) EQ 1) = GADJ0 * (1+ASIMS('GADJ',SIM)/100);
2931   GADJSIM(SIM)$(ATYPS('GADJ',SIM) EQ 2) = GADJ0 + ASIMS('GADJ',SIM)/100;
2932   
2933  *  Government share of absorption
2934  *    Shock is ineffective when variable GOVSHR is flexible (SICLOS = 1,2,3)
2935   GOVSHRSIM(SIM)$(ATYPS('GOVSHR',SIM) EQ 1) = GOVSHR0 * (1+ASIMS('GOVSHR',SIM)/100);
2936   GOVSHRSIM(SIM)$(ATYPS('GOVSHR',SIM) EQ 2) = GOVSHR0 + ASIMS('GOVSHR',SIM)/100;
2937   
2938  *  Government transfers to and from rest of world (trnsi)
2939  *    Shock government transfers to rest of world
2940   TRNSISIM(RW,GV,SIMC)$(ATYPS('TRTW',SIMC) EQ 1) = trnsi0(RW,GV) * (1+ASIMS('TRTW',SIMC)/100);
2941   TRNSISIM(RW,GV,SIMC)$(ATYPS('TRTW',SIMC) EQ 2) = trnsi0(RW,GV) + ASIMS('TRTW',SIMC);
2942  *    Shock rest of world transfers to government
2943   TRNSISIM(GV,RW,SIMC)$(ATYPS('TRFW',SIMC) EQ 1) = trnsi0(GV,RW) * (1+ASIMS('TRFW',SIMC)/100);
2944   TRNSISIM(GV,RW,SIMC)$(ATYPS('TRFW',SIMC) EQ 2) = trnsi0(GV,RW) + ASIMS('TRFW',SIMC);
2945   
2946   
2947   
