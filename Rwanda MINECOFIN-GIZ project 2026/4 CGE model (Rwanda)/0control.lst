4955  execute 'xlstalk.exe -m data\\rwa_2017\statrep_rwa2017.xlsx';
4956   XLTEST = ERRORLEVEL;
4957  IF(XLTEST = 1,
4958  execute 'xlstalk.exe -c data\\rwa_2017\statrep_rwa2017.xlsx';
4959  );
4960  IF(XLTEST = 2,
4961  execute 'xlstalk.exe -s data\\rwa_2017\statrep_rwa2017.xlsx';
4962  );
