1010   SIREC('DSTK') = YES;
1011   
1012  *ILLEGAL SAM PAYMENTS OR VALUES -------------------------------
1013   
1014  *Savings-investment (S-I) account is only permitted to pay to accounts for commodities (C) and stock change (DSTK)
1015   ERRSAMFLOW(ACNT,'S-I')$(SAM(ACNT,'S-I') AND (NOT SIREC(ACNT))) = 1/0;
1016  *Savings-investment (S-I) account is only permitted to receive payments from institutions (INS)
1017   ERRSAMFLOW('S-I',ACNT)$(SAM('S-I',ACNT) AND (NOT INS(ACNT))) = 1/0;
1018  *Stock change account (DSTK) is only permitted to receive payments from savings-investment (S-I) and make payments to commodities (C).
1019   ERRSAMFLOW('DSTK',ACNT)$(SAM('DSTK',ACNT) AND (NOT ACNT('S-I'))) = 1/0;
1020   ERRSAMFLOW(ACNT,'DSTK')$(SAM(ACNT,'DSTK') AND (NOT C(ACNT))) = 1/0;
1021  *It is illegal to have import tariffs for commodities without imports
1022   ERRSAMFLOW('IMPTAX',C)$(TAXPAR('IMPTAX',C) AND (NOT SAM('ROW',C))) = 1/0;
1023  *It is illegal to have export taxes for commodities without exports
1024   ERRSAMFLOW('EXPTAX',C)$(TAXPAR('EXPTAX',C) AND (NOT SAM(C,'ROW'))) = 1/0;
1025  *Value of exports is greater than the value of domestic production.
1026  *Note that exports can equal to value of domestic production, so test includes 1E-6.
1027   ERREXPOUT(C)$(SAM(C,RW) GT (SUM(A, SAM(A,C)) + TAXPAR('EXPTAX',C) + SUM(CTE, SAM(CTE,C)) + 1.E-6)) = 1/0 ;
1028   
1029  *Activities (A) are not permitted to pay to institutions (INS) or other activities (AP).
1030   ERRSAMFLOW(INS,A)$SAM(INS,A) = 1/0;
1031   ERRSAMFLOW(AP,A)$SAM(AP,A) = 1/0;
1032  *Commodities (C) are not permitted to pay to factors (F) or domestic institutions (INSD).
1033   ERRSAMFLOW(F,C)$SAM(F,C) = 1/0;
1034   ERRSAMFLOW(INSD,C)$SAM(INSD,C) = 1/0;
1035  *Factors (F) are not permitted to pay to activities (A), commodities (C) or other factors (FP).
1036   ERRSAMFLOW(A,F)$SAM(A,F) = 1/0;
1037   ERRSAMFLOW(C,F)$SAM(C,F) = 1/0;
1038   ERRSAMFLOW(FP,F)$SAM(FP,F) = 1/0;
1039  *Domestic institutions (INSD) are not permitted to pay to factors (F).
1040   ERRSAMFLOW(F,INSD)$SAM(F,INSD) = 1/0;
1041  *Government (GOV) and the rest of the world (ROW) are not permitted to pay to activities (A).
1042   ERRSAMFLOW(A,'GOV')$SAM(A,'GOV') = 1/0;
1043   ERRSAMFLOW(A,'ROW')$SAM(A,'ROW') = 1/0;
1044  *Enterprises (EN) are not permitted to pay to activities (A) or commodities (C).
1045   ERRSAMFLOW(A,EN)$SAM(A,EN) = 1/0;
1046   ERRSAMFLOW(C,EN)$SAM(C,EN) = 1/0;
1047   
1048  *SAMBALCHK ----------------------------------------------------
1049   SAMGAPCUTOFF = 1.0e-5;
1050   ERRSAMBAL(AC)$(ABS(SAMBALCHK(AC)) GT SAMGAPCUTOFF) = 1/0;
1051   
1052  *NEGCELL ------------------------------------------------------
1053   
1054   NEGCELL(AC,ACP)$(SAM(AC,ACP) LT 0) = YES;
1055   
1056  *MAXCELL, MINCELL, LARGECELL AND SMALLCELL --------------------
1057   
1058   MAXCELL = SMAX((ACNT,ACNTP), ABS(SAM(ACNT,ACNTP)));
1059   MINCELL = SMIN((ACNT,ACNTP)$SAM(ACNT,ACNTP), ABS(SAM(ACNT,ACNTP)));
1060   
1061  *No cells are large if cellcutoffup is set at +INF.
1062   cellcutoffup = 1000;
1063  *No cells are small if cellcutofflo is set at zero.
1064   cellcutofflo = 0.01;
1065   
1066   LARGECELL(AC,ACP)$(ABS(SAM(AC,ACP)) GT cellcutoffup) = YES;
1067   SMALLCELL(AC,ACP)$(SAM(AC,ACP) AND (ABS(SAM(AC,ACP)) LT cellcutofflo)) = YES;
