4931   r_GDPFCs(RA,SIM)       $(NOT r_GDPFCs(RA,SIM)      ) = eps;
4932   r_GDPFCp(RA,SIM)       $(NOT r_GDPFCp(RA,SIM)      ) = eps;
4933   r_GDPMPs(NRAC,RD,SIM)  $(NOT r_GDPMPs(NRAC,RD,SIM) ) = eps;
4934   r_GDPMPp(NRAC,RD,SIM)  $(NOT r_GDPMPp(NRAC,RD,SIM) ) = eps;
4935   r_QE(RA,SIM)           $(NOT r_QE(RA,SIM)          ) = eps;
4936   r_QM(RA,SIM)           $(NOT r_QM(RA,SIM)          ) = eps;
4937   r_PX(RA,SIM)           $(NOT r_PX(RA,SIM)          ) = eps;
4938   r_PQ(RA,SIM)           $(NOT r_PQ(RA,SIM)          ) = eps;
4939   r_PE(RA,SIM)           $(NOT r_PE(RA,SIM)          ) = eps;
4940   r_PM(RA,SIM)           $(NOT r_PM(RA,SIM)          ) = eps;
4941   r_PWE(RA,SIM)          $(NOT r_PWE(RA,SIM)         ) = eps;
4942   r_PWM(RA,SIM)          $(NOT r_PWM(RA,SIM)         ) = eps;
4943   r_QFS(RF,SIM)          $(NOT r_QFS(RF,SIM)         ) = eps;
4944   r_WF(RF,SIM)           $(NOT r_WF(RF,SIM)          ) = eps;
4945   r_YF(RF,SIM)           $(NOT r_YF(RF,SIM)          ) = eps;
4946   r_YI(RH,SIM)           $(NOT r_YI(RH,SIM)          ) = eps;
4947   r_QHH(RH,SIM)          $(NOT r_QHH(RH,SIM)         ) = eps;
4948   r_QHC(RA,SIM)          $(NOT r_QHC(RA,SIM)         ) = eps;
4949   r_TI(RH,SIM)           $(NOT r_TI(RH,SIM)          ) = eps;
4950   r_MPS(RH,SIM)          $(NOT r_MPS(RH,SIM)         ) = eps;
