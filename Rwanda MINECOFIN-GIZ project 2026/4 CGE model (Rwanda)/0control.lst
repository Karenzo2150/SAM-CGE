2437   ATYPA(SIMAC,SIM)$(ORD(SIM)-1 EQ 5)  =  TYP5A(SIMAC);
2438   ATYPA(SIMAC,SIM)$(ORD(SIM)-1 EQ 6)  =  TYP6A(SIMAC);
2439   ATYPA(SIMAC,SIM)$(ORD(SIM)-1 EQ 7)  =  TYP7A(SIMAC);
2440   ATYPA(SIMAC,SIM)$(ORD(SIM)-1 EQ 8)  =  TYP8A(SIMAC);
2441   ATYPA(SIMAC,SIM)$(ORD(SIM)-1 EQ 9)  =  TYP9A(SIMAC);
