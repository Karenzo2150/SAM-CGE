2474   ATYPH(SIMAC,SIM)$(ORD(SIM)-1 EQ 10) = TYP10H(SIMAC);
2475   ATYPH(SIMAC,SIM)$(ORD(SIM)-1 EQ 11) = TYP11H(SIMAC);
2476   ATYPH(SIMAC,SIM)$(ORD(SIM)-1 EQ 12) = TYP12H(SIMAC);
