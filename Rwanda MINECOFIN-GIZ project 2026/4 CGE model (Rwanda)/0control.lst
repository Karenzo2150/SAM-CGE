4321  *------------------------------------------------------------------
4322  *2.4.11  Budgets for SAM accounts
4323  *------------------------------------------------------------------
4324   
4325  *Activity accounts.
4326   x_SAMBUD('ACT',A,'INC',C,SIMC)                 = PXAC.L(A,C)*theta(A,C)*(QA.L(A)-SUM(H, QHA.L(A,H)));
4327   x_SAMBUD('ACT',A,'INC',H,SIMC)                 = PA.L(A)*QHA.L(A,H);
4328   x_SAMBUD('ACT',A,'SPND',F,SIMC)                = WF.L(F)*WFDIST.L(F,A)*QF.L(F,A);
4329   x_SAMBUD('ACT',A,'SPND',C,SIMC)                = PQ.L(C)*QINT.L(C,A);
4330   x_SAMBUD('ACT',A,'SPND','VATTAX',SIMC)         = TV.L(A)*PVA.L(A)*QVA.L(A);
4331   x_SAMBUD('ACT',A,'SPND','ACTTAX',SIMC)         = TA.L(A)*PA.L(A)*QA.L(A);
4332   
4333  *Commodity accounts.
4334   x_SAMBUD('COM',C,'INC',H,SIMC)                 = PQ.L(C)*QH.L(C,H);
4335   x_SAMBUD('COM',C,'INC',GV,SIMC)                = PQ.L(C)*QG.L(C);
4336   x_SAMBUD('COM',C,'INC',SI,SIMC)                = PQ.L(C)*QINV.L(C);
4337   x_SAMBUD('COM',C,'INC',STK,SIMC)               = PQ.L(C)*qdst(C);
4338   x_SAMBUD('COM',C,'INC',RW,SIMC)                = EXR.L*pwe(C) * QE.L(C);
4339   x_SAMBUD('COM',C,'INC',A,SIMC)                 = PQ.L(C)*QINT.L(C,A);
4340   x_SAMBUD('COM',C,'INC','DUM',SIMC)             = PQ.L(C)*QT.L(C);
4341   x_SAMBUD('COM',C,'SPND',A,SIMC)                = PXAC.L(A,C)*theta(A,C)*(QA.L(A)-SUM(H, QHA.L(A,H)));
4342   x_SAMBUD('COM',C,'SPND','COMTAX',SIMC)         = TQ.L(C)*PQ.L(C)*QQ.L(C);
4343   x_SAMBUD('COM',C,'SPND','IMPTAX',SIMC)         = TM.L(C)*EXR.L*pwm(C)*QM.L(C);
4344   x_SAMBUD('COM',C,'SPND',RW,SIMC)               = EXR.L*pwm(C)*QM.L(C);
4345   x_SAMBUD('COM',C,'SPND','EXPTAX',SIMC)         = TE.L(C)*EXR.L*pwe(C)*QE.L(C);
4346   x_SAMBUD('COM',C,'SPND',CTD,SIMC)              = SUM(CT, PQ.L(CT)*icd(CT,C)*QD.L(C));
4347   x_SAMBUD('COM',C,'SPND',CTM,SIMC)              = SUM(CT, PQ.L(CT)*icm(CT,C)*QM.L(C));
4348   x_SAMBUD('COM',C,'SPND',CTE,SIMC)              = SUM(CT, PQ.L(CT)*ice(CT,C)*QE.L(C));
4349   
4350  *Factor accounts.
4351   x_SAMBUD('FAC',F,'INC',A,SIMC)                 = WF.L(F) * WFDIST.L(F,A) * QF.L(F,A);
4352   x_SAMBUD('FAC',F,'INC',GV,SIMC)                = trnsf(F,GV)*CPI.L;
4353   x_SAMBUD('FAC',F,'INC',RW,SIMC)                = trnsf(F,RW)*EXR.L;
4354   x_SAMBUD('FAC',F,'SPND',INS,SIMC)              = shif(INS,F)*YF.L(F)*(1-TF.L(F));
4355   x_SAMBUD('FAC',F,'SPND','FACTAX',SIMC)         = TF.L(F)*YF.L(F);
4356   
4357  *Domestic nongovernment institution accounts.
4358   x_SAMBUD('INSDNG',INSDNG,'INC',F,SIMC)         = YIF.L(INSDNG,F);
4359   x_SAMBUD('INSDNG',INSDNG,'INC',INSDNGP,SIMC)   = TRII.L(INSDNG,INSDNGP);
4360   x_SAMBUD('INSDNG',INSDNG,'INC',GV,SIMC)        = trnsi(INSDNG,GV)*CPI.L;
4361   x_SAMBUD('INSDNG',INSDNG,'INC',RW,SIMC)        = trnsi(INSDNG,RW)*EXR.L;
4362   x_SAMBUD('INSDNG',H,'SPND',A,SIMC)             = PA.L(A)*QHA.L(A,H);
4363   x_SAMBUD('INSDNG',H,'SPND',C,SIMC)             = PQ.L(C)*QH.L(C,H);
4364   x_SAMBUD('INSDNG',INSDNG,'SPND',INS,SIMC)      = TRII.L(INS,INSDNG);
4365   x_SAMBUD('INSDNG',INSDNG,'SPND',SI,SIMC)       = MPS.L(INSDNG)*(1-TI.L(INSDNG))*YI.L(INSDNG);
4366   x_SAMBUD('INSDNG',INSDNG,'SPND','INSTAX',SIMC) = TI.L(INSDNG) * YI.L(INSDNG);
4367   
4368  *Government account.
4369   x_SAMBUD('GOV','DUM','INC','INSTAX',SIMC)      = SUM(INSDNG, TI.L(INSDNG)*YI.L(INSDNG));
4370   x_SAMBUD('GOV','DUM','INC','FACTAX',SIMC)      = SUM(F, TF.L(F)*YF.L(F));
4371   x_SAMBUD('GOV','DUM','INC','VATTAX',SIMC)      = SUM(A, TV.L(A)*PVA.L(A)*QVA.L(A));
4372   x_SAMBUD('GOV','DUM','INC','ACTTAX',SIMC)      = SUM(A, TA.L(A)*PA.L(A)*QA.L(A));
4373   x_SAMBUD('GOV','DUM','INC','IMPTAX',SIMC)      = SUM(C, TM.L(C)*pwm(C)*QM.L(C))*EXR.L;
4374   x_SAMBUD('GOV','DUM','INC','EXPTAX',SIMC)      = SUM(C, TE.L(C)*pwe(C)*QE.L(C))*EXR.L;
4375   x_SAMBUD('GOV','DUM','INC','COMTAX',SIMC)      = SUM(C, TQ.L(C)*PQ.L(C)*QQ.L(C));
4376   x_SAMBUD('GOV','DUM','INC',INS,SIMC)           = TRII.L(GV,INS);
4377   x_SAMBUD('GOV','DUM','INC',F,SIMC)             = YIF.L(GV,F);
4378   x_SAMBUD('GOV','DUM','INC',RW,SIMC)            = trnsi(GV,RW) * EXR.L;
4379   x_SAMBUD('GOV','DUM','SPND',C,SIMC)            = PQ.L(C)*QG.L(C);
4380   x_SAMBUD('GOV','DUM','SPND',INSD,SIMC)         = trnsi(INSD,GV)*CPI.L;
4381   x_SAMBUD('GOV','DUM','SPND',SI,SIMC)           = GSAV.L;
4382   x_SAMBUD('GOV','DUM','SPND',RW,SIMC)           = trnsi(RW,GV)*EXR.L;
4383   
4384  *Savings-investment account.
4385   x_SAMBUD('SAVINV','DUM','INC',INSDNG,SIMC)     = MPS.L(INSDNG)*(1-TI.L(INSDNG))*YI.L(INSDNG);
4386   x_SAMBUD('SAVINV','DUM','INC',GV,SIMC)         = GSAV.L;
4387   x_SAMBUD('SAVINV','DUM','INC',RW,SIMC)         = EXR.L*FSAV.L;
4388   x_SAMBUD('SAVINV','DUM','SPND',C,SIMC)         = PQ.L(C)*QINV.L(C);
4389   x_SAMBUD('SAVINV','DUM','SPND',STK,SIMC)       = SUM(C, PQ.L(C)*qdst(C));
4390   
4391  *Tax accounts.
4392  *  Incomes
4393   x_SAMBUD('INSTAX','DUM','INC',INSDNG,SIMC)     = TI.L(INSDNG) * YI.L(INSDNG);
4394   x_SAMBUD('FACTAX','DUM','INC',F,SIMC)          = TF.L(F) * YF.L(F);
4395   x_SAMBUD('VATTAX','DUM','INC',A,SIMC)          = TV.L(A) * PVA.L(A) * QVA.L(A);
4396   x_SAMBUD('ACTTAX','DUM','INC',A,SIMC)          = TA.L(A) * PA.L(A) * QA.L(A);
4397   x_SAMBUD('COMTAX','DUM','INC',C,SIMC)          = TQ.L(C) * QQ.L(C);
4398   x_SAMBUD('IMPTAX','DUM','INC',C,SIMC)          = TM.L(C) * pwm(C) * QM.L(C) * EXR.L;
4399   x_SAMBUD('EXPTAX','DUM','INC',C,SIMC)          = TE.L(C) * pwe(C) * QE.L(C) * EXR.L;
4400   x_SAMBUD('INSTAX','DUM','SPND',GV,SIMC)        = SUM(INSDNG, TI.L(INSDNG) * YI.L(INSDNG));
4401   x_SAMBUD('FACTAX','DUM','SPND',GV,SIMC)        = SUM(F, TF.L(F) * YF.L(F));
4402   x_SAMBUD('VATTAX','DUM','SPND',GV,SIMC)        = SUM(A, TV.L(A) * PVA.L(A) * QVA.L(A));
4403   x_SAMBUD('ACTTAX','DUM','SPND',GV,SIMC)        = SUM(A, TA.L(A) * PA.L(A) * QA.L(A));
4404   x_SAMBUD('COMTAX','DUM','SPND',GV,SIMC)        = SUM(C, TQ.L(C) * QQ.L(C));
4405   x_SAMBUD('IMPTAX','DUM','SPND',GV,SIMC)        = SUM(C, TM.L(C) * pwm(C) * QM.L(C)) * EXR.L;
4406   x_SAMBUD('EXPTAX','DUM','SPND',GV,SIMC)        = SUM(C, TE.L(C) * pwe(C) * QE.L(C)) * EXR.L;
4407   
4408  *Rest of world account.
4409   x_SAMBUD('ROW','DUM','INC',C,SIMC)             = pwm(C)*QM.L(C)*EXR.L;
4410   x_SAMBUD('ROW','DUM','INC',F,SIMC)             = YIF.L(RW,F)*EXR.L;
4411   x_SAMBUD('ROW','DUM','INC',INS,SIMC)           = TRII.L(RW,INS)*EXR.L;
4412   x_SAMBUD('ROW','DUM','INC',GV,SIMC)            = trnsi(RW,GV)*EXR.L;
4413   
4414   x_SAMBUD('ROW','DUM','SPND',C,SIMC)            = pwe(C)*QE.L(C)*EXR.L;
4415   x_SAMBUD('ROW','DUM','SPND',F,SIMC)            = trnsf(F,RW)*EXR.L;
4416   x_SAMBUD('ROW','DUM','SPND',INS,SIMC)          = trnsi(INS,RW)*EXR.L;
4417   x_SAMBUD('ROW','DUM','SPND','S-I',SIMC)        = FSAV.L*EXR.L;
4418   
4419  *Totals
4420   x_SAMBUD(SAC,AC,'INC','TOTAL',SIMC)            = SUM(ACNT, x_SAMBUD(SAC,AC,'INC',ACNT,SIMC));
4421   x_SAMBUD(SAC,AC,'SPND','TOTAL',SIMC)           = SUM(ACNT, x_SAMBUD(SAC,AC,'SPND',ACNT,SIMC));
4422   
4423  *Gap in totals
4424   x_SAMBUDGAP(SAC,ACNT,SIMC)                     = ABS(x_SAMBUD(SAC,ACNT,'INC','TOTAL',SIMC) - x_SAMBUD(SAC,ACNT,'SPND','TOTAL',SIMC));
4425   x_SAMBUDGAP(SAC,'TOTAL',SIMC)                  = SUM(ACNT, x_SAMBUDGAP(SAC,ACNT,SIMC));
4426   
4427  *------------------------------------------------------------------
4428  *2.4.12  National accounts data
4429  *------------------------------------------------------------------
4430   
4431  *--- GDP by expenditure ---
4432   
4433  *Private consumption.
4434   x_GDPTAB1('NOMINAL','PRVCON',SIMC)   =  SUM((C,H), PQ.L(C)*QH.L(C,H)) + SUM((A,H), PA.L(A)*QHA.L(A,H));
4435   x_GDPTAB1('REAL','PRVCON',SIMC)      =  SUM((C,H), PQ0(C)*QH.L(C,H))  + SUM((A,H), PA0(A)*QHA.L(A,H));
4436   
4437  *Fixed capital formation.
4438   x_GDPTAB1('NOMINAL','FIXINV',SIMC)   = SUM(C, PQ.L(C)*QINV.L(C));
4439   x_GDPTAB1('REAL','FIXINV',SIMC)      = SUM(C, PQ0(C)*QINV.L(C));
4440   
4441  *Change in stocks.
4442   x_GDPTAB1('NOMINAL','DSTOCK',SIMC)   = SUM(C, PQ.L(C)*qdst(C));
4443   x_GDPTAB1('REAL','DSTOCK',SIMC)      = SUM(C, PQ0(C)*qdst(C));
4444   
4445  *Government consumption.
4446   x_GDPTAB1('NOMINAL','GOVCON',SIMC)   = SUM(C, PQ.L(C)*QG.L(C));
4447   x_GDPTAB1('REAL','GOVCON',SIMC)      = SUM(C, PQ0(C)*QG.L(C));
4448   
4449  *Exports.
4450   x_GDPTAB1('NOMINAL','EXPORTS',SIMC)  = SUM(CE, pwe(CE)*QE.L(CE)*EXR.L);
4451   x_GDPTAB1('REAL','EXPORTS',SIMC)     = SUM(CE, pwe0(CE)*QE.L(CE)*EXR0);
4452   
4453  *Imports.
4454   x_GDPTAB1('NOMINAL','IMPORTS',SIMC)  = -SUM(CM, pwm(CM)*QM.L(CM)*EXR.L);
4455   x_GDPTAB1('REAL','IMPORTS',SIMC)     = -SUM(CM, pwm0(CM)*QM.L(CM)*EXR0);
4456   
4457  *Gross domestic product at market prices.
4458   x_GDPTAB1('NOMINAL','GDPMP',SIMC)    = SUM(IGDP2, x_GDPTAB1('NOMINAL',IGDP2,SIMC));
4459   x_GDPTAB1('REAL','GDPMP',SIMC)       = SUM(IGDP2, x_GDPTAB1('REAL',IGDP2,SIMC));
4460   
4461  *Total absorption.
4462   x_GDPTAB1('NOMINAL','ABSORP',SIMC)   = x_GDPTAB1('NOMINAL','GDPMP',SIMC) - x_GDPTAB1('NOMINAL','IMPORTS',SIMC) - x_GDPTAB1('NOMINAL','EXPORTS',SIMC);
4463   x_GDPTAB1('REAL','ABSORP',SIMC)      = x_GDPTAB1('REAL','GDPMP',SIMC) - x_GDPTAB1('REAL','IMPORTS',SIMC) - x_GDPTAB1('REAL','EXPORTS',SIMC);
4464   
4465  *Gross domestic product at factor cost.
4466   x_GDPTAB1('NOMINAL','GDPFC2',SIMC)   = SUM(A, PVA.L(A)*(1-TV.L(A))*QVA.L(A));
4467   x_GDPTAB1('REAL','GDPFC2',SIMC)      = SUM(A, PVA0(A)*(1-TV0(A))*QVA.L(A));
4468   
4469  *Net indirect taxes.
4470   x_GDPTAB1('NOMINAL','NETITAX',SIMC) =
4471              SUM(A, TA.L(A)*PA.L(A)*QA.L(A))
4472            + SUM(A, TV.L(A)*PVA.L(A)*QVA.L(A))
4473            + SUM(C, TM.L(C)*pwm(C)*QM.L(C)*EXR.L)
4474            + SUM(C, TE.L(C)*pwe(C)*QE.L(C)*EXR.L)
4475            + SUM(C, TQ.L(C)*PQ.L(C)*QQ.L(C));
4476   x_GDPTAB1('REAL','NETITAX',SIMC) =
4477              SUM(A, TA0(A)*PA0(A)*QA.L(A))
4478            + SUM(A, TV0(A)*PVA0(A)*QVA.L(A))
4479            + SUM(C, TM0(C)*PWM0(C)*QM.L(C)*EXR0)
4480            + SUM(C, TE0(C)*PWE0(C)*QE.L(C)*EXR0)
4481            + SUM(C, TQ0(C)*PQ0(C)*QQ.L(C));
4482   
4483  *Alternative measure of gross domestic product at market prices.
4484   x_GDPTAB1('NOMINAL','GDPMP2',SIMC) = x_GDPTAB1('NOMINAL','GDPFC2',SIMC) + x_GDPTAB1('NOMINAL','NETITAX',SIMC);
4485   
4486  *Shares of total GDP at market prices.
4487   x_GDPTAB1('NOMSHARE',IGDP,SIMC)$x_GDPTAB1('NOMINAL','GDPMP',SIMC) = x_GDPTAB1('NOMINAL',IGDP,SIMC)/x_GDPTAB1('NOMINAL','GDPMP',SIMC)*100;
4488   x_GDPTAB1('REALSHARE',IGDP,SIMC)$x_GDPTAB1('REAL','GDPMP',SIMC)   = x_GDPTAB1('REAL',IGDP,SIMC)/x_GDPTAB1('REAL','GDPMP',SIMC)*100;
4489   
4490  *GDP deflator.
4491   x_GDPTAB1('DEFLATOR',IGDP,SIMC)$x_GDPTAB1('REAL',IGDP,SIMC) = x_GDPTAB1('NOMINAL',IGDP,SIMC)/x_GDPTAB1('REAL',IGDP,SIMC)*100;
4492   
4493  *Gap in GDP at market prices measured two ways
4494   x_GDPGAP(SIMC) = ABS(x_GDPTAB1('NOMINAL','GDPMP',SIMC) - x_GDPTAB1('NOMINAL','GDPMP2',SIMC));
4495   
4496  *--- GDP by sector ---
4497   
4498  *Activity GDP at factor cost.
4499   x_GDPTAB2('NOMINAL',A,SIMC)         = PVA.L(A)*(1-TV.L(A))*QVA.L(A);
4500   x_GDPTAB2('REAL',A,SIMC)            = PVA0(A)*(1-TV0(A))*QVA.L(A);
4501   
4502  *Total GDP at factor cost.
4503   x_GDPTAB2('NOMINAL','TOTAL',SIMC)   = SUM(A, x_GDPTAB2('NOMINAL',A,SIMC));
4504   x_GDPTAB2('REAL','TOTAL',SIMC)      = SUM(A, x_GDPTAB2('REAL',A,SIMC));
4505   
4506  *Shares of total GDP at factor cost.
4507   x_GDPTAB2('NOMSHARE',A,SIMC)        = x_GDPTAB2('NOMINAL',A,SIMC)/x_GDPTAB2('NOMINAL','TOTAL',SIMC)*100;
4508   x_GDPTAB2('REALSHARE',A,SIMC)       = x_GDPTAB2('REAL',A,SIMC)/x_GDPTAB2('REAL','TOTAL',SIMC)*100;
4509   
4510  *Total shares.
4511   x_GDPTAB2('NOMSHARE','TOTAL',SIMC)  = SUM(A, x_GDPTAB2('NOMSHARE',A,SIMC));
4512   x_GDPTAB2('REALSHARE','TOTAL',SIMC) = SUM(A, x_GDPTAB2('REALSHARE',A,SIMC));
4513   
4514  *Activity GDP deflator.
4515   x_GDPTAB2('DEFLATOR',A,SIMC)$x_GDPTAB2('REAL',A,SIMC)              = x_GDPTAB2('NOMINAL',A,SIMC)/x_GDPTAB2('REAL',A,SIMC)*100;
4516   x_GDPTAB2('DEFLATOR','TOTAL',SIMC)$x_GDPTAB2('REAL','TOTAL',SIMC)  = x_GDPTAB2('NOMINAL','TOTAL',SIMC)/x_GDPTAB2('REAL','TOTAL',SIMC)*100;
4517   
4518   
4519  *------------------------------------------------------------------
4520  *2.4.13  Closure information
4521  *------------------------------------------------------------------
4522   
4523  *Macro closures
4524   x_MACCLOSURES('S-I',SIMC) = SICLOSE(SIMC);
4525   x_MACCLOSURES('GOV',SIMC) = GOVCLOSE(SIMC);
4526   x_MACCLOSURES('ROW',SIMC) = ROWCLOSE(SIMC);
4527   
4528  *Factor closures
4529   x_FACCLOSURES(F,SIMC)     = FACCLOSE(F,SIMC);
4530   
4531   
4532  *------------------------------------------------------------------
4533  *2.4.14  Solver reports
4534  *------------------------------------------------------------------
4535   
4536   x_SOLVEREP('MODEL-STATUS','MCP',SIMC)  = STANDCGE.MODELSTAT;
4537   x_SOLVEREP('SOLVER-STATUS','MCP',SIMC) = STANDCGE.SOLVESTAT;
4538   x_SOLVEREP('NUM-REDEFEQ','MCP',SIMC)   = STANDCGE.NUMREDEF;
4539   
4540  *Values are reset to zero to avoid using results from earlier solve in the definition of SOLVEREP FOR later solves.
4541   STANDCGE.MODELSTAT = 0;
4542   STANDCGE.SOLVESTAT = 0;
4543   STANDCGE.NUMREDEF  = 0;
4544   
4545  );
4546   
4547   
4548  *------------------------------------------------------------------
4549  *2.5 Generate standard reporting outputs
4550  *------------------------------------------------------------------
4551   
INCLUDE    C:\Users\EARAGIE\IFPRI Dropbox\Emerta Aragie\Rwanda MINECOFIN-GIZ project 2026\4 CGE model (Rwanda)\includes\static\stat_report.inc
4554   
      PART 2.5: Generate standard reporting outputs
       This include file (includes\2static_report.inc) generates standard reporting parameters that
       are exported to the user-named Excel (reps_%data%.inc). Note: All parameters exported to
       the standard Excel file start with "r_". 
       
      SECTIONS:
       2.5.1   Sets and parameters for standard reporting 
       2.5.2   Base year information                      (r_STRUCBASE | r_TAXBASE)                                              
       2.5.3   Macroeconomic results                      (r_MACROTAB)                                                           
       2.5.4   Gross domestic product                     (r_GDPX | r_GDPXS | r_GDPXP | r_GDPMPX | r_GDPMPXS | r_GDPMPXP)        
       2.5.5   International trade                        (r_QEXP | r_QMXP)                                                      
       2.5.6   Prices                                     (r_PXXP | r_PQXP | r_PEXP | r_PMXP | r_PWEXP | r_PWMXP)                
       2.5.7   Factors                                    (r_QFSXP | r_WFXP | r_YFXP)                                            
       2.5.8   Households                                 (r_YIXP | r_QHHXP | r_QHCXP | r_TINSXP | r_MPSXP)                      
       2.5.9   Export results to Excel                                                                               
       2.5.10  EV and CV welfare measures                 (EV | CV) 
       2.5.11  Other reporting: Percentage deviations from base year
4574   
4575   
4576  *------------------------------------------------------------------
4577  *2.5.1  Sets and parameters for standard reporting
4578  *------------------------------------------------------------------
4579   
4580  SET
4581   RA                     all activity reporting accounts
4582   RAA(RA)                aggregate activity reporting accounts
4583   RF                     all factor reporting accounts
4584   RFA(RF)                aggregate factor reporting accounts
4585   RH                     all household reporting accounts
4586   RHA(RH)                aggregate household reporting accounts
4587   RD                     GDP demand-side accounts   / r_GDPFC, r_NETITAX, r_GDPMP, r_ABSORP, r_PRVCON, r_GOVCON, r_GCF, r_GFCF, r_STK, r_TRDBAL, r_EXP, r_IMP /
4588   NRAC                   nomrinal or real values    / NOMINAL, REAL /
4589   TAXAC                  tax table accounts         / tIMPshr, tIMPtax, tIMPrev, tEXPshr, tEXPtax, tEXPrev, tSALshr, tSALtax, tSALrev, tACTshr, tACTtax, tACTrev, tVADshr, tVADtax, tVADrev /
4590   SIND                   macro summary indicators   /
4591    QABSTOT                   real absorption (LCU at base prices)
4592    QHTOT                     real household consumption (LCU at base prices)
4593    QGTOT                     real government consumption (LCU at base prices)
4594    QINVTOT                   real investment (LCU at base prices)
4595    QETOT                     total real exports (LCU at base prices)
4596    QMTOT                     total real imports (LCU at base prices)
4597    REXR                      PPP real exchange rate (LCUs per FCU)
4598    NEXR                      nominal exchange rate (LCUs per FCU)
4599    PWEIND                    exports price index (FCU - 100 for base)
4600    PWMIND                    imports price index (FCU - 100 for base)
4601    PWIND                     world (tradables) price index (FCU - 100 for base)
4602    PDIND                     domestic (non-tradables) price index (100 for base)
4603    CPI                       consumer price index (100 for base)
4604    TOFT                      terms of trade (ratio pwe index and pwm index) (100 for base)
4605    INVGDP                    investment (share of nominal GDP)
4606    TSAVGDP                   total savings (share of nominal GDP)
4607    PRVSAVGDP                 private (household + enterprise) savings (share of nominal GDP)
4608    GOVSAVGDP                 government savings (share of nominal GDP)
4609    FORSAVGDP                 foreign savings (share of nominal GDP)
4610    TRDDEFGDP                 trade deficit (share of nominal GDP)
4611    TOTTXGDP                  total tax revenue (share of nominal GDP)
4612    INDTXGDP                  indirect tax revenue (share of nominal GDP)
4613    ACTTXGDP                  activity tax revenue (share of nominal GDP)
4614    VADTXGDP                  value-added tax revenue (share of nominal GDP)
4615    COMTXGDP                  sales tax revenue (share of nominal GDP)
4616    EXPTXGDP                  export tax revenue (share of nominal GDP)
4617    IMPTXGDP                  import tariff revenue (share of nominal GDP)
4618    DIRTXGDP                  direct tax revenue (share of nominal GDP)
4619    FACTXGDP                  factor tax revenue (share of nominal GDP)
4620    INSTXGDP                  institution tax revenue (share of nominal GDP)
4621   /
4622   SINDDEV(SIND)          summary indicators showing deviation from BASE / INVGDP, TSAVGDP, PRVSAVGDP, FORSAVGDP, TRDDEFGDP, GOVSAVGDP, TOTTXGDP, INDTXGDP, ACTTXGDP, VADTXGDP, COMTXGDP, EXPTXGDP, IMPTXGDP, DIRTXGDP, FACTXGDP, INSTXGDP /
4623   SINDP(SIND)            summary indicators showing percent change
4624  ;
4625   
4626  ALIAS (RA,RAP), (RF,RFP), (RH,RHP);
4627   
4628  PARAMETERS
4629  *Mappings activities, factors, and households to reporting accounts
4630   MAPRA(RA,A)            model activities to reporting activities
4631   MAPRC(RA,C)            model commodities to reporting activities
4632   MAPRF(RF,F)            model factors to reporting factors
4633   MAPRH(RH,H)            model households to reporting households
4634  *Price index weights
4635   pdwt(C)                weight of commodity C in PD index
4636   pwewt(C)               weight of commodity C in pwe index
4637   pwmwt(C)               weight of commodity C in pwm index
4638   pwwt(*)                weight of aggregate exports-imports in pw (tradables) index
4639  *Reporting parameters (exported to Excel)
4640   r_STRUCBASE(RA,STRCOL) base year economic structure
4641   r_TAXBASE(RA,TAXAC)    base year activity and commodity taxes
4642   r_MACROTAB(SIND,SIM)   macroeconomic results
4643   r_GDPFCs(RA,SIM)       GDP at factor cost (share of total)
4644   r_GDPFCp(RA,SIM)       GDP at factor cost (percentage deviation)
4645   r_GDPMPs(NRAC,RD,SIM)  GDP at market prices (share of total)
4646   r_GDPMPp(NRAC,RD,SIM)  GDP at market prices (percentage deviation)
4647   r_QE(RA,SIM)           exports (percentage deviation)
4648   r_QM(RA,SIM)           imports (percentage deviation)
4649   r_PX(RA,SIM)           output supply prices (percentage deviation)
4650   r_PQ(RA,SIM)           final composite demand prices (percentage deviation)
4651   r_PE(RA,SIM)           export prices (percentage deviation)
4652   r_PM(RA,SIM)           import prices (percentage deviation)
4653   r_PWE(RA,SIM)          world export prices (percentage deviation)
4654   r_PWM(RA,SIM)          world import prices (percentage deviation)
4655   r_QFS(RF,SIM)          total factor supply (percentage deviation)
4656   r_WF(RF,SIM)           economywide factor wage or rent (percentage deviation)
4657   r_YF(RF,SIM)           total factor income (percentage deviation)
4658   r_YI(RH,SIM)           total household income (percentage deviation)
4659   r_QHH(RH,SIM)          total consumption by household (percentage deviation)
4660   r_QHC(RA,SIM)          total consumption by commodity (percentage deviation)
4661   r_TI(RH,SIM)           household direct tax rates
4662   r_MPS(RH,SIM)          household savings rates
4663  *Processed values (used to generate reporting parameters)
4664   x_GDPFC(RA,SIM)        GDP at factor cost (value)
4665   x_GDPMP(NRAC,RD,SIM)   GDP at market prices (value)
4666  ;
4667   
4668  *Read input data from excel file
GDXIN   C:\Users\EARAGIE\IFPRI Dropbox\Emerta Aragie\Rwanda MINECOFIN-GIZ project 2026\4 CGE model (Rwanda)\reps.gdx
4671  *Read sets and data
--- LOAD  RA = 1:ra
--- LOAD  RF = 3:rf
--- LOAD  RH = 5:rh
--- LOAD  RAA = 2:raa
--- LOAD  RFA = 4:rfa
--- LOAD  RHA = 6:rha
--- LOAD  MAPRA = 7:mapra
--- LOAD  MAPRF = 8:maprf
--- LOAD  MAPRH = 9:maprh
4676   
4677   MAPRC(RA,C)$SUM(A, MAPAC(A,C) AND MAPRA(RA,A)) = YES;
4678   SINDP(SIND)$(NOT SINDDEV(SIND)) = YES;
4679   
4680   
4681  *------------------------------------------------------------------
4682  *2.5.2  Base year information
4683  *------------------------------------------------------------------
4684   
4685  *Economic structure
4686   r_STRUCBASE(RA,'VAshr')  = SUM(A$MAPRA(RA,A), PVA0(A)*(1-TV0(A))*QVA0(A)) / SUM(A, PVA0(A)*(1-TV0(A))*QVA0(A)) * 100;
4687   r_STRUCBASE(RA,'PRDshr') = SUM(A$MAPRA(RA,A), PA0(A)*QA0(A)) / SUM(A, PA0(A)*QA0(A)) * 100;
4688   r_STRUCBASE(RA,'EMPshr') = SUM((FLAB,A)$MAPRA(RA,A), QF0(FLAB,A)) / SUM((FLAB,A), QF0(FLAB,A)) * 100;
4689   r_STRUCBASE(RA,'QQshr')  = SUM(C$MAPRC(RA,C), PQ0(C)*QQ0(C)) / SUM(C, PQ0(C)*QQ0(C)) * 100;
4690   r_STRUCBASE(RA,'HHDshr') = (SUM((C,H)$MAPRC(RA,C), PQ0(C)*QH0(C,H)) + SUM((A,H)$MAPRA(RA,A), PA0(A)*QHA0(A,H))) / (SUM((C,H), PQ0(C)*QH0(C,H)) + SUM((A,H), PA0(A)*QHA0(A,H))) * 100;
4691   r_STRUCBASE(RA,'OWNshr')$SUM((A,H), PA0(A)*QHA0(A,H)) = SUM((A,H)$MAPRA(RA,A), PA0(A)*QHA0(A,H)) / SUM((A,H), PA0(A)*QHA0(A,H)) * 100;
4692   r_STRUCBASE(RA,'MKTshr') = SUM((C,H)$MAPRC(RA,C), PQ0(C)*QH0(C,H)) / SUM((C,H), PQ0(C)*QH0(C,H)) * 100;
4693   r_STRUCBASE(RA,'GOVshr') = SUM(C$MAPRC(RA,C), PQ0(C)*QG0(C)) / SUM(C, PQ0(C)*QG0(C)) * 100;
4694   r_STRUCBASE(RA,'INVshr') = SUM(C$MAPRC(RA,C), PQ0(C)*QINV0(C)) / SUM(C, PQ0(C)*QINV0(C)) * 100;
4695   r_STRUCBASE(RA,'EXPshr') = SUM(C$MAPRC(RA,C), pwe0(C)*EXR0*QE0(C)) / SUM(C, pwe0(C)*EXR0*QE0(C)) * 100;
4696   r_STRUCBASE(RA,'IMPshr') = SUM(C$MAPRC(RA,C), pwm0(C)*EXR0*QM0(C)) / SUM(C, pwm0(C)*EXR0*QM0(C)) * 100;
4697   r_STRUCBASE(RA,'EXP-OUTshr')$SUM(C$MAPRC(RA,C), PX0(C)*QX0(C)) = SUM(C$MAPRC(RA,C), PE0(C)*EXR0*QE0(C)) / SUM(C$MAPRC(RA,C), PX0(C)*QX0(C)) * 100;
4698   r_STRUCBASE(RA,'IMP-DEMshr')$SUM(C$MAPRC(RA,C), PQ0(C)*(1-TQ0(C))*QQ0(C)) = SUM(C$MAPRC(RA,C), PM0(C)*EXR0*QM0(C)) / SUM(C$MAPRC(RA,C), PQ0(C)*(1-TQ0(C))*QQ0(C)) * 100;
4699   r_STRUCBASE(RA,'OWN-OUTshr')$SUM(A$MAPRA(RA,A), PA0(A)*QA0(A)) = SUM((A,H)$MAPRA(RA,A), PA0(A)*QHA0(A,H)) / SUM(A$MAPRA(RA,A), PA0(A)*QA0(A)) * 100;
4700   r_STRUCBASE(RA,'TRMrate')$SUM(C$MAPRC(RA,C), QM0(C)) = SUM((C,CT)$MAPRC(RA,C), PQ0(CT)*icm0(CT,C)*QM0(C)) / SUM(C$MAPRC(RA,C), PM0(C)*QM0(C)) * 100;
4701   r_STRUCBASE(RA,'TRErate')$SUM(C$MAPRC(RA,C), QE0(C)) = SUM((C,CT)$MAPRC(RA,C), PQ0(CT)*ice0(CT,C)*QE0(C)) / SUM(C$MAPRC(RA,C), PE0(C)*QE0(C) + SUM(CT, PQ0(CT)*ice0(CT,C)*QE0(C))) * 100;
4702   r_STRUCBASE(RA,'TRDrate')$SUM(C$MAPRC(RA,C), QD0(C)) = SUM((C,CT)$MAPRC(RA,C), PQ0(CT)*icd0(CT,C)*QD0(C)) / SUM(C$MAPRC(RA,C), PDD0(C)*QD0(C)) * 100;
4703   
4704  *Activity and commodity taxes
4705  *  Tax base shares
4706   r_TAXBASE(RA,'tIMPshr')$SUM(C, pwm0(C)*QM0(C))  = SUM(C$MAPRC(RA,C), pwm0(C)*QM0(C)) / SUM(C, pwm0(C)*QM0(C)) * 100;
4707   r_TAXBASE(RA,'tEXPshr')$SUM(C, pwe0(C)*QE0(C))  = SUM(C$MAPRC(RA,C), pwe0(C)*QE0(C)) / SUM(C, pwe0(C)*QE0(C)) * 100;
4708   r_TAXBASE(RA,'tSALshr')$SUM(C, PQ0(C)*QQ0(C))   = SUM(C$MAPRC(RA,C), PQ0(C)*QQ0(C)) / SUM(C, PQ0(C)*QQ0(C)) * 100;
4709   r_TAXBASE(RA,'tACTshr')$SUM(A, PA0(A)*QA0(A))   = SUM(A$MAPRA(RA,A), PA0(A)*QA0(A)) / SUM(A, PA0(A)*QA0(A)) * 100;
4710   r_TAXBASE(RA,'tVADshr')$SUM(A, PVA0(A)*QVA0(A)) = SUM(A$MAPRA(RA,A), PVA0(A)*QVA0(A)) / SUM(A, PVA0(A)*QVA0(A)) * 100;
4711  *  Tax rates
4712   r_TAXBASE(RA,'tIMPtax')$SUM(C$MAPRC(RA,C), QM0(C))  = SUM(C$MAPRC(RA,C), TM0(C)*pwm0(C)*QM0(C)*EXR0 / SUM(CP$(MAPRC(RA,C) AND MAPRC(RA,CP)), pwm0(CP)*QM0(CP)*EXR0)) * 100;
4713   r_TAXBASE(RA,'tEXPtax')$SUM(C$MAPRC(RA,C), QE0(C))  = SUM(C$MAPRC(RA,C), TE0(C)*pwe0(C)*QE0(C)*EXR0 / SUM(CP$(MAPRC(RA,C) AND MAPRC(RA,CP)), pwe0(CP)*QE0(CP)*EXR0)) * 100;
4714   r_TAXBASE(RA,'tSALtax')$SUM(C$MAPRC(RA,C), QQ0(C))  = SUM(C$MAPRC(RA,C), TQ0(C)*PQ0(C)*QQ0(C) / SUM(CP$(MAPRC(RA,C) AND MAPRC(RA,CP)), PQ0(CP)*QQ0(CP))) * 100;
4715   r_TAXBASE(RA,'tACTtax')$SUM(A$MAPRA(RA,A), QA0(A))  = SUM(A$MAPRA(RA,A), TA0(A)*PA0(A)*QA0(A) / SUM(AP$(MAPRA(RA,A) AND MAPRA(RA,AP)), PA0(AP)*QA0(AP))) * 100;
4716   r_TAXBASE(RA,'tVADtax')$SUM(A$MAPRA(RA,A), QVA0(A)) = SUM(A$MAPRA(RA,A), TV0(A)*PVA0(A)*QVA0(A) / SUM(AP$(MAPRA(RA,A) AND MAPRA(RA,AP)), PVA0(AP)*QVA0(AP))) * 100;
4717  *  Tax revenues
4718   r_TAXBASE(RA,'tIMPrev')$SUM(C, TM0(C)*pwm0(C)*QM0(C)*EXR0) = SUM(C$MAPRC(RA,C), TM0(C)*pwm0(C)*QM0(C)*EXR0) / SUM(C, TM0(C)*pwm0(C)*QM0(C)*EXR0) * 100;
4719   r_TAXBASE(RA,'tEXPrev')$SUM(C, TE0(C)*pwe0(C)*QE0(C)*EXR0) = SUM(C$MAPRC(RA,C), TE0(C)*pwe0(C)*QE0(C)*EXR0) / SUM(C, TE0(C)*pwe0(C)*QE0(C)*EXR0) * 100;
4720   r_TAXBASE(RA,'tSALrev')$SUM(C, TQ0(C)*PQ0(C)*QQ0(C))       = SUM(C$MAPRC(RA,C), TQ0(C)*PQ0(C)*QQ0(C)) / SUM(C, TQ0(C)*PQ0(C)*QQ0(C)) * 100;
4721   r_TAXBASE(RA,'tACTrev')$SUM(A, TA0(A)*PA0(A)*QA0(A))       = SUM(A$MAPRA(RA,A), TA0(A)*PA0(A)*QA0(A)) / SUM(A, TA0(A)*PA0(A)*QA0(A)) * 100;
4722   r_TAXBASE(RA,'tVADrev')$SUM(A, TV0(A)*PVA0(A)*QVA0(A))     = SUM(A$MAPRA(RA,A), TV0(A)*PVA0(A)*QVA0(A)) / SUM(A, TV0(A)*PVA0(A)*QVA0(A)) * 100;
4723   
4724   
4725  *------------------------------------------------------------------
4726  *2.5.3  Macroeconomic results
4727  *------------------------------------------------------------------
4728   
4729  *Price index weights
4730   pdwt(C)     = PDS0(C)*QD0(C) / SUM(CP, PDS0(CP)*QD0(CP));
4731   pwewt(C)    = pwe0(C)*QE0(C) / SUM(CP, pwe0(CP)*QE0(CP));
4732   pwmwt(C)    = pwm0(C)*QM0(C) / SUM(CP, pwm0(CP)*QM0(CP));
4733   pwwt('EXP') = SUM(CP, pwe0(CP)*QE0(CP)) / (SUM(CP, pwe0(CP)*QE0(CP)) + SUM(CP, pwm0(CP)*QM0(CP)));
4734   pwwt('IMP') = SUM(CP, pwm0(CP)*QM0(CP)) / (SUM(CP, pwe0(CP)*QE0(CP)) + SUM(CP, pwm0(CP)*QM0(CP)));
4735   
4736  *Real quantities
4737   r_MACROTAB('QINVTOT',SIMC) = SUM(C, PQ0(C)*x_QINV(C,SIMC) + PQ0(C)*x_qdst(C,SIMC));
4738   r_MACROTAB('QGTOT',SIMC)   = SUM(C, PQ0(C)*x_QG(C,SIMC));
4739   r_MACROTAB('QHTOT',SIMC)   = SUM((C,H), PQ0(C)*x_QH(C,H,SIMC)) + SUM((A,H), PA0(A)*x_QHA(A,H,SIMC)) ;
4740   r_MACROTAB('QETOT',SIMC)   = SUM(C, pwe0(C)*x_QE(C,SIMC)*EXR0);
4741   r_MACROTAB('QMTOT',SIMC)   = SUM(C, pwm0(C)*x_QM(C,SIMC)*EXR0);
4742   r_MACROTAB('QABSTOT',SIMC) = r_MACROTAB('QINVTOT',SIMC) + r_MACROTAB('QGTOT',SIMC)  + r_MACROTAB('QHTOT',SIMC);
4743   
4744  *Exchange rates and price indices
4745   r_MACROTAB('CPI',SIMC)     = x_CPI(SIMC)/CPI0 * 100;
4746   r_MACROTAB('NEXR',SIMC)    = x_EXR(SIMC) * 100;
4747   r_MACROTAB('PDIND',SIMC)   = SUM(C, pdwt(C)*x_PDS(C,SIMC)) * 100;
4748   r_MACROTAB('PWEIND',SIMC)  = SUM(C, x_pwe(C,SIMC)*pwewt(C)) / SUM(C, pwe0(C)*pwewt(C)) * 100;
4749   r_MACROTAB('PWMIND',SIMC)  = SUM(C, x_pwm(C,SIMC)*pwmwt(C)) / SUM(C, pwm0(C)*pwmwt(C)) * 100;
4750   r_MACROTAB('TOFT',SIMC)    = r_MACROTAB('PWEIND',SIMC) / r_MACROTAB('PWMIND',SIMC) * 100;
4751   r_MACROTAB('PWIND',SIMC)   = pwwt('EXP')*r_MACROTAB('PWEIND',SIMC) + pwwt('IMP')*r_MACROTAB('PWMIND',SIMC);
4752   r_MACROTAB('REXR',SIMC)    = r_MACROTAB('NEXR',SIMC)*r_MACROTAB('PWIND',SIMC)/r_MACROTAB('PDIND',SIMC);
4753   
4754  *Nominal GDP shares
4755   r_MACROTAB('INVGDP',SIMC)    = (SUM(C, x_PQ(C,SIMC)*x_QINV(C,SIMC)) + SUM(C, x_PQ(C,SIMC)*x_qdst(C,SIMC))) / x_GDPTAB1('NOMINAL','GDPMP',SIMC) * 100;
4756   r_MACROTAB('PRVSAVGDP',SIMC) = SUM(INSDNG, x_SAMBUD('INSDNG',INSDNG,'SPND','S-I',SIMC)) / x_GDPTAB1('NOMINAL','GDPMP',SIMC) * 100;
4757   r_MACROTAB('FORSAVGDP',SIMC) = x_EXR(SIMC)*x_FSAV(SIMC) / x_GDPTAB1('NOMINAL','GDPMP',SIMC) * 100;
4758   r_MACROTAB('TRDDEFGDP',SIMC) = (SUM(C, x_PM(C,SIMC)*x_QM(C,SIMC)) - SUM(C, x_PE(C,SIMC)*x_QE(C,SIMC))) / x_GDPTAB1('NOMINAL','GDPMP',SIMC) * 100;
4759   r_MACROTAB('GOVSAVGDP',SIMC) = x_SAMBUD('GOV','DUM','SPND','S-I',SIMC) / x_GDPTAB1('NOMINAL','GDPMP',SIMC) * 100;
4760   r_MACROTAB('TSAVGDP',SIMC)   = r_MACROTAB('PRVSAVGDP',SIMC) + r_MACROTAB('FORSAVGDP',SIMC) + r_MACROTAB('GOVSAVGDP',SIMC);
4761   r_MACROTAB('ACTTXGDP',SIMC)  = x_SAMBUD('GOV','DUM','INC','ACTTAX',SIMC) / x_GDPTAB1('NOMINAL','GDPMP',SIMC) * 100;
4762   r_MACROTAB('VADTXGDP',SIMC)  = x_SAMBUD('GOV','DUM','INC','VATTAX',SIMC) / x_GDPTAB1('NOMINAL','GDPMP',SIMC) * 100;
4763   r_MACROTAB('COMTXGDP',SIMC)  = x_SAMBUD('GOV','DUM','INC','COMTAX',SIMC) / x_GDPTAB1('NOMINAL','GDPMP',SIMC) * 100;
4764   r_MACROTAB('EXPTXGDP',SIMC)  = x_SAMBUD('GOV','DUM','INC','EXPTAX',SIMC) / x_GDPTAB1('NOMINAL','GDPMP',SIMC) * 100;
4765   r_MACROTAB('IMPTXGDP',SIMC)  = x_SAMBUD('GOV','DUM','INC','IMPTAX',SIMC) / x_GDPTAB1('NOMINAL','GDPMP',SIMC) * 100;
4766   r_MACROTAB('FACTXGDP',SIMC)  = x_SAMBUD('GOV','DUM','INC','FACTAX',SIMC) / x_GDPTAB1('NOMINAL','GDPMP',SIMC) * 100;
4767   r_MACROTAB('INSTXGDP',SIMC)  = x_SAMBUD('GOV','DUM','INC','INSTAX',SIMC) / x_GDPTAB1('NOMINAL','GDPMP',SIMC) * 100;
4768   r_MACROTAB('INDTXGDP',SIMC)  = r_MACROTAB('ACTTXGDP',SIMC) + r_MACROTAB('VADTXGDP',SIMC) + r_MACROTAB('COMTXGDP',SIMC) + r_MACROTAB('EXPTXGDP',SIMC) + r_MACROTAB('IMPTXGDP',SIMC);
4769   r_MACROTAB('DIRTXGDP',SIMC)  = r_MACROTAB('FACTXGDP',SIMC) + r_MACROTAB('INSTXGDP',SIMC);
4770   r_MACROTAB('TOTTXGDP',SIMC)  = r_MACROTAB('INDTXGDP',SIMC) + r_MACROTAB('DIRTXGDP',SIMC);
4771   
4772  *Percentage deviation
4773   r_MACROTAB(SINDP,SIMNB)$SIMC(SIMNB) = (r_MACROTAB(SINDP,SIMNB)/r_MACROTAB(SINDP,'BASE') - 1) * 100;
4774   
4775  *Percentage-point deviation
4776   r_MACROTAB(SINDDEV,SIMNB)$SIMC(SIMNB) = r_MACROTAB(SINDDEV,SIMNB) - r_MACROTAB(SINDDEV,'BASE');
4777   
4778   
4779  *------------------------------------------------------------------
4780  *2.5.4  Gross domestic product
4781  *------------------------------------------------------------------
4782   
4783  *--- GDP at factor cost ---
4784   
4785  *Real values
4786   x_GDPFC(RA,SIMC)  = SUM(A$MAPRA(RA,A), PVA0(A)*(1-TV0(A))*x_QVA(A,SIMC));
4787   
4788  *Real shares
4789   r_GDPFCs(RA,SIMC)  = x_GDPFC(RA,SIMC) / SUM(A, PVA0(A)*(1-TV0(A))*x_QVA(A,SIMC)) * 100;
4790   r_GDPFCs(RA,SIMNB) = r_GDPFCs(RA,SIMNB) - r_GDPFCs(RA,'BASE');
4791   
4792  *Percentage deviation
4793   r_GDPFCp(RA,SIMC)$x_GDPFC(RA,'BASE') = (X_GDPFC(RA,SIMC)/X_GDPFC(RA,'BASE')-1) * 100;
4794   r_GDPFCp(RA,'BASE') = r_GDPFCs(RA,'BASE');
4795   
4796  *--- GDP at market prices ---
4797   
4798  *Nominal values
4799   x_GDPMP('NOMINAL','r_PRVCON',SIMC)  = SUM((C,H), x_PQ(C,SIMC)*x_QH(C,H,SIMC)) + SUM((A,H), x_PA(A,SIMC)*x_QHA(A,H,SIMC));
4800   x_GDPMP('NOMINAL','r_GOVCON',SIMC)  = SUM(C, x_PQ(C,SIMC)*x_QG(C,SIMC));
4801   x_GDPMP('NOMINAL','r_GFCF',SIMC)    = SUM(C, x_PQ(C,SIMC)*x_QINV(C,SIMC));
4802   x_GDPMP('NOMINAL','r_STK',SIMC)     = SUM(C, x_PQ(C,SIMC)*x_qdst(C,SIMC));
4803   x_GDPMP('NOMINAL','r_GCF',SIMC)     = x_GDPMP('NOMINAL','r_GFCF',SIMC) + x_GDPMP('NOMINAL','r_STK',SIMC);
4804   x_GDPMP('NOMINAL','r_EXP',SIMC)     = SUM(C, x_pwe(C,SIMC)*x_QE(C,SIMC)*x_EXR(SIMC));
4805   x_GDPMP('NOMINAL','r_IMP',SIMC)     = SUM(C, x_pwm(C,SIMC)*x_QM(C,SIMC)*x_EXR(SIMC));
4806   x_GDPMP('NOMINAL','r_TRDBAL',SIMC)  = x_GDPMP('NOMINAL','r_EXP',SIMC) - x_GDPMP('NOMINAL','r_IMP',SIMC);
4807   x_GDPMP('NOMINAL','r_ABSORP',SIMC)  = x_GDPMP('NOMINAL','r_PRVCON',SIMC) + x_GDPMP('NOMINAL','r_GOVCON',SIMC) + x_GDPMP('NOMINAL','r_GCF',SIMC);
4808   x_GDPMP('NOMINAL','r_GDPMP',SIMC)   = x_GDPMP('NOMINAL','r_ABSORP',SIMC) + x_GDPMP('NOMINAL','r_TRDBAL',SIMC);
4809   x_GDPMP('NOMINAL','r_GDPFC',SIMC)   = SUM(A, x_PVA(A,SIMC)*(1-x_TV(A,SIMC))*x_QVA(A,SIMC));
4810   x_GDPMP('NOMINAL','r_NETITAX',SIMC) = x_GDPMP('NOMINAL','r_GDPMP',SIMC) - x_GDPMP('NOMINAL','r_GDPFC',SIMC);
4811   
4812  *Real values
4813   x_GDPMP('REAL','r_PRVCON',SIMC)     = SUM((C,H), PQ0(C)*x_QH(C,H,SIMC)) + SUM((A,H), PA0(A)*x_QHA(A,H,SIMC));
4814   x_GDPMP('REAL','r_GOVCON',SIMC)     = SUM(C, PQ0(C)*x_QG(C,SIMC));
4815   x_GDPMP('REAL','r_GFCF',SIMC)       = SUM(C, PQ0(C)*x_QINV(C,SIMC));
4816   x_GDPMP('REAL','r_STK',SIMC)        = SUM(C, PQ0(C)*x_qdst(C,SIMC));
4817   x_GDPMP('REAL','r_GCF',SIMC)        = x_GDPMP('REAL','r_GFCF',SIMC) + x_GDPMP('REAL','r_STK',SIMC);
4818   x_GDPMP('REAL','r_EXP',SIMC)        = SUM(C, pwe0(C)*x_QE(C,SIMC)*EXR0);
4819   x_GDPMP('REAL','r_IMP',SIMC)        = SUM(C, pwm0(C)*x_QM(C,SIMC)*EXR0);
4820   x_GDPMP('REAL','r_TRDBAL',SIMC)     = x_GDPMP('REAL','r_EXP',SIMC) - x_GDPMP('REAL','r_IMP',SIMC);
4821   x_GDPMP('REAL','r_ABSORP',SIMC)     = x_GDPMP('REAL','r_PRVCON',SIMC) + x_GDPMP('REAL','r_GOVCON',SIMC) + x_GDPMP('REAL','r_GCF',SIMC);
4822   x_GDPMP('REAL','r_GDPMP',SIMC)      = x_GDPMP('REAL','r_ABSORP',SIMC) + x_GDPMP('REAL','r_TRDBAL',SIMC);
4823   x_GDPMP('REAL','r_GDPFC',SIMC)      = SUM(A, PVA0(A)*(1-TV0(A))*x_QVA(A,SIMC));
4824   x_GDPMP('REAL','r_NETITAX',SIMC)    = x_GDPMP('REAL','r_GDPMP',SIMC) - x_GDPMP('REAL','r_GDPFC',SIMC);
4825   
4826  *Shares
4827   r_GDPMPs(NRAC,RD,SIMC)$x_GDPMP(NRAC,'r_GDPMP',SIMC) = x_GDPMP(NRAC,RD,SIMC)/x_GDPMP(NRAC,'r_GDPMP',SIMC) * 100;
4828   r_GDPMPs(NRAC,RD,SIMC)$SIMNB(SIMC)                  = r_GDPMPs(NRAC,RD,SIMC) - r_GDPMPs(NRAC,RD,'BASE');
4829   
4830  *Percentage deviation
4831   r_GDPMPp(NRAC,RD,SIMC)$x_GDPMP(NRAC,RD,'BASE') = (x_GDPMP(NRAC,RD,SIMC)/x_GDPMP(NRAC,RD,'BASE')-1) * 100;
4832   r_GDPMPp(NRAC,RD,'BASE')                       = r_GDPMPs(NRAC,RD,'BASE');
4833   
4834   
4835  *------------------------------------------------------------------
4836  *2.5.5  International trade
4837  *------------------------------------------------------------------
4838   
4839  *Exports (percentage deviation)
4840   r_QE(RA,SIMC)$SUM(C$MAPRC(RA,C), QE0(C)) = (SUM(C$MAPRC(RA,C), pwe0(C)*x_QE(C,SIMC)*EXR0)/SUM(C$MAPRC(RA,C), pwe0(C)*QE0(C)*EXR0)-1) * 100;
4841   r_QE(RA,'BASE')$SUM(C, QE0(C))           =  SUM(C$MAPRC(RA,C), pwe0(C)*QE0(C)*EXR0)/SUM(C, pwe0(C)*QE0(C)*EXR0) * 100;
4842   
4843  *Imports (percentage deviation)
4844   r_QM(RA,SIMC)$SUM(C$MAPRC(RA,C), QM0(C)) = (SUM(C$MAPRC(RA,C), pwm0(C)*x_QM(C,SIMC)*EXR0)/SUM(C$MAPRC(RA,C), pwm0(C)*QM0(C)*EXR0)-1) * 100;
4845   r_QM(RA,'BASE')$SUM(C, QM0(C))           =  SUM(C$MAPRC(RA,C), pwm0(C)*QM0(C)*EXR0)/SUM(C, pwm0(C)*QM0(C)*EXR0) * 100;
4846   
4847   
4848  *------------------------------------------------------------------
4849  *2.5.6  Prices
4850  *------------------------------------------------------------------
4851   
4852  *Weighted values
4853   r_PX(RA,SIMC)$SUM(C$MAPRC(RA,C), QX0(C))  = SUM(C$MAPRC(RA,C), x_PX(C,SIMC)  * PX0(C)*QX0(C)  / SUM(CP$(MAPRC(RA,C) AND MAPRC(RA,CP)), PX0(CP)*QX0(CP)));
4854   r_PQ(RA,SIMC)$SUM(C$MAPRC(RA,C), QQ0(C))  = SUM(C$MAPRC(RA,C), x_PQ(C,SIMC)  * PQ0(C)*QQ0(C)  / SUM(CP$(MAPRC(RA,C) AND MAPRC(RA,CP)), PQ0(CP)*QQ0(CP)));
4855   r_PE(RA,SIMC)$SUM(C$MAPRC(RA,C), QE0(C))  = SUM(C$MAPRC(RA,C), x_PE(C,SIMC)  * PE0(C)*QE0(C)  / SUM(CP$(MAPRC(RA,C) AND MAPRC(RA,CP)), PE0(CP)*QE0(CP)));
4856   r_PM(RA,SIMC)$SUM(C$MAPRC(RA,C), QM0(C))  = SUM(C$MAPRC(RA,C), x_PM(C,SIMC)  * PM0(C)*QM0(C)  / SUM(CP$(MAPRC(RA,C) AND MAPRC(RA,CP)), PM0(CP)*QM0(CP)));
4857   r_PWE(RA,SIMC)$SUM(C$MAPRC(RA,C), QE0(C)) = SUM(C$MAPRC(RA,C), x_pwe(C,SIMC) * pwe0(C)*QE0(C) / SUM(CP$(MAPRC(RA,C) AND MAPRC(RA,CP)), pwe0(CP)*QE0(CP)));
4858   r_PWM(RA,SIMC)$SUM(C$MAPRC(RA,C), QM0(C)) = SUM(C$MAPRC(RA,C), x_pwm(C,SIMC) * pwm0(C)*QM0(C) / SUM(CP$(MAPRC(RA,C) AND MAPRC(RA,CP)), pwm0(CP)*QM0(CP)));
4859   
4860  *Percentage deviation
4861   r_PX(RA,SIMC)$(SIMNB(SIMC) AND r_PX(RA,'BASE'))   = (r_PX(RA,SIMC)/r_PX(RA,'BASE')-1) * 100;
4862   r_PQ(RA,SIMC)$(SIMNB(SIMC) AND r_PQ(RA,'BASE'))   = (r_PQ(RA,SIMC)/r_PQ(RA,'BASE')-1) * 100;
4863   r_PE(RA,SIMC)$(SIMNB(SIMC) AND r_PE(RA,'BASE'))   = (r_PE(RA,SIMC)/r_PE(RA,'BASE')-1) * 100;
4864   r_PM(RA,SIMC)$(SIMNB(SIMC) AND r_PM(RA,'BASE'))   = (r_PM(RA,SIMC)/r_PM(RA,'BASE')-1) * 100;
4865   r_PWE(RA,SIMC)$(SIMNB(SIMC) AND r_PWE(RA,'BASE')) = (r_PWE(RA,SIMC)/r_PWE(RA,'BASE')-1) * 100;
4866   r_PWM(RA,SIMC)$(SIMNB(SIMC) AND r_PWM(RA,'BASE')) = (r_PWM(RA,SIMC)/r_PWM(RA,'BASE')-1) * 100;
4867   
4868  *Weights
4869   r_PX(RA,'BASE')$SUM(CP, PX0(CP)*QX0(CP))   = SUM(C$MAPRC(RA,C), PX0(C)*QX0(C) / SUM(CP, PX0(CP)*QX0(CP))) * 100;
4870   r_PQ(RA,'BASE')$SUM(CP, PQ0(CP)*QQ0(CP))   = SUM(C$MAPRC(RA,C), PQ0(C)*QQ0(C) / SUM(CP, PQ0(CP)*QQ0(CP))) * 100;
4871   r_PE(RA,'BASE')$SUM(CP, PE0(CP)*QE0(CP))   = SUM(C$MAPRC(RA,C), PE0(C)*QE0(C) / SUM(CP, PE0(CP)*QE0(CP))) * 100;
4872   r_PM(RA,'BASE')$SUM(CP, PM0(CP)*QM0(CP))   = SUM(C$MAPRC(RA,C), PM0(C)*QM0(C) / SUM(CP, PM0(CP)*QM0(CP))) * 100;
4873   r_PWE(RA,'BASE')$SUM(CP, pwe0(CP)*QE0(CP)) = SUM(C$MAPRC(RA,C), pwe0(C)*QE0(C) / SUM(CP, pwe0(CP)*QE0(CP))) * 100;
4874   r_PWM(RA,'BASE')$SUM(CP, pwm0(CP)*QM0(CP)) = SUM(C$MAPRC(RA,C), pwm0(C)*QM0(C) / SUM(CP, pwm0(CP)*QM0(CP))) * 100;
4875   
4876   
4877  *------------------------------------------------------------------
4878  *2.5.7  Factors
4879  *------------------------------------------------------------------
4880   
4881  *Total factor supply (percentage deviation)
4882   r_QFS(RF,SIMC)$SUM(F$MAPRF(RF,F), x_QFS(F,SIMC)) = (SUM(F$MAPRF(RF,F), x_QFS(F,SIMC))/SUM(F$MAPRF(RF,F), x_QFS(F,'BASE'))-1) * 100;
4883   r_QFS(RF,'BASE')                                 = SUM(F$MAPRF(RF,F), QFS0(F));
4884   
4885  *Economywide factor wage or rent (percentage deviation)
4886   r_WF(RF,SIMC)$SUM((F,A)$MAPRF(RF,F), x_QF(F,A,SIMC)) = SUM((F,A)$MAPRF(RF,F), x_WF(F,SIMC)*x_WFDIST(F,A,SIMC)*x_QF(F,A,SIMC)) / SUM((F,A)$MAPRF(RF,F), x_QF(F,A,SIMC));
4887   r_WF(RF,SIMC)$r_WF(RF,'BASE')                        = (r_WF(RF,SIMC)/r_WF(RF,'BASE')-1) * 100;
4888   r_WF(RF,'BASE')$SUM((F,A)$MAPRF(RF,F), QF0(F,A))     = SUM((F,A)$MAPRF(RF,F), WF0(F)*WFDIST0(F,A)*QF0(F,A)) / SUM((F,A)$MAPRF(RF,F), QF0(F,A));
4889   
4890  *Total factor income (percentage deviation)
4891   r_YF(RF,SIMC)$SUM(F$MAPRF(RF,F), x_QFS(F,SIMC)) = SUM(F$MAPRF(RF,F), x_YF(F,SIMC)) / SUM(F$MAPRF(RF,F), x_QFS(F,SIMC));
4892   r_YF(RF,SIMC)$r_YF(RF,'BASE')                   = (r_YF(RF,SIMC)/r_YF(RF,'BASE')-1) * 100;
4893   r_YF(RF,'BASE')$SUM(F$MAPRF(RF,F), QFS0(F))     = SUM(F$MAPRF(RF,F), YF0(F));
4894   
4895   
4896  *------------------------------------------------------------------
4897  *2.5.8  Households
4898  *------------------------------------------------------------------
4899   
4900  *Total household income (percentage deviation)
4901   r_YI(RH,SIMC)$SUM(H$MAPRH(RH,H), x_YI(H,'BASE')) = (SUM(H$MAPRH(RH,H), x_YI(H,SIMC)) / SUM(H$MAPRH(RH,H), YI0(H))-1) * 100;
4902   r_YI(RH,'BASE')$SUM(H, YI0(H))                   =  SUM(H$MAPRH(RH,H), YI0(H)) / SUM(H, YI0(H)) * 100;
4903   
4904  *Total consumption by household (percentage deviation)
4905   r_QHH(RH,SIMC)$SUM((C,H)$MAPRH(RH,H), PQ0(C)*QH0(C,H)) = (SUM((C,H)$MAPRH(RH,H), PQ0(C)*x_QH(C,H,SIMC)) / SUM((C,H)$MAPRH(RH,H), PQ0(C)*QH0(C,H))-1) * 100;
4906   r_QHH(RH,'BASE')$SUM((C,H), PQ0(C)*QH0(C,H))           =  SUM((C,H)$MAPRH(RH,H), PQ0(C)*QH0(C,H)) / SUM((C,H), PQ0(C)*QH0(C,H)) * 100;
4907   
4908  *Total consumption by commodity (percentage deviation)
4909   r_QHC(RA,SIMC)$SUM((C,H)$MAPRC(RA,C), PQ0(C)*QH0(C,H)) = (SUM((C,H)$MAPRC(RA,C), PQ0(C)*x_QH(C,H,SIMC)) / SUM((C,H)$MAPRC(RA,C), PQ0(C)*QH0(C,H))-1) * 100;
4910   r_QHC(RA,'BASE')$SUM((C,H), PQ0(C)*QH0(C,H))           =  SUM((C,H)$MAPRC(RA,C), PQ0(C)*QH0(C,H)) / SUM((C,H), PQ0(C)*QH0(C,H)) * 100;
4911   
4912  *Household direct tax rates
4913   r_TI(RH,SIMC)$SUM(H$MAPRH(RH,H), YI0(H)) = SUM(H$MAPRH(RH,H), x_TI(H,SIMC)*YI0(H)) / SUM(H$MAPRH(RH,H), YI0(H)) * 100;
4914   r_TI(RH,SIMC)                            = r_TI(RH,SIMC) - r_TI(RH,'BASE');
4915   r_TI(RH,'BASE')$SUM(H, YI0(H))           = SUM(H$MAPRH(RH,H), TI0(H)*YI0(H)) / SUM(H, YI0(H)) * 100;
4916   
4917  *Household savings rates
4918   r_MPS(RH,SIMC)$SUM(H$MAPRH(RH,H), YI0(H))  = SUM(H$MAPRH(RH,H), x_MPS(H,SIMC)*YI0(H)) / SUM(H$MAPRH(RH,H), YI0(H)) * 100;
4919   r_MPS(RH,SIMC)                             = r_MPS(RH,SIMC) - r_MPS(RH,'BASE');
4920   r_MPS(RH,'BASE')$SUM(H, YI0(H))            = SUM(H$MAPRH(RH,H), MPS0(H)*YI0(H)) / SUM(H, YI0(H)) * 100;
4921   
4922   
