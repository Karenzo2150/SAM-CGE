4064   
4065  *------------------------------------------------------------------
4066  *2.4.7  Selecting closure commodities, activities and institutions
4067  *------------------------------------------------------------------
4068   
4069  *  Institutions with potentially flexible savings and direct tax rates.
4070   mps01(INSDNG)  = MPS01SIM(INSDNG,SIMC);
4071   ti01(INSDNG)   = TI01SIM(INSDNG,SIMC);
4072   
4073  *  Activities with potentially flexible tax rates.
4074   ta01(A)        = TA01SIM(A,SIMC);
4075   tv01(A)        = TV01SIM(A,SIMC);
4076   
4077  *  Commodities with potentially flexible tax rates.
4078   te01(C)        = TE01SIM(C,SIMC);
4079   tm01(C)        = TM01SIM(C,SIMC);
4080   tq01(C)        = TQ01SIM(C,SIMC);
4081   
4082  *  Factors with potentially flexible tax rates.
4083   tf01(F)        = TF01SIM(F,SIMC);
4084   
4085   
4086  *------------------------------------------------------------------
4087  *2.4.8  Factor market closures
4088  *------------------------------------------------------------------
4089   
4090  *Factor closure 1: Factors are fully employed and mobile between activities. WF is the market-clearing variable for each factor.
4091  LOOP(F$(FACCLOSE(F,SIMC) EQ 1),
4092  *   Fixed total factor supply
4093   QFS.FX(F)           = QFSSIM(F,SIMC);
4094  *   Flexible economywide wage rate
4095   WF.LO(F)            = -INF;
4096   WF.UP(F)            = +INF;
4097   WF.L(F)             = WFSIM(F,SIMC);
4098  *   Fixed sector-specific wage distortion variable
4099   WFDIST.FX(F,A)      = WFDIST0(F,A);
4100  *   Flexible factor demand by activity
4101   QF.LO(F,A)$QF0(F,A) = -INF;
4102   QF.UP(F,A)$QF0(F,A) = +INF;
4103   QF.L(F,A)$QF0(F,A)  = QF0(F,A);
4104  );
4105   
4106  *Factor closure 2: Factors are fully employed and activity-specific. WFDIST(F,A) is the clearing variable, one for each segment of the factor market.
4107  LOOP(F$(FACCLOSE(F,SIMC) EQ 2),
4108  *   Flexible total factor supply
4109   QFS.LO(F)           = -INF;
4110   QFS.UP(F)           = +INF;
4111   QFS.L(F)            = QFSSIM(F,SIMC);
4112  *   Fixed economywide wage rate
4113   WF.FX(F)            = WFSIM(F,SIMC);
4114  *   Flexible sector-specific wage distortion variable
4115   WFDIST.LO(F,A)$QF0(F,A) = -INF;
4116   WFDIST.UP(F,A)$QF0(F,A) = +INF;
4117   WFDIST.L(F,A)$QF0(F,A)  = WFDIST0(F,A);
4118  *   Fixed factor demand by activity
4119   QF.FX(F,A)          = QF0(F,A);
4120  );
4121   
4122  *Factor closure 3: Factors are unemployed and mobile. For each activity, the wage WFDIST*WF is fixed. QFS is the market-clearing variable for the unified labor market.
4123  LOOP(F$(FACCLOSE(F,SIMC) EQ 3),
4124  *   Flexible total factor supply
4125   QFS.LO(F)           = -INF;
4126   QFS.UP(F)           = +INF;
4127   QFS.L(F)            = QFSSIM(F,SIMC);
4128  *   Fixed economywide wage rate
4129   WF.FX(F)            = WFSIM(F,SIMC);
4130  *   Fixed sector-specific wage distortion variable
4131   WFDIST.FX(F,A)      = WFDIST0(F,A);
4132  *   Flexible factor demand by activity
4133   QF.LO(F,A)$QF0(F,A) = -INF;
4134   QF.UP(F,A)$QF0(F,A) = +INF;
4135   QF.L(F,A)$QF0(F,A)  = QF0(F,A);
4136  );
4137   
4138  *Fixed capital by activity (even with general capital mobility)
4139  LOOP(A$AFIXCAP(A,SIMC),
4140  *   Fixed factor use in selected activity
4141   QF.FX(FCAP,A)                 = QF0(FCAP,A);
4142  *   Flexible sector-specific wage distortion variable
4143   WFDIST.LO(FCAP,A)$QF0(FCAP,A) = -INF;
4144   WFDIST.UP(FCAP,A)$QF0(FCAP,A) = +INF;
4145   WFDIST.L(FCAP,A)$QF0(FCAP,A)  = WFDIST0(FCAP,A);
4146  );
4147   
4148  *Fixed land by activity (even with general land mobility)
4149  LOOP(A$AFIXLND(A,SIMC),
4150  *   Fixed factor use in selected activity
4151   QF.FX(FLND,A)                 = QF0(FLND,A);
4152  *   Flexible sector-specific wage distortion variable
4153   WFDIST.LO(FLND,A)$QF0(FLND,A) = -INF;
4154   WFDIST.UP(FLND,A)$QF0(FLND,A) = +INF;
4155   WFDIST.L(FLND,A)$QF0(FLND,A)  = WFDIST0(FLND,A);
4156  );
4157   
4158   
4159  *------------------------------------------------------------------
4160  *2.4.9  Fixing variables not in the model to zero
4161  *------------------------------------------------------------------
4162   
4163   PA.FX(A)$(NOT AA(A))                    = 0;
4164   PDD.FX(C)$(NOT CD(C))                   = 0;
4165   PDS.FX(C)$(NOT CD(C))                   = 0;
4166   PE.FX(C)$(NOT CE(C))                    = 0;
4167   PM.FX(C)$(NOT CM(C))                    = 0;
4168   PVA.FX(A)$(NOT QVA0(A))                 = 0;
4169   PX.FX(C)$(NOT CX(C))                    = 0;
4170   PXAC.FX(A,C)$(NOT SAM(A,C))             = 0;
4171   QA.FX(A)$(NOT AA(A))                    = 0;
4172   QD.FX(C)$(NOT CD(C))                    = 0;
4173   QE.FX(C)$(NOT CE(C))                    = 0;
4174   QF.FX(F,A)$(NOT QF0(F,A))               = 0;
4175   QG.FX(C)$(NOT SAM(C,GV))                = 0;
4176   QH.FX(C,H)$(NOT SAM(C,H))               = 0;
4177   QHA.FX(A,H)$(NOT SAM(A,H))              = 0;
4178   QINT.FX(C,A)$(NOT SAM(C,A))             = 0;
4179   QINV.FX(C)$(NOT SAM(C,SI))              = 0;
4180   QM.FX(C)$(NOT CM(C))                    = 0;
4181   QQ.FX(C)$(NOT (CD(C) OR CM(C)))         = 0;
4182   QT.FX(C)$(NOT CT(C))                    = 0;
4183   QVA.FX(A)$(NOT QVA0(A))                 = 0;
4184   QX.FX(C)$(NOT CX(C))                    = 0;
4185   QXAC.FX(A,C)$(NOT SAM(A,C))             = 0;
4186   TRII.FX(INS,INSP)$(NOT TRII0(INS,INSP)) = 0;
4187   YI.FX(INS)$(NOT YI0(INS))               = 0;
4188   YIF.FX(INS,F)$(NOT YIF0(INS,F))         = 0;
4189   YF.FX(F)$(NOT YF0(F))                   = 0;
4190   
4191  *--- Solve model ---
4192   
4193  OPTIONS ITERLIM = 1000, LIMROW = 1000, LIMCOL = 0, SOLPRINT=ON, MCP=PATH, NLP=CONOPT CNS=CONOPT;
4194   
4195   STANDCGE.HOLDFIXED  = 1;
4196   STANDCGE.TOLINFREP  = 0.001;
4197   STANDCGE.MCPRHOLDFX = 1;
4198   STANDCGE.SCALEOPT   = 1;
4199   
4200   SOLVE STANDCGE USING MCP;
4201   
4202  *--- Save results between solves ---
4203   
BATINCLUDE C:\Users\EARAGIE\IFPRI Dropbox\Emerta Aragie\Rwanda MINECOFIN-GIZ project 2026\4 CGE model (Rwanda)\includes\static\stat_reploop.inc
