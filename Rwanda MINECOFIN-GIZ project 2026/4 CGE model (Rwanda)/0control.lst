  78   
      PART 1: Base model
       This file (1model_base.gms) generates the base model. It first declares the standard model (i.e., variables
       and equations) and then calibrates the model using country data imported from Excel. The base model is then
       solved and standard reporting parameters are generated. 
       
      SECTIONS:
       1.1  Model sets, parameters and variables
       1.2  Model equations
       1.3  Model declaration
       1.4  Import country data       (includes\1base_data.inc)
       1.5  Calibrate the base model  (includes\1base_calibrate.inc)
       1.6  Solve the base model       
       1.7  Base model reporting      (includes\1base_report.inc)
  94   
  95   
  96  *------------------------------------------------------------------
  97  *1.1 Model sets, parameters and variables
  98  *------------------------------------------------------------------
  99   
 100  *Only the sets, parameters and variables that appear in the model's equations are declared here. All
 101  *other parameters used to calibrate the model and report results are declared in the 1calibration.inc and 1data.inc files.
 102   
 103  SETS
 104   AC                global set for model accounts - aggregated microsam accounts
 105   ACNT(AC)          all elements in AC except TOTAL
 106  *Model sets
 107   A(AC)             activities
 108   C(AC)             commodities
 109   F(AC)             all factors
 110   INS(AC)           institutions
 111   INSD(INS)         domestic institutions
 112   INSDNG(INSD)      domestic non-government institutions
 113   H(INSDNG)         households
 114  *Conditional sets
 115   ACES(A)           activities with CES function at top of technology nest
 116   ALEO(A)           activities with Leontief function at top of technology nest
 117   ACCES(A)          activities with CES domestic activity aggregation function
 118   CD(C)             commodities with domestic sales of output
 119   CDN(C)            commodities without domestic sales of output
 120   CE(C)             exported commodities
 121   CEN(C)            non-export commodities
 122   CM(C)             imported commodities
 123   CMN(C)            non-imported commodities
 124   CT(C)             transaction service commodities
 125   CX(C)             commodities with output
 126   AA(A)             activities with positive domestic production
 127   FA(F)             factors with positive employment and incomes
 128   HA(A,H)           households with base year own consumption of output from activity A
 129   HC(C,H)           households with base year marketed consumption of commodity C
 130  ;
 131   
 132  SINGLETON SETS
 133   GV(INS)           government
 134   RW(INS)           rest of the world
 135  ;
 136   
 137  ALIAS
 138   (AC,ACP), (A,AP), (C,CP), (F,FP), (INSDNG,INSDNGP), (H,HP)
 139  ;
 140   
 141  PARAMETERS
 142   alphaa(A)          shift parameter for top level CES function
 143   alphaac(C)         shift parameter for domestic commodity aggregation function
 144   alphaca(A)         shift parameter for domestic activity aggregation function
 145   alphaf(F,A)        productivity shift for factor F in activity A
 146   alphaq(C)          shift parameter for QQ Armington function
 147   alphat(C)          shift parameter for CET QX aggregation function
 148   alphava(A)         shift parameter for CES activity production function
 149   betah(A,H)         marginal share of household consumption on home commodity C from activity A
 150   betam(C,H)         marginal share of household consumption on marketed commodity C
 151   cwts(C)            consumer price index weights
 152   deltaa(A)          share parameter for top level CES function
 153   deltaac(A,C)       share parameter for domestic commodity aggregation function
 154   deltaca(A,C)       share parameter for domestic activity aggregation function
 155   deltaq(C)          share parameter for Armington function
 156   deltat(C)          share parameter for CET QX function
 157   deltava(F,A)       share parameter for CES activity production function
 158   dwts(C)            domestic sales price weights
 159   gammah(A,H)        per-capita subsistence consumption for household H on home commodity C for activity A
 160   gammam(C,H)        per-capita subsistence consumption of marketed commodity C for household H
 161   ica(C,A)           intermediate input c per unit of aggregate intermediate
 162   icd(C,CP)          trade input of C per unit of commodity CP produced & sold domestically
 163   ice(C,CP)          trade input of C per unit of commodity CP exported
 164   icm(C,CP)          trade input of C per unit of commodity CP imported
 165   inta(A)            aggregate intermediate input coefficient
 166   iva(A)             aggregate value added coefficient
 167   mps01(AC)          0-1 parameter for potential flexing of savings rates
 168   mpsbar(AC)         marginal propensity to save for domestic non-government institution INS (exogenous part)
 169   pop(H)             total population of workers and non-workers in household H
 170   pwe(C)             world price of exports
 171   pwm(C)             world price of imports
 172   qbarg(C)           exogenous (unscaled) government demand
 173   qbarinv(C)         exogenous (unscaled) investment demand
 174   qdst(C)            inventory investment by sector of origin
 175   rhoa(A)            CES top level function exponent
 176   rhoac(C)           domestic commodity aggregation function exponent
 177   rhoca(A)           domestic activity aggregation function exponent
 178   rhoq(C)            Armington function exponent
 179   rhot(C)            CET function exponent
 180   rhova(A)           CES activity production function exponent
 181   shif(AC,AC)        share of institution INS (incl. rest of world) in post-tax income of factor F
 182   shii(AC,AC)        share of institution INS in post-tax post-savings income of institution INSP
 183   ta01(A)            0-1 parameter for potential flexing of activity tax rates
 184   tabar(A)           activity tax rate on activity A (exogenous part)
 185   te01(C)            0-1 parameter for potential flexing of export tax rates
 186   tebar(C)           export tax rate on commodity C (exogenous part)
 187   tf01(F)            0-1 parameter for potention flexing of factor taxes
 188   tfbar(F)           factor tax rate on factor F (exogenous part)
 189   theta(A,C)         yield of commodity C per unit of activity A
 190   ti01(AC)           0-1 parameter for potential flexing of direct tax rates
 191   tibar(INS)         direct tax rate on domestic institution INS (exogenous part)
 192   tm01(C)            0-1 parameter for potential flexing of import tax rates
 193   tmbar(C)           import tax rate on commodity C (exogenous part)
 194   trnsf(F,INS)       transfers from factor F to institution INS (including rest of world)
 195   trnsi(INS,INS)     transfers from institution INS) to institution INSP (including rest of world)
 196   tq01(C)            0-1 parameter for potential flexing of sales tax rates
 197   tqbar(C)           sales tax rate on commodity C (exogenous part)
 198   tv01(A)            0-1 parameter for potential flexing of value added tax rates
 199   tvbar(A)           value-added tax rate on activity A (exogenous part)
 200  ;
 201   
 202  VARIABLES
 203   CPI                consumer price index (PQ-based)
 204   DMPS               change in marginal propensity to save for selected institution
 205   DPI                index for domestic producer prices (PDS-based)
 206   DTA                additive activity tax (TA) adjustment
 207   DTE                additive export tax (TE) adjustment
 208   DTF                additive direct factor tax (TF) adjustment
 209   DTI                additive domestic institution tax (TI) adjustment
 210   DTM                additive import tariff (TM) adjustment
 211   DTQ                additive sales tax (TQ) adjustment
 212   DTV                additive value-added tax (TV) adjustment
 213   EG                 total current government expenditure
 214   EH(H)              household consumption expenditure
 215   EXR                exchange rate
 216   FSAV               foreign savings
 217   GADJ               government demand scaling factor
 218   GOVSHR             government consumption share of absorption
 219   GSAV               government savings
 220   IADJ               investment scaling factor (for fixed capital formation)
 221   INVSHR             investment share of absorption
 222   MPS(INS)           marginal propensity to save for domestic non-government institution INS
 223   MPSADJ             savings rate (MPS) scaling factor
 224   PA(A)              output price of activity A
 225   PDD(C)             demand price for commodity C produced and sold domestically
 226   PDS(C)             supply price for commodity C produced and sold domestically
 227   PE(C)              price of export aggregate to producer excluding transport costs
 228   PINTA(A)           price of intermediate aggregate
 229   PM(C)              price of import aggregate to demander including transport costs
 230   PQ(C)              price of composite commodity C
 231   PSAV               total private savings
 232   PVA(A)             value added price
 233   PX(C)              average output price
 234   PXAC(A,C)          price of commodity C from activity A
 235   QA(A)              level of domestic activity
 236   QD(C)              quantity of domestic sales
 237   QE(C)              quantity of exports
 238   QF(F,A)            quantity demanded of factor F from activity A
 239   QFS(F)             quantity of factor supply
 240   QG(C)              quantity of government consumption
 241   QH(C,H)            quantity consumed of marketed commodity C by household H
 242   QHA(A,H)           quantity consumed of home activity A by household H
 243   QINT(C,A)          quantity of intermediate demand for commodity C from activity A
 244   QINTA(A)           quantity of aggregate intermediate input
 245   QINV(C)            quantity of fixed investment demand
 246   QM(C)              quantity of imports
 247   QQ(C)              quantity of composite goods supply
 248   QT(C)              quantity of trade and transport demand for commodity C
 249   QVA(A)             quantity of aggregate value added
 250   QX(C)              quantity of aggregate marketed commodity output
 251   QXAC(A,C)          quantity of ouput of commodity C from activity A
 252   TA(A)              activity tax rates
 253   TAADJ              activity tax (TA) scaling factor
 254   TABS               total absorption
 255   TE(C)              export tax rates
 256   TEADJ              export tax (TE) scaling factor
 257   TF(F)              direct factor tax rates
 258   TFADJ              direct factor tax (TF) scaling factor
 259   TI(INS)            direct tax rates on domestic institutions INSD
 260   TIADJ              direct tax (TI) scaling factor
 261   TM(C)              import tariff rates
 262   TMADJ              import tariff (TM) scaling factor
 263   TRII(INS,INS)      transfers from column institutions INSF to row institutions INS
 264   TQ(C)              composite commodity taxes
 265   TQADJ              composite commodity tax (TQ) scaling factor
 266   TV(A)              value-added tax rate
 267   TVADJ              value-added tax (TV) scaling factor
 268   WALRAS             savings-investment imbalance (should be zero)
 269   WF(F)              economywide wage (rent) for factor F
 270   WFDIST(F,A)        wage distortion variable for factor F in activity A
 271   YF(F)              factor income from activities
 272   YG                 total government income
 273   YI(INS)            income of domestic non-government institution INS
 274   YIF(INS,F)         income of institution INS from factor F
 275  ;
 276   
 277   
 278  *------------------------------------------------------------------
 279  *1.2 Model equations
 280  *------------------------------------------------------------------
 281   
 282  EQUATIONS
 283  *--- Prices ---
 284   PMDEF(C)           domestic import price
 285   PEDEF(C)           domestic export price
 286   PDDDEF(C)          demand price for commodities produced and sold domestically
 287   PQDEF(C)           value of sales in domestic market
 288   PXDEF(C)           value of marketed domestic output
 289   PADEF(A)           activity output price
 290   PINTADEF(A)        price of aggregate intermediate input for activity A
 291   PVADEF(A)          value-added price and adding up condition for top nest for activity A
 292   CPIDEF             consumer price index
 293   DPIDEF             domestic producer price index
 294  *--- Production and trade ---
 295   CESAGGPRD(A)       CES aggregate production function for activity A (if CES top nest)
 296   CESAGGFOC(A)       CES aggregate first-order condition for activity A (if CES top nest)
 297   LEOAGGINT(A)       Leontief aggregate intermediate demand for activity A (if Leontief top nest)
 298   LEOAGGVA(A)        Leontief aggregate value-added demand for activity A (if Leontief top nest)
 299   CESVAPRD(A)        CES value-added production function for activity A
 300   FACDEM(F,A)        CES value-added first-order condition for factor F used in activity A
 301   INTDEM(C,A)        intermediate demand for commodity C from activity A
 302   COMPRDFN(A,C)      production function for commodity C and activity A
 303   COMPRDFN2(A,C)     CET first order conditions for commodity C to activity A aggregation
 304   OUTAGGFN(C)        output aggregation function for commodity C
 305   OUTAGGFOC(A,C)     first-order condition for output aggregation function for commodity C produced by activity A
 306   CET(C)             CET export supply function for commodity C
 307   ESUPPLY(C)         first-order condition for export supply for commodity C
 308   CET2(C)            domestic sales and exports for commodity C (for commodities without both domestic sales and exports)
 309   ARMINGTON(C)       composite commodity aggregation function for commodity C
 310   COSTMIN(C)         first-order condition for composite commodity cost minimization for commodity C
 311   ARMINGTON2(C)      composite supply for commoidity C (for commodities without both domestic sales and imports)
 312   QTDEM(C)           demand for transactions (trade and transport) services
 313  *--- Institution    income and expenditure ---
 314   YFDEF(F)           total incomes including transfers for factor F
 315   YIFDEF(INS,F)      factor incomes to domestic institutions and rest of world
 316   YIDEF(INS)         total incomes of domest nongovernment institutions
 317   TRIIDEF(INS,INS)   transfers from institution INSP to institution INS
 318   EHDEF(H)           household consumption expenditures
 319   HMDEM(C,H)         LES consumption demand by household H for marketed commodity C
 320   HADEM(A,H)         LES consumption demand by household H for home for activity A
 321   INVDEM(C)          fixed investment demand
 322   GOVDEM(C)          government consumption demand
 323   YGDEF              total government income
 324   EGDEF              total government expenditures
 325  *--- System constraints ---
 326   FACEQUIL(F)        factor market equilibrium
 327   COMEQUIL(C)        composite commodity market equilibrium
 328   CURACCBAL          current account balance
 329   GOVBAL             government balance
 330   PRVSAV             total private savings
 331   SAVINVBAL          savings-investment balance
 332   TABSEQ             total absorption
 333   INVABEQ            investment share in absorption
 334   GOVABEQ            government consumption share in absorption
 335  *--- Savings and tax rates ---
 336   MPSDEF(INS)        marginal propensity to save for institution INS
 337   TADEF(A)           activity taxes
 338   TEDEF(C)           export tax rates
 339   TFDEF(F)           factor tax rate
 340   TIDEF(INS)         direct tax rate for institution INS
 341   TMDEF(C)           tariff rates
 342   TQDEF(C)           commodity taxes
 343   TVDEF(A)           value-added taxes
 344  ;
 345   
 346  *--- Price equations ----
 347   
 348   PMDEF(C)$CM(C)..
 349           PM(C) =E= pwm(C)*(1 + TM(C))*EXR + SUM(CT, PQ(CT)*icm(CT,C));
 350   
 351   PEDEF(C)$CE(C)..
 352           PE(C) =E= pwe(C)*(1 - TE(C))*EXR - SUM(CT, PQ(CT)*ice(CT,C));
 353   
 354   PDDDEF(C)$CD(C)..
 355           PDD(C) =E= PDS(C) + SUM(CT, PQ(CT)*icd(CT,C));
 356   
 357   PQDEF(C)$(CD(C) OR CM(C))..
 358           PQ(C)*(1 - TQ(C))*QQ(C) =E= PDD(C)*QD(C) + PM(C)*QM(C);
 359   
 360   PXDEF(C)$CX(C)..
 361           PX(C)*QX(C) =E= PDS(C)*QD(C) + PE(C)*QE(C);
 362   
 363   PADEF(A)$AA(A)..
 364           PA(A) =E= SUM(C, PXAC(A,C)*theta(A,C));
 365   
 366   PINTADEF(A)$AA(A)..
 367           PINTA(A) =E= SUM(C, PQ(C)*ica(C,A));
 368   
 369   PVADEF(A)$AA(A)..
 370           PVA(A)*QVA(A) =E= PA(A)*(1-TA(A))*QA(A) - PINTA(A)*QINTA(A);
 371   
 372   CPIDEF..
 373           CPI =E= SUM(C, cwts(C)*PQ(C));
 374   
 375   DPIDEF..
 376           DPI =E= SUM(CD, dwts(CD)*PDS(CD));
 377   
 378  *--- Production and trade equations ---
 379   
 380   CESAGGPRD(A)$ACES(A)..
 381           QA(A) =E= alphaa(A)*(deltaa(A)*QVA(A)**(-rhoa(A)) + (1-deltaa(A))*QINTA(A)**(-rhoa(A)))**(-1/rhoa(A));
 382   
 383   CESAGGFOC(A)$ACES(A)..
 384           QVA(A) =E= QINTA(A)*((PINTA(A)/PVA(A))*(deltaa(A)/(1 - deltaa(A))))**(1/(1+rhoa(A)));
 385   
 386   LEOAGGVA(A)$ALEO(A)..
 387           QVA(A) =E= iva(A)*QA(A);
 388   
 389   LEOAGGINT(A)$ALEO(A)..
 390           QINTA(A) =E= inta(A)*QA(A);
 391   
 392   CESVAPRD(A)$AA(A)..
 393           QVA(A) =E= alphava(A)*(SUM(F, deltava(F,A)*(alphaf(F,A)*QF(F,A))**(-rhova(A))) )**(-1/rhova(A)) ;
 394   
 395   FACDEM(F,A)$deltava(F,A)..
 396           WF(F)*WFDIST(F,A) =E= PVA(A)*(1-TV(A))*QVA(A) * SUM(FP, deltava(FP,A)*(alphaf(FP,A)*QF(FP,A))**(-rhova(A)))**(-1) * deltava(F,A) * (alphaf(F,A)*QF(F,A))**(-rhova(A)-1);
 397   
 398   INTDEM(C,A)$ica(C,A)..
 399           QINT(C,A) =E= ica(C,A)*QINTA(A);
 400   
 401   COMPRDFN(A,C)$(theta(A,C) AND NOT ACCES(A))..
 402           QXAC(A,C) =E= theta(A,C)*(QA(A) - SUM(H, QHA(A,H)));
 403   
 404   COMPRDFN2(A,C)$(theta(A,C) AND ACCES(A))..
 405           QXAC(A,C) =E= (QA(A) - SUM(H, QHA(A,H)))*(PXAC(A,C)/(PA(A)*deltaca(A,C)*alphaca(A)**rhoca(A)))**(1/(rhoca(A)-1));
 406   
 407   OUTAGGFN(C)$CX(C)..
 408           QX(C) =E= alphaac(C)*SUM(A, deltaac(A,C)*QXAC(A,C)**(-rhoac(C)))**(-1/rhoac(C));
 409   
 410   OUTAGGFOC(A,C)$deltaac(A,C)..
 411           PXAC(A,C) =E= PX(C)*QX(C) * SUM(AP, deltaac(AP,C)*QXAC(AP,C)**(-rhoac(C)))**(-1)*deltaac(A,C)*QXAC(A,C)**(-rhoac(C)-1);
 412   
 413   CET(C)$(CE(C) AND CD(C))..
 414           QX(C) =E= alphat(C)*(deltat(C)*QE(C)**rhot(C) + (1 - deltat(C))*QD(C)**rhot(C))**(1/rhot(C));
 415   
 416   ESUPPLY(C)$(CE(C) AND CD(C))..
 417           QE(C) =E=  QD(C)*((PE(C)/PDS(C))*((1 - deltat(C))/deltat(C)))**(1/(rhot(C)-1));
 418   
 419   CET2(C)$((CD(C) AND CEN(C)) OR (CE(C) AND CDN(C)))..
 420           QX(C) =E= QD(C) + QE(C);
 421   
 422   ARMINGTON(C)$(CM(C) AND CD(C))..
 423           QQ(C) =E= alphaq(C)*(deltaq(C)*QM(C)**(-rhoq(C)) + (1 - deltaq(C))*QD(C)**(-rhoq(C)))**(-1/rhoq(C));
 424   
 425   COSTMIN(C)$(CM(C) AND CD(C))..
 426           QM(C) =E= QD(C)*((PDD(C)/PM(C))*(deltaq(C)/(1 - deltaq(C))))**(1/(1 + rhoq(C)));
 427   
 428   ARMINGTON2(C)$((CD(C) AND CMN(C)) OR (CM(C) AND CDN(C)))..
 429           QQ(C) =E= QD(C) + QM(C);
 430   
 431   QTDEM(C)$CT(C)..
 432           QT(C) =E= SUM(CP, icm(C,CP)*QM(CP)+ ice(C,CP)*QE(CP)+ icd(C,CP)*QD(CP));
 433   
 434  *--- Institution income and expenditure equations ---
 435   
 436   YFDEF(F)$FA(F)..
 437           YF(F) =E= SUM(A, WF(F)*WFDIST(F,A)*QF(F,A)) + trnsf(F,GV)*CPI + trnsf(F,RW)*EXR;
 438   
 439   YIFDEF(INS,F)$FA(F)..
 440           YIF(INS,F) =E= shif(INS,F) * YF(F)*(1-TF(F));
 441   
 442   YIDEF(INSDNG)..
 443           YI(INSDNG) =E= SUM(F, YIF(INSDNG,F)) + SUM(INSDNGP, TRII(INSDNG,INSDNGP)) + trnsi(INSDNG,GV)*CPI + trnsi(INSDNG,RW)*EXR;
 444   
 445   TRIIDEF(INS,INSDNG)$shii(INS,INSDNG)..
 446           TRII(INS,INSDNG) =E= shii(INS,INSDNG) * YI(INSDNG)*(1-TI(INSDNG))*(1-MPS(INSDNG));
 447   
 448   EHDEF(H)$(SUM(C, HC(C,H)) OR SUM(A, HA(A,H)))..
 449           EH(H) =E= (1 - SUM(INS, shii(INS,H))) * YI(H)*(1-TI(H))*(1-MPS(H));
 450   
 451   HMDEM(C,H)$HC(C,H)..
 452           PQ(C)*QH(C,H)  =E= pop(H)*(PQ(C)*gammam(C,H) + betam(C,H)*(EH(H)/pop(H) - SUM(CP, PQ(CP)*gammam(CP,H)) - SUM(A,  PA(A)*gammah(A,H))));
 453   
 454   HADEM(A,H)$HA(A,H)..
 455           PA(A)*QHA(A,H) =E= pop(H)*(PA(A)*gammah(A,H) + betah(A,H)*(EH(H)/pop(H) - SUM(C, PQ(C)*gammam(C,H)) - SUM(AP, PA(AP)*gammah(AP,H))));
 456   
 457   INVDEM(C)..
 458           QINV(C) =E= IADJ*qbarinv(C);
 459   
 460   GOVDEM(C)..
 461           QG(C) =E= GADJ*qbarg(C);
 462   
 463   YGDEF..
 464           YG =E=    SUM(A, TA(A)*PA(A)*QA(A))
 465                   + SUM(CM, TM(CM)*pwm(CM)*QM(CM)*EXR)
 466                   + SUM(CE, TE(CE)*pwe(CE)*QE(CE)*EXR)
 467                   + SUM(C, TQ(C)*PQ(C)*QQ(C))
 468                   + SUM(A, TV(A)*PVA(A)*QVA(A))
 469                   + SUM(F, TF(F)*YF(F))
 470                   + SUM(INSDNG, TI(INSDNG)*YI(INSDNG))
 471                   + SUM(F, YIF(GV,F))
 472                   + SUM(INSDNG, TRII(GV,INSDNG))
 473                   + trnsi(GV,RW)*EXR;
 474   
 475   EGDEF..
 476           EG =E=   SUM(C, PQ(C)*QG(C))
 477                  + SUM(INSDNG, trnsi(INSDNG,GV))*CPI
 478                  + trnsi(RW,GV)*EXR;
 479   
 480  *--- System constraints ---
 481   
 482   FACEQUIL(F)..
 483           QFS(F) =E= SUM(A, QF(F,A));
 484   
 485   COMEQUIL(C)$(CD(C) OR CM(C))..
 486           QQ(C) =E= SUM(A, QINT(C,A)) + SUM(H, QH(C,H)) + QG(C) + QINV(C) + qdst(C) + QT(C);
 487   
 488   CURACCBAL..
 489           SUM(CM, pwm(CM)*QM(CM)) + SUM(F, YIF(RW,F))/EXR + SUM(INSDNG, TRII(RW,INSDNG))/EXR + trnsi(RW,GV) =E= SUM(CE, pwe(CE)*QE(CE)) + SUM(F, trnsf(F,RW)) + SUM(INSD, trnsi(INSD,RW)) + FSAV;
 490   
 491   GOVBAL..
 492           YG =E= EG + GSAV;
 493   
 494   PRVSAV..
 495           PSAV =E= SUM(INSDNG, MPS(INSDNG)*(1-TI(INSDNG))*YI(INSDNG));
 496   
 497   SAVINVBAL..
 498            PSAV + GSAV + FSAV*EXR =E= SUM(C, PQ(C)*QINV(C)) + SUM(C, PQ(C)*qdst(C)) + WALRAS;
 499   
 500   TABSEQ..
 501           TABS =E= SUM((C,H)$HC(C,H), PQ(C)*QH(C,H)) + SUM((A,H)$HA(A,H), PA(A)*QHA(A,H)) + SUM(C, PQ(C)*QG(C)) + SUM(C, PQ(C)*QINV(C)) + SUM(C, PQ(C)*qdst(C));
 502   
 503   INVABEQ..
 504           INVSHR*TABS =E= SUM(C, PQ(C)*QINV(C)) + SUM(C, PQ(C)*qdst(C));
 505   
 506   GOVABEQ..
 507           GOVSHR*TABS =E= SUM(C, PQ(C)*QG(C));
 508   
 509  *--- Savings and tax rates ---
 510   
 511   MPSDEF(INSDNG)..
 512           MPS(INSDNG)  =E= mpsbar(INSDNG)*(1 + MPSADJ*mps01(INSDNG)) + DMPS*mps01(INSDNG);
 513   
 514   TADEF(A)..
 515           TA(A) =E= tabar(A)*(1 + TAADJ*ta01(A)) + DTA*ta01(A);
 516   
 517   TEDEF(C)$CE(C)..
 518           TE(C) =E= tebar(C)*(1 + TEADJ*te01(C)) + DTE*te01(C);
 519   
 520   TFDEF(F)..
 521           TF(F) =E= tfbar(F)*(1 + TFADJ*tf01(F)) + DTF*tf01(F);
 522   
 523   TIDEF(INSDNG)..
 524           TI(INSDNG) =E= tibar(INSDNG)*(1 + TIADJ*ti01(INSDNG)) + DTI*ti01(INSDNG);
 525   
 526   TMDEF(C)$CM(C)..
 527           TM(C)  =E= tmbar(C)*(1 + TMADJ*tm01(C)) + DTM*tm01(C);
 528   
 529   TQDEF(C)..
 530           TQ(C) =E= tqbar(C)*(1 + TQADJ*tq01(C)) + DTQ*tq01(C);
 531   
 532   TVDEF(A)..
 533           TV(A) =E= tvbar(A)*(1 + TVADJ*tv01(A)) + DTV*tv01(A);
 534   
