1833  *1.7 Base model reporting
1834  *------------------------------------------------------------------
1835   
1836  *Base solution reports
INCLUDE    C:\Users\EARAGIE\IFPRI Dropbox\Emerta Aragie\Rwanda MINECOFIN-GIZ project 2026\4 CGE model (Rwanda)\includes\base\base_report.inc
1839   
      PART 1.7: Base model reporting 
       This include file (includes\1base_report.inc) produces the following reports based on data from
       the base model solution (with the name of the relevant parameter in parentheses):
       
      SECTIONS:
       1.7.1  Economic structure table by activity            (STRUCBASEA)
       1.7.2  Economic structure table by commoidity          (STRUCBASEC)
       1.7.3  GDP table                                       (GDPBASE)
       1.7.4  Macro SAM                                       (MACROSAM)
       1.7.5  Input shares, factor wages, and elasticities    (FACTAB1-4)
       1.7.6  Household incomes                               (HHDTAB1-2)
1853   
1854   
1855  *------------------------------------------------------------------
1856  * 1.7.1. Economic structure table by activity (STRUCBASEA)
1857  * 1.7.2. Economic structure table by commodity (STRUCBASEC)
1858  *------------------------------------------------------------------
1859   
1860  SETS
1861   STRROW             rows (controls order in display) /
1862    TOTAL-1           total
1863    TAGR              agriculture
1864    TNAG              non-agriculture
1865    TIND              industry
1866    TSRV              services
1867    TOTAL-2           total
1868   /
1869   STRCOL             columns /
1870    VAshr             value-added shares (%)
1871    PRDshr            production shares (%)
1872    EMPshr            employment shares (%)
1873    QQshr             total commodity supply shares (%)
1874    HHDshr            private marketed consumption shares (%)
1875    OWNshr            private own consumption shares (%)
1876    MKTshr            private marketed consumption shares (%)
1877    GOVshr            public consumption shares (%)
1878    INVshr            gross capital formation shares (%)
1879    EXPshr            sector share in total exports (%)
1880    IMPshr            sector share in total imports (%)
1881    OWN-OUTshr        private own consumption as share of production (%)
1882    EXP-OUTshr        exports as share in sector output (%)
1883    IMP-DEMshr        imports as share of domestic demand (%)
1884    TRErate           transaction cost rate - exports (%)
1885    TRMrate           transaction cost rate - imports (%)
1886    TRDrate           transaction cost rate - domestic (%)
1887   /
1888   STRCOL2(STRCOL)    columns for summation operation /
1889    QQshr             sector share in total commodity supply (%)
1890    HHDshr            sector share in total private marketed consumption (%)
1891    GOVshr            sector share in total public consumption (%)
1892    INVshr            sector share in total gross capital formation (%)
1893    EXPshr            sector share in total exports (%)
1894    IMPshr            sector share in total imports (%)
1895   /
1896   STRCOL3(STRCOL)    columns for activities /
1897    VAshr             value-added shares (%)
1898    PRDshr            production shares (%)
1899    EMPshr            employment shares (%)
1900    OWNshr            private own consumption shares (%)
1901   /
1902  ;
1903   
1904  PARAMETER
1905   b_STRUCTABC(*,STRCOL)      economic structure by commodity in the base
1906   b_STRUCTABA(*,STRCOL)      economic structure by activity in the base
1907  ;
1908   
1909  *Note: For VAshr, PRDshr, and EMPshr, data scaled by share of activity in output of commodity to avoid double-counting
1910  *when there is not a one-to-one mapping between activities and commodities.
1911   
1912  *Structural data by activities
1913   b_STRUCTABA(A,'VAshr')                           = PVA.L(A)*(1-TV.L(A))*QVA.L(A) / SUM(AP, PVA.L(AP)*(1-TV.L(AP))*QVA.L(AP)) * 100;
1914   b_STRUCTABA(A,'PRDshr')                          = PA.L(A)*QA.L(A) / SUM(AP, PA.L(AP)*QA.L(AP)) * 100;
1915   b_STRUCTABA(A,'EMPshr')                          = SUM(F$FLAB(F), QF.L(F,A)) / SUM((F,AP)$FLAB(F), QF.L(F,AP)) * 100;
1916   b_STRUCTABA(A,'OWNshr')$SUM(H, QHA0(A,H))        = SUM(H, PA.L(A)*QHA.L(A,H)) / SUM((AP,H), PA.L(AP)*QHA.L(AP,H)) * 100;
1917   b_STRUCTABA(A,'OWN-OUTshr')$(PA.L(A) * QA.L(A))  = SUM(H, PA.L(A)*QHA.L(A,H)) / (PA.L(A)*QA.L(A)) * 100;
1918   
1919  *Structural data by commodity
1920   b_STRUCTABC(C,'QQshr')                           = PQ.L(C)*QQ.L(C) / SUM(CP, PQ.L(CP)*QQ.L(CP)) * 100;
1921   b_STRUCTABC(C,'HHDshr')                          = SUM(H, PQ.L(C)*QH.L(C,H)) / SUM((CP,H), PQ.L(CP)*QH.L(CP,H)) * 100;
1922   b_STRUCTABC(C,'MKTshr')                          = SUM(H, PQ.L(C)*QH.L(C,H)) / SUM((CP,H), PQ.L(CP)*QH.L(CP,H)) * 100;
1923   b_STRUCTABC(C,'GOVshr')                          = PQ.L(C)*QG.L(C) / SUM(CP, PQ.L(CP)*QG.L(CP)) * 100;
1924   b_STRUCTABC(C,'INVshr')                          = PQ.L(C)*(QINV.L(C)+qdst(C)) / SUM(CP, PQ.L(CP)*(QINV.L(CP)+qdst(CP))) * 100;
1925   b_STRUCTABC(C,'EXPshr')                          = pwe(C)*QE.L(C) / SUM(CP, pwe(CP)*QE.L(CP)) * 100;
1926   b_STRUCTABC(C,'IMPshr')                          = pwm(C)*QM.L(C) / SUM(CP, pwm(CP)*QM.L(CP)) * 100;
1927   b_STRUCTABC(C,'EXP-OUTshr')$(PX.L(C)*QX.L(C))    = PE.L(C)*QE.L(C) / (PX.L(C)*QX.L(C)) * 100;
1928   b_STRUCTABC(C,'IMP-DEMshr')$(PQ.L(C)*QQ.L(C))    = PM.L(C)*QM.L(C) / (PQ.L(C)*(1 - TQ.L(C))*QQ.L(C)) * 100;
1929   
1930  *Aggregates: Own consumption-output shares
1931   b_STRUCTABA('TOTAL-1','OWN-OUTshr')              = SUM((A,H),         PA.L(A)*QHA.L(A,H)) / SUM(A,         PA.L(A)*QA.L(A)) * 100;
1932   b_STRUCTABA('TAGR','OWN-OUTshr')$SUM(A, AAGR(A)) = SUM((A,H)$AAGR(A), PA.L(A)*QHA.L(A,H)) / SUM(A$AAGR(A), PA.L(A)*QA.L(A)) * 100;
1933   b_STRUCTABA('TNAG','OWN-OUTshr')$SUM(A, AAGR(A)) = SUM((A,H)$AAGR(A), PA.L(A)*QHA.L(A,H)) / SUM(A$AAGR(A), PA.L(A)*QA.L(A)) * 100;
1934   b_STRUCTABA('TIND','OWN-OUTshr')$SUM(A, AIND(A)) = SUM((A,H)$AIND(A), PA.L(A)*QHA.L(A,H)) / SUM(A$AIND(A), PA.L(A)*QA.L(A)) * 100;
1935   b_STRUCTABA('TSRV','OWN-OUTshr')$SUM(A, ASRV(A)) = SUM((A,H)$ASRV(A), PA.L(A)*QHA.L(A,H)) / SUM(A$ASRV(A), PA.L(A)*QA.L(A)) * 100;
1936   
1937  *Aggregates: Export-output shares
1938   b_STRUCTABC('TOTAL-1','EXP-OUTshr')              = SUM(C,         PE.L(C)*QE.L(C)) / SUM(C,         PX.L(C)*QX.L(C)) * 100;
1939   b_STRUCTABC('TAGR','EXP-OUTshr')$SUM(C, CAGR(C)) = SUM(C$CAGR(C), PE.L(C)*QE.L(C)) / SUM(C$CAGR(C), PX.L(C)*QX.L(C)) * 100;
1940   b_STRUCTABC('TNAG','EXP-OUTshr')$SUM(C, CAGR(C)) = SUM(C$CAGR(C), PE.L(C)*QE.L(C)) / SUM(C$CAGR(C), PX.L(C)*QX.L(C)) * 100;
1941   b_STRUCTABC('TIND','EXP-OUTshr')$SUM(C, CIND(C)) = SUM(C$CIND(C), PE.L(C)*QE.L(C)) / SUM(C$CIND(C), PX.L(C)*QX.L(C)) * 100;
1942   b_STRUCTABC('TSRV','EXP-OUTshr')$SUM(C, CSRV(C)) = SUM(C$CSRV(C), PE.L(C)*QE.L(C)) / SUM(C$CSRV(C), PX.L(C)*QX.L(C)) * 100;
1943   
1944  *Aggregates: Import-demand shares
1945   b_STRUCTABC('TOTAL-1','IMP-DEMshr')              = SUM(C,         PM.L(C)*QM.L(C)) / SUM(C,         PQ.L(C)*(1 - TQ.L(C))*QQ.L(C)) * 100;
1946   b_STRUCTABC('TAGR','IMP-DEMshr')$SUM(C, CAGR(C)) = SUM(C$CAGR(C), PM.L(C)*QM.L(C)) / SUM(C$CAGR(C), PQ.L(C)*(1 - TQ.L(C))*QQ.L(C)) * 100;
1947   b_STRUCTABC('TNAG','IMP-DEMshr')$SUM(C, CAGR(C)) = SUM(C$CAGR(C), PM.L(C)*QM.L(C)) / SUM(C$CAGR(C), PQ.L(C)*(1 - TQ.L(C))*QQ.L(C)) * 100;
1948   b_STRUCTABC('TIND','IMP-DEMshr')$SUM(C, CAGR(C)) = SUM(C$CIND(C), PM.L(C)*QM.L(C)) / SUM(C$CIND(C), PQ.L(C)*(1 - TQ.L(C))*QQ.L(C)) * 100;
1949   b_STRUCTABC('TSRV','IMP-DEMshr')$SUM(C, CAGR(C)) = SUM(C$CSRV(C), PM.L(C)*QM.L(C)) / SUM(C$CSRV(C), PQ.L(C)*(1 - TQ.L(C))*QQ.L(C)) * 100;
1950   
1951  *Summation: Activities.
1952   b_STRUCTABA('TOTAL-1',STRCOL3)                   = SUM(A,         b_STRUCTABA(A,STRCOL3));
1953   b_STRUCTABA('TAGR',STRCOL3)                      = SUM(A$AAGR(A), b_STRUCTABA(A,STRCOL3));
1954   b_STRUCTABA('TNAG',STRCOL3)                      = SUM(A$ANAG(A), b_STRUCTABA(A,STRCOL3));
1955   b_STRUCTABA('TIND',STRCOL3)                      = SUM(A$AIND(A), b_STRUCTABA(A,STRCOL3));
1956   b_STRUCTABA('TSRV',STRCOL3)                      = SUM(A$ASRV(A), b_STRUCTABA(A,STRCOL3));
1957   b_STRUCTABA('TOTAL-2',STRCOL3)                   = b_STRUCTABA('TAGR',STRCOL3) + b_STRUCTABA('TNAG',STRCOL3);
1958   
1959  *Summation: Commodities.
1960   b_STRUCTABC('TOTAL-1',STRCOL2)                   = SUM(C,         b_STRUCTABC(C,STRCOL2)) ;
1961   b_STRUCTABC('TAGR',STRCOL2)                      = SUM(C$CAGR(C), b_STRUCTABC(C,STRCOL2));
1962   b_STRUCTABC('TNAG',STRCOL2)                      = SUM(C$CNAG(C), b_STRUCTABC(C,STRCOL2));
1963   b_STRUCTABC('TIND',STRCOL2)                      = SUM(C$CIND(C), b_STRUCTABC(C,STRCOL2));
1964   b_STRUCTABC('TSRV',STRCOL2)                      = SUM(C$CSRV(C), b_STRUCTABC(C,STRCOL2));
1965   b_STRUCTABC('TOTAL-2',STRCOL2)                   = b_STRUCTABC('TAGR',STRCOL2) + b_STRUCTABC('TNAG',STRCOL2);
1966   
1967   b_STRUCTABA('TOTAL-2','OWN-OUTshr')              = b_STRUCTABA('TOTAL-1','OWN-OUTshr') ;
1968   b_STRUCTABC('TOTAL-2','IMP-DEMshr')              = b_STRUCTABC('TOTAL-1','IMP-DEMshr') ;
1969   b_STRUCTABC('TOTAL-2','EXP-OUTshr')              = b_STRUCTABC('TOTAL-1','EXP-OUTshr') ;
1970   
1971  *------------------------------------------------------------------
1972  * 1.7.3  GDP table (GDPBASE)
1973  *------------------------------------------------------------------
1974   
1975  SETS
1976   IGDPX              items for GDP and national accounts /
1977    ABSORP            absorption
1978    PRVCON            private consumption
1979    FIXINV            fixed investment
1980    DSTOCK            stock change
1981    GOVCON            government consumption
1982    EXPORTS           exports
1983    IMPORTS           imports
1984    GDPMP             GDP at market prices (alt. 1: spending)
1985    GDPMP2            GDP at market prices (alt. 2: value-added)
1986    NETITAX           net indirect taxes
1987    GDPFC2            GDP at factor cost
1988   /
1989   IGDPXX(IGDPX)      items for GDPMP summation /
1990    PRVCON            private consumption
1991    FIXINV            fixed investment
1992    DSTOCK            stock change
1993    GOVCON            government consumption
1994    EXPORTS           exports
1995    IMPORTS           imports
1996   /
1997   KGDPX              second index in GDP tables /
1998    VALUE, PERC-GDP, PERC-TOT
1999   /
2000  ;
2001   
2002  PARAMETERS
2003   b_GDPTAB(IGDPX,KGDPX)    aggregate national accounts summary
2004   b_GDPERR                 error if alt GDP definitions are not identical
2005  ;
2006   
2007   b_GDPTAB('PRVCON','VALUE')  =  SUM((C,H), PQ.L(C)*QH.L(C,H)) + SUM((A,H), PA.L(A)*QHA.L(A,H));
2008   b_GDPTAB('FIXINV','VALUE')  =  SUM(C, PQ.L(C)*QINV.L(C));
2009   b_GDPTAB('DSTOCK','VALUE')  =  SUM(C, PQ.L(C)*QDST(C));
2010   b_GDPTAB('GOVCON','VALUE')  =  SUM(C, PQ.L(C)*QG.L(C));
2011   b_GDPTAB('EXPORTS','VALUE') =  SUM((CE), pwe(CE)*EXR.L*QE.L(CE));
2012   b_GDPTAB('IMPORTS','VALUE') = -SUM((CM), pwm(CM)*EXR.L*QM.L(CM));
2013   b_GDPTAB('GDPMP','VALUE')   =  SUM(IGDPXX, b_GDPTAB(IGDPXX,'VALUE'));
2014   b_GDPTAB('ABSORP','VALUE')  =  b_GDPTAB('GDPMP','VALUE') + b_GDPTAB('IMPORTS','VALUE') - b_GDPTAB('EXPORTS','VALUE');
2015   
2016   b_GDPTAB('GDPFC2','VALUE')  = SUM((F,A), WF.L(F)*WFDIST.L(F,A)*QF.L(F,A));
2017   
2018   b_GDPTAB('NETITAX','VALUE') =
2019             SUM(A,    TA.L(A)*PA.L(A)*QA.L(A))
2020           + SUM(A,    TV.L(A)*PVA.L(A)*QVA.L(A))
2021           + SUM((CM), TM.L(CM)*QM.L(CM)*pwm(CM))*EXR.L
2022           + SUM((CE), TE.L(CE)*QE.L(CE)*pwe(CE))*EXR.L
2023           + SUM(C,    TQ.L(C)*PQ.L(C)*QQ.L(C));
2024   
2025   b_GDPTAB('GDPMP2','VALUE')
2026           = b_GDPTAB('GDPFC2','VALUE') + b_GDPTAB('NETITAX','VALUE');
2027   
2028   b_GDPERR$(ABS(b_GDPTAB('GDPMP2','VALUE') - b_GDPTAB('GDPMP','VALUE')) GT 0.00001)
2029           = b_GDPTAB('GDPMP2','VALUE') - b_GDPTAB('GDPMP','VALUE');
2030   
2031   b_GDPTAB(IGDPX,'PERC-GDP')$b_GDPTAB('GDPMP','VALUE')
2032           = 100 * b_GDPTAB(IGDPX,'VALUE')/b_GDPTAB('GDPMP','VALUE');
2033   
2034   
2035  *------------------------------------------------------------------
2036  * 1.7.4  Macro SAM (MACROSAM)
2037  *------------------------------------------------------------------
2038   
2039  SET
2040   ACMAC              macrosam accounts /
2041    ACT2              activities
2042    COM2              commodities
2043    FAC2              factors
2044    ENT2              enterprises
2045    HOU2              households
2046    GOV2              current government
2047    ACTTAX2           indirect taxes on activity revenue
2048    COMTAX2           indirect taxes on commodity sales in domestic market
2049    EXPTAX2           export taxes
2050    FACTAX2           direct factor taxes
2051    IMPTAX2           import taxes
2052    INSTAX2           direct taxes on domestic institutions
2053    VATAX2            value-added taxes
2054    S-I2              savings investment account
2055    ROW2              rest of World
2056    TOTAL2            totals
2057   /
2058   ACMACNT(ACMAC)     all macrosam accounts except TOTAL2
2059   ACMACTAX(ACMAC)    tax accounts /
2060    ACTTAX2           indirect taxes on activity revenue
2061    COMTAX2           indirect taxes on commodity sales in domestic market
2062    EXPTAX2           export taxes
2063    FACTAX2           direct factor taxes
2064    IMPTAX2           import taxes
2065    INSTAX2           direct taxes on domestic institutions
2066    VATAX2            value-added taxes
2067   /
2068  ;
2069   
2070   ACMACNT(ACMAC)    = YES;
2071   ACMACNT('TOTAL2') = NO;
2072   
2073  ALIAS(ACMAC,ACMACP),(ACMACNT,ACMACNTP);
2074   
2075  PARAMETER
2076   b_MACROSAM(ACMAC,ACMACP)   macro SAM
2077   b_BALCHK2(ACMAC)           total balance check
2078  ;
2079   
2080  *Activities.
2081   b_MACROSAM('COM2','ACT2')    = SUM((C,A),  PQ.L(C)*QINT.L(C,A));
2082   b_MACROSAM('FAC2','ACT2')    = SUM((F,A),  WF.L(F)*WFDIST.L(F,A)*QF.L(F,A));
2083   b_MACROSAM('ACTTAX2','ACT2') = SUM(A,      TA.L(A)*PA.L(A)*QA.L(A));
2084   b_MACROSAM('VATAX2','ACT2')  = SUM(A,      TV.L(A)*PVA.L(A)*QVA.L(A));
2085   
2086  *Commodities.
2087   b_MACROSAM('ACT2','COM2')    = SUM((C,A),  QXAC.L(A,C) * PXAC.L(A,C));
2088   b_MACROSAM('COM2','COM2')    = SUM(C,      PQ.L(C)*QT.L(C));
2089   b_MACROSAM('ROW2','COM2')    = SUM(CM,     pwm(CM)*QM.L(CM))*EXR.L;
2090   b_MACROSAM('COMTAX2','COM2') = SUM(C,      TQ.L(C)*PQ.L(C)*QQ.L(C));
2091   b_MACROSAM('IMPTAX2','COM2') = SUM(CM,     TM.L(CM)*pwm(CM)*QM.L(CM))*EXR.L;
2092   b_MACROSAM('EXPTAX2','COM2') = SUM(CE,     TE.L(CE)*pwe(CE)*QE.L(CE))*EXR.L;
2093   
2094  *Factors.
2095   b_MACROSAM('ENT2','FAC2')    = SUM((F,EN), YIF.L(EN,F));
2096   b_MACROSAM('HOU2','FAC2')    = SUM((H,F),  YIF.L(H,F));
2097   b_MACROSAM('GOV2','FAC2')    = SUM(F,      YIF.L(GV,F));
2098   b_MACROSAM('FACTAX2','FAC2') = SUM(F,      TF.L(F)*YF.L(F));
2099   b_MACROSAM('ROW2','FAC2')    = SUM(F,      YIF.L(RW,F));
2100   
2101  *Enterprises.
2102   b_MACROSAM('ENT2','ENT2')    = SUM((EN,ENP), TRII.L(EN,ENP));
2103   b_MACROSAM('HOU2','ENT2')    = SUM((H,EN), TRII.L(H,EN));
2104   b_MACROSAM('GOV2','ENT2')    = SUM(EN,     TRII.L(GV,EN));
2105   b_MACROSAM('INSTAX2','ENT2') = SUM(EN,     TI.L(EN)*YI.L(EN));
2106   b_MACROSAM('S-I2','ENT2')    = SUM(EN,     MPS.L(EN)*YI.L(EN)*(1-TI.L(EN)));
2107   b_MACROSAM('ROW2','ENT2')    = SUM(EN,     TRII.L(RW,EN));
2108   
2109  *Households.
2110   b_MACROSAM('ACT2','HOU2')    = SUM((A,H),  PA.L(A)*QHA.L(A,H));
2111   b_MACROSAM('COM2','HOU2')    = SUM((C,H),  PQ.L(C)*QH.L(C,H));
2112   b_MACROSAM('ENT2','HOU2')    = SUM((EN,H), TRII.L(EN,H));
2113   b_MACROSAM('HOU2','HOU2')    = SUM((H,HP), TRII.L(H,HP));
2114   b_MACROSAM('GOV2','HOU2')    = SUM(H,      TRII.L(GV,H));
2115   b_MACROSAM('INSTAX2','HOU2') = SUM(H,      TI.L(H)*YI.L(H));
2116   b_MACROSAM('S-I2','HOU2')    = SUM(H,      MPS.L(H)*YI.L(H)*(1-TI.L(H)));
2117   b_MACROSAM('ROW2','HOU2')    = SUM(H,      TRII.L(RW,H));
2118   
2119  *Government.
2120   b_MACROSAM('COM2','GOV2')    = SUM(C,      PQ.L(C)*QG.L(C));
2121   b_MACROSAM('ENT2','GOV2')    = SUM(EN,     trnsi(EN,GV))*CPI.L;
2122   b_MACROSAM('HOU2','GOV2')    = SUM(H,      trnsi(H,GV))*CPI.L;
2123   b_MACROSAM('S-I2','GOV2')    =             GSAV.L;
2124   b_MACROSAM('ROW2','GOV2')    =             trnsi(RW,GV)*EXR.L;
2125   b_MACROSAM('GOV2',ACMACTAX)  = SUM(ACMAC,  b_MACROSAM(ACMACTAX,ACMAC));
2126   
2127  *Savings-investment.
2128   b_MACROSAM('COM2','S-I2')    = SUM(C,      PQ.L(C)*QINV.L(C)) + SUM(C, PQ.L(C)*qdst(C));
2129   
2130  *Rest of world.
2131   b_MACROSAM('COM2','ROW2')    = SUM(CE,     pwe(CE)*QE.L(CE))*EXR.L;
2132   b_MACROSAM('FAC2','ROW2')    = SUM(F,      trnsf(F,RW))*EXR.L;
2133   b_MACROSAM('ENT2','ROW2')    = SUM(EN,     trnsi(EN,RW))*EXR.L;
2134   b_MACROSAM('HOU2','ROW2')    = SUM(H,      trnsi(H,RW))*EXR.L;
2135   b_MACROSAM('GOV2','ROW2')    =             trnsi(GV,RW)*EXR.L;
2136   b_MACROSAM('S-I2','ROW2')    =             FSAV.L*EXR.L;
2137   
2138  *Account totals.
2139   b_MACROSAM('TOTAL2',ACMAC)   = 0;
2140   b_MACROSAM(ACMAC,'TOTAL2')   = 0;
2141   
2142   b_MACROSAM('TOTAL2', ACMACNTP) = SUM(ACMACNT,  b_MACROSAM(ACMACNT,ACMACNTP));
2143   b_MACROSAM(ACMACNT,'TOTAL2')   = SUM(ACMACNTP, b_MACROSAM(ACMACNT,ACMACNTP));
2144   
2145  *Checking account balances.
2146   b_BALCHK2(ACMACNT) = b_MACROSAM('TOTAL2',ACMACNT) - b_MACROSAM(ACMACNT,'TOTAL2');
2147   b_BALCHK2(ACMACNT)$(ABS(b_BALCHK2(ACMACNT)) LT 1E-6) = 0;
2148   
2149   
2150  *------------------------------------------------------------------
2151  * 1.7.5  Input shares, factor wages, and elasticities (FACTAB1-4)
2152  *------------------------------------------------------------------
2153   
2154  SETS
2155   FFAC(AC)           all factor accounts and total
2156   AACT(AC)           all activity accounts and total
2157  ;
2158   
2159   FFAC(F)       = YES;
2160   FFAC('TOTAL') = YES;
2161   AACT(A)       = YES;
2162   AACT('TOTAL') = YES;
2163   
2164  PARAMETERS
2165   b_FACTAB1(AC,ACP)    factor shares within sector
2166   b_FACTAB2(AC,ACP)    factor shares across sectors
2167   b_FACTAB3(AC,*)      aggregate factor and intermediate input shares and their substitution elasticity
2168   b_FACTAB4(AC,ACP)    factor wages by sector
2169  ;
2170   
2171   b_FACTAB1(A,F)                 = WF.L(F)*WFDIST.L(F,A)*QF.L(F,A);
2172   b_FACTAB1('TOTAL',F)           = SUM(A, b_FACTAB1(A,F));
2173   b_FACTAB1(A,'TOTAL')           = SUM(F, b_FACTAB1(A,F));
2174   b_FACTAB1('TOTAL','TOTAL')     = SUM(F, b_FACTAB1('TOTAL',F));
2175   b_FACTAB2(AACT,FFAC)           = b_FACTAB1(AACT,FFAC);
2176   b_FACTAB1(AACT,FFAC)$b_FACTAB1(AACT,'TOTAL') = b_FACTAB1(AACT,FFAC)/b_FACTAB1(AACT,'TOTAL')*100;
2177   b_FACTAB2(AACT,FFAC)$b_FACTAB2('TOTAL',FFAC) = b_FACTAB2(AACT,FFAC)/b_FACTAB2('TOTAL',FFAC)*100;
2178   
2179   b_FACTAB3(A,'QVASHR')$QA.L(A)  = PVA.L(A)*QVA.L(A)/(PA.L(A)*(1-TA.L(A))*QA.L(A))*100;
2180   b_FACTAB3(A,'QINTSHR')$QA.L(A) = PINTA.L(A)*QINTA.L(A)/(PA.L(A)*(1-TA.L(A))*QA.L(A))*100;
2181   b_FACTAB3('TOTAL','QVASHR')    = SUM(A, PVA.L(A)*QVA.L(A))/SUM(A, PA.L(A)*(1-TA.L(A))*QA.L(A))*100;
2182   b_FACTAB3('TOTAL','QINTSHR')   = SUM(A, PINTA.L(A)*QINTA.L(A))/SUM(A, PA.L(A)*(1-TA.L(A))*QA.L(A))*100;
2183   b_FACTAB3(A,'ACES')$QA.L(A)    = ACES(A);
2184   b_FACTAB3(A,'SIGMAQA')$QA.L(A) = AELAS(A,'ELASPRD2');
2185   b_FACTAB3(A,'SIGMAVA')$QA.L(A) = AELAS(A,'ELASPRD');
2186   
2187   b_FACTAB4(AACT,FFAC)           = b_FACTAB1(AACT,FFAC);
2188   b_FACTAB4(AACT,'TOTAL')        = 0;
2189   b_FACTAB4(A,F)$QF.L(F,A)       = b_FACTAB4(A,F)/QF.L(F,A);
2190   b_FACTAB4('TOTAL',F)$SUM(A, QF.L(F,A)) = b_FACTAB4('TOTAL',F)/SUM(A, QF.L(F,A));
2191   
2192   
2193  *------------------------------------------------------------------
2194  * 1.7.6  Household incomes (HHDTAB1-2)
2195  *------------------------------------------------------------------
2196   
2197  PARAMETERS
2198   b_HHDTAB1(AC,ACP)    share of item ACP in the total income of household H (%)
2199   b_HHDTAB2(AC,ACP)    share of household AC in total household income from item ACP (%)
2200  ;
2201   
2202   b_HHDTAB1(H,ACNT)$SUM(ACNTP, SAM(H,ACNTP))           = SAM(H,ACNT)/SUM(ACNTP, SAM(H,ACNTP))*100;
2203   b_HHDTAB1('TOTAL',ACNT)$SUM((H,ACNTP), SAM(H,ACNTP)) = SUM(H, SAM(H,ACNT))/SUM((H,ACNTP), SAM(H,ACNTP))*100;
2204   b_HHDTAB1(AC,'TOTAL')                                = SUM(ACNT, b_HHDTAB1(AC,ACNT));
2205   
2206   b_HHDTAB2(H,ACNT)$SUM(HP, SAM(HP,ACNT))              = SAM(H,ACNT)/SUM(HP, SAM(HP,ACNT))*100;
2207   b_HHDTAB2(H,'TOTAL')$SUM((HP,ACNT), SAM(HP,ACNT))    = SUM(ACNT, SAM(H,ACNT))/SUM((HP,ACNT), SAM(HP,ACNT))*100;
2208   b_HHDTAB2('TOTAL',AC)                                = SUM(H, b_HHDTAB2(H,AC));
