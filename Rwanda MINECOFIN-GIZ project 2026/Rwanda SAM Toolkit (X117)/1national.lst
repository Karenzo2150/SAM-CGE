C o m p i l a t i o n


   1  *NEXUS 58 sector SAM Building Toolkit
   2  *Step 1: National SAM with aggregate household and labor account
   3   
   6   
   7  *$call "xlstalk -s %national%.xlsx"
GDXIN   C:\Users\EARAGIE\IFPRI Dropbox\Emerta Aragie\Rwanda MINECOFIN-GIZ project 2026\Rwanda SAM Toolkit (X117)\1RWA_X1
        04_2017.gdx
  10   
  11  SET
  12  *SAM sets
  13   AC              micro SAM accounts
  14   ACNT(AC)        micro SAM accounts without total
  15   A(AC)           activities
  16   C(AC)           commodities
  17   F(AC)           factors
  18   T(AC)           taxes
  19  *Data sets
  20   MAC             macro SAM accounts
  21   MACNT(MAC)      macro SAM accounts without total
  22   SAC             supply use table accounts
  23  *Mappings
  24   MAPAC(A,C)      activity to commodity
  25   MAPMAC(MAC,AC)  macro to micro
  26  ;
  27   
--- LOAD  MAC = 1:mac
--- LOAD  SAC = 2:sac
--- LOAD  AC = 3:ac
--- LOAD  A = 4:a
--- LOAD  C = 5:c
--- LOAD  F = 6:f
--- LOAD  T = 7:t
--- LOAD  MAPAC = 8:mapac
--- LOAD  MAPMAC = 9:mapmac
  30   
  31   ACNT(AC) = YES;
  32   ACNT('TOTAL') = NO;
  33   
  34   MACNT(MAC) = YES;
  35   MACNT('MTOT') = NO;
  36   
  37  ALIAS (MAC,MACP), (MACNT,MACNTP), (AC,ACP), (ACNT,ACNTP), (A,AP), (C,CP), (F,FP), (T,TP);
  38   
  39  PARAMETER
  40   SCALE           scaling multiplier      / 1.000 /
  41   SAM(AC,ACP)     micro SAM
  42  *Data parameters
  43   MSAM(MAC,MACP)  macro SAM
  44   SUT(C,SAC)      supply-use table
  45   USE(AC,A)       use table
  46   SUPPLY(A,C)     supply table
  47  *Checking balances
  48   MSAMX(MAC,MACP) reconstructed macro SAM
  49   DIFF(AC)        micro SAM row and column differences
  50   MDIFF(MAC,MACP) differences between original and reconstructed macro SAMs
  51   
  52  ;
  53   
--- LOAD  MSAM = 10:msam
--- LOAD  SUT = 11:sut
--- LOAD  USE = 12:use
--- LOAD  SUPPLY = 13:supply
  55   
  56  *Activities -----------
  57   
  58  *Production
  59   SAM(ACNT,A) = USE(ACNT,A);
  60  *Activity taxes (producer taxes less subsidies)
  61   SAM('ATAX',A)$SUM(C, SUT(C,'TAX_PRD')) = SUM(C$MAPAC(A,C), SUT(C,'TAX_PRD')/SUM(CP, SUT(CP,'TAX_PRD'))) * MSAM('M
      ATX','MACT');
  62  *Marketed supply
  63   SAM(A,C) = SUPPLY(A,C);
  64   SAM(A,C)$MAPAC(A,C) = SAM(A,C) + SUM(ACNT, SAM(ACNT,A)-SAM(A,ACNT));
  65   
  66   
  67  *Commodities ----------
  68   
  69  *Final demand and imports
  70   SAM(C,'HHD')$SUM(CP, SUT(CP,'CON_PRV')) = SUT(C,'CON_PRV')/SUM(CP, SUT(CP,'CON_PRV')) * MSAM('MCOM','MHHD');
  71   SAM(C,'GOV')$SUM(CP, SUT(CP,'CON_PUB')) = SUT(C,'CON_PUB')/SUM(CP, SUT(CP,'CON_PUB')) * MSAM('MCOM','MGOV');
  72   SAM(C,'S-I')$SUM(CP, SUT(CP,'INV_DEM')) = SUT(C,'INV_DEM')/SUM(CP, SUT(CP,'INV_DEM')) * MSAM('MCOM','MS-I');
  73   SAM(C,'G-I')$SUM(CP, SUT(CP,'INV_GOV')) = SUT(C,'INV_GOV')/SUM(CP, SUT(CP,'INV_GOV')) * MSAM('MCOM','MG-I');
  74   SAM(C,'DSTK')$SUM(CP, SUT(CP,'INV_STK')) = SUT(C,'INV_STK')/SUM(CP, SUT(CP,'INV_STK')) * MSAM('MCOM','MSTK');
  75   SAM(C,'ROW')$SUM(CP, SUT(CP,'TRD_EXP')) = SUT(C,'TRD_EXP')/SUM(CP, SUT(CP,'TRD_EXP')) * MSAM('MCOM','MROW');
  76   SAM('ROW',C)$SUM(CP, SUT(CP,'TRD_IMP')) = SUT(C,'TRD_IMP')/SUM(CP, SUT(CP,'TRD_IMP')) * MSAM('MROW','MCOM');
  77  *Transaction cost margins
  78   SAM('TRC',C) = SUT(C,'TRC_REC');
  79   SAM(C,'TRC') = SUT(C,'TRC_PAY');
  80  *Commodity taxes (product taxes less subsidies)
  81   SAM('CTAX',C)$SUM(CP, SUT(CP,'TAX_IMP'))  = SUT(C,'TAX_IMP')/SUM(CP, SUT(CP,'TAX_IMP'))   * MSAM('MCTX','MCOM');
  82   SAM('ETAX',C)$SUM(CP, SUT(CP,'TAX_EXP'))  = SUT(C,'TAX_EXP')/SUM(CP, SUT(CP,'TAX_EXP'))   * MSAM('METX','MCOM');
  83   SAM('MTAX',C)$SUM(CP, SUT(CP,'TAX_EXM'))  = SUT(C,'TAX_EXM')/SUM(CP, SUT(CP,'TAX_EXM'))   * MSAM('MMTX','MCOM');
  84   SAM('STAX',C)$SUM(CP, SUT(CP,'TAX_SAL'))  = SUT(C,'TAX_SAL')/SUM(CP, SUT(CP,'TAX_SAL'))   * MSAM('MSTX','MCOM');
  85   SAM('VTAX',C)$SUM(CP, SUT(CP,'TAX_VAT'))  = SUT(C,'TAX_VAT')/SUM(CP, SUT(CP,'TAX_VAT'))   * MSAM('MVTX','MCOM');
  86   SAM('XTAX',C)$SUM(CP, SUT(CP,'TAX_EXD'))  = SUT(C,'TAX_EXD')/SUM(CP, SUT(CP,'TAX_EXD'))   * MSAM('MXTX','MCOM');
  87   
  88  *Other accounts -------
  89   
  90   SAM(ACNT,ACNTP)$(NOT A(ACNT) AND NOT A(ACNTP) AND NOT C(ACNT) AND NOT C(ACNTP))
  91           = SUM((MACNT,MACNTP)$(MAPMAC(MACNT,ACNT) AND MAPMAC(MACNTP,ACNTP)), MSAM(MACNT,MACNTP));
  92   
  93  *Check balances -------
  94   
  95   SAM('TOTAL',ACNT) = SUM(ACNTP, SAM(ACNTP,ACNT));
  96   SAM(ACNT,'TOTAL') = SUM(ACNTP, SAM(ACNT,ACNTP));
  97   DIFF(ACNT) = SAM('TOTAL',ACNT) - SAM(ACNT,'TOTAL');
  98   DIFF(ACNT)$(ABS(DIFF(ACNT)) LT 1E-6) = 0;
  99   
 100   MSAMX(MAC,MACP) = SUM((AC,ACP)$(MAPMAC(MAC,AC) AND MAPMAC(MACP,ACP)), SAM(AC,ACP));
 101   MDIFF(MAC,MACP) = MSAMX(MAC,MACP) - MSAM(MAC,MACP);
 102   MDIFF(MAC,MACP)$(ABS(MDIFF(MAC,MACP)) LT 1E-6) = 0;
 103   
 104   OPTION MDIFF:0, DIFF:0;
 105   DISPLAY MDIFF, DIFF;
 106   
 107   
 108  PARAMETER
 109   CHKNEG(AC,ACP)
 110  ;
 111   
 112   CHKNEG(A,C)$(SAM(A,C) LT 0) = 1/0;
 113   CHKNEG(C,A)$(SAM(C,A) LT 0) = 1/0;
 114   CHKNEG(F,A)$(SAM(F,A) LT 0) = 1/0;
 115   CHKNEG(A,'HHD')$(SAM(A,'HHD') LT 0) = 1/0;
 116  * CHKNEG(C,'HHD')$(SAM(C,'HHD') LT 0) = 1/0;
 117   CHKNEG(C,'S-I')$(SAM(C,'S-I') LT 0) = 1/0;
 118   CHKNEG(C,'GOV')$(SAM(C,'GOV') LT 0) = 1/0;
 119   CHKNEG(C,'ROW')$(SAM(C,'ROW') LT 0) = 1/0;
 120  * CHKNEG('ROW',C)$(SAM('ROW',C) LT 0) = 1/0;
 121   CHKNEG('TRC',C)$(SAM('TRC',C) LT 0) = 1/0;
