GAMS 35.1.0  r82a9585 Released Apr 29, 2021 WEX-WEI x86 64bit/MS Windows - 02/03/26 08:59:39 Page 5
Cross Entropy SAM Estimation August 2003
C o m p i l a t i o n


 357   
 358  SETS
 359   ACBAL(AC)        accounts with row-column balance
 360   SMLCELL(AC,ACP)  SAM cells with abs value < cutoff are removed
 361   INEG(AC,ACP)     cells with negative values in data
 362   IZERO(AC,ACP)    cells with zero entry
 363   NONZERO(AC,ACP)  cells with nonzero entry
 364   ICOEFF(AC,ACP)   cell coefficients to be estimated
 365   IVALUE(AC,ACP)   cell values to be estimated
 366   ESTIMATE(AC,ACP) cells to be estimated and not fixed
 367   IFIXC(AC,ACP)    cell coefficient fixed with no error
 368   IFIXV(AC,ACP)    cell value fixed with no error
 369   ACELL(AC,ACP)    additive error for cells
 370   LCELL(AC,ACP)    logarithmic error for cells
 371   ICOL(AC)         columns with non zero elements
 372   ICOL2(AC)        column sums to be constrained with or without error
 373   ICOLNZ(AC)       columns with nonzero sum
 374   IROW(AC)         rows with non zero elements
 375   ACOL(AC)         additive errors for column sum constraints
 376   LCOL(AC)         multiplicative errors for column sum constraints
 377   MACRO            potential macro control totals /
 378           OWN,    MKT,    LAB,    CAP,    LND,    ENT,    GOV,    SAV,    ROW,    DTAX,   S-I
 379   /
 380   MACRO2(MACRO)    macro constraints actually imposed  /
 381           OWN,    MKT,    LAB,    CAP,    LND,    ENT,    GOV,    SAV,    ROW,    DTAX,   S-I
 382   /
 383   MACAGG(AC,ACP,MACRO)    macro aggregator matrix
 384   AMAC(MACRO)             additive error for macro constraints
 385   LMAC(MACRO)             multiplicative error for macro constraints
 386   JWT                     weights for error support set  /1*3 /
 387  *Cells falling into the household income from factors block
 388   FACtorSHR(H,AC)
 389  ;
 390   
 391  SCALAR
 392   cutoff            lower bound on absolute cell values          /0.0000 /
 393   epsilon           epsilon value for cross-entropy minimand     /.00001 /
 394  ;
 395   
 396  *-----------------------------------------------------------------------
 397  *Parameters and variables ----------------------------------------------
 398  *-----------------------------------------------------------------------
 399   
 400  PARAMETER
 401   tsam0(AC,ACP)     initial SAM
 402   sambalchk(ac)     col sums minus row sums
 403   coeff0(AC,ACP)    column coefficients
 404   colsum0(AC)       initial column sum
 405   coltarget(AC)     target column sum
 406   mactotal0(MACRO)  initial macro totals
 407   vbar1(ac,jwt)     Error support set 1 for column constraints
 408   vbar2(macro,jwt)  Error support set 2 for macro constraints
 409   vbar3(ac,acp,jwt) Error support set 3 for cell constraints
 410   vbar4(h,AC,jwt)   Error support set 4 for household factor income shares
 411   wbar1(ac,jwt)     Weights on error support set 1
 412   wbar2(macro,jwt)  Weights on error support set 2
 413   wbar3(ac,acp,jwt) Weights on error support set 3
 414   wbar4(h,AC,jwt)   Weights on error support set 4
 415   sigmay1(ac)       Prior standard error of column sums
 416   sigmay2(macro)    Prior standard error of macro aggregates
 417   sigmay3(ac,acp)   Prior standard error for cell constraints
 418   sigmay4(h,AC)     Prior standard error for factor income constraints
 419   fachhdtarg(h,AC)  Target factor income shares
 420   ;
 421   
 422  VARIABLES
 423   TSAM(AC,ACP)      SAM values
 424   COEFF(AC,ACP)     SAM coefficients
 425   COLSUM(AC)        column sums
 426   ERR1(AC)          Error value on column sums
 427   ERR2(MACRO)       Error value for macro aggregates
 428   ERR3(AC,ACP)      Error value for cell constraint
 429   ERR4(h,AC)        Error value for factor income distribution
 430   W1(AC,jwt)        Error weights
 431   W2(macro,jwt)     Error weights
 432   W3(AC,ACP,jwt)    Error weights
 433   W4(H,AC,jwt)      Error weights
 434   DENTROPY          Entropy difference (objective)
 435  ;
 436   
 437  *-----------------------------------------------------------------------
 438  *Equations -------------------------------------------------------------
 439  *-----------------------------------------------------------------------
 440   
 441  EQUATIONS
 442   SAMFLOW1(ac,acp)  SAM flows with additive errors
 443   SAMFLOW2(ac,acp)  SAM flows with logarithmic errors
 444   SAMCOEFF1(ac,acp) SAM coefficients with additive errors
 445   SAMCOEFF2(ac,acp) SAM coefficients with logarithmic errors
 446   COLSUMEQ1(ac)     column sums with additive errors
 447   COLSUMDEF(ac)     define column sums
 448   COEFFDEF(ac,acp)  define coefficients
 449   SAMEQ(ac)         Row and column sum constraint
 450  *macro constraints
 451   MACROEQ(macro)    macro aggregation constraints
 452   ERROR1EQ(ac)      definition of error term 1
 453   ERROR2EQ(macro)   definition of error term 2
 454   ERROR3EQ(ac,acp)  definition of error term 3
 455   ERROR4EQ(h,AC)    definition of error term 4
 456   SUMW1(ac)         sum of weights 1
 457   SUMW2(macro)      sm of weights 2
 458   SUMW3(ac,acp)     sum of weights 3
 459   SUMW4(h,AC)       sum of weights 4
 460   FACHHDEQ(H,AC)    factor incomes to households
 461   ENTROPY           entropy difference definition
 462  ;
 463   
 464  *Equations  ############
 465   
 466  *SAM value and coefficient constraints
 467   SAMFLOW1(acnt,acntp)$(IVALUE(acnt,acntp) and ACELL(acnt,acntp))..
 468    TSAM(acnt,acntp)  =E= tsam0(acnt,acntp) + ERR3(acnt,acntp) ;
 469   
 470   SAMFLOW2(acnt,acntp)$(IVALUE(acnt,acntp) and LCELL(acnt,acntp))..
 471    TSAM(acnt,acntp)  =E= tsam0(acnt,acntp)*EXP(ERR3(acnt,acntp)) ;
 472   
 473   SAMCOEFF1(acnt,acntp)$(ICOEFF(acnt,acntp) and ACELL(acnt,acntp))..
 474    COEFF(acnt,acntp) =E= coeff0(acnt,acntp) + ERR3(acnt,acntp) ;
 475   
 476   SAMCOEFF2(acnt,acntp)$(ICOEFF(acnt,acntp) and LCELL(acnt,acntp))..
 477    COEFF(acnt,acntp) =E= coeff0(acnt,acntp)*EXP(ERR3(acnt,acntp)) ;
 478   
 479  *Column sum constraints
 480   COLSUMEQ1(acnt)$(ICOL2(acnt) and ACOL(acnt))..
 481    COLSUM(acnt)      =E= coltarget(acnt) + ERR1(acnt) ;
 482   
 483  *Define column sums and coefficients
 484   COLSUMDEF(acnt)$ICOL(acnt)..
 485    COLSUM(acnt)      =E= SUM(acntp$IROW(acntp), TSAM(acntp,acnt)) ;
 486   
 487  *Only compute coefficients for nonzero cells
 488   COEFFDEF(acnt,acntp)$((NOT IFIXV(acnt,acntp)) and ICOL(acntp) and IROW(acnt) and ICOLNZ(acntp))..
 489    COEFF(acnt,acntp) =E= TSAM(acnt,acntp)/COLSUM(acntp);
 490   
 491  *Row and column sum equality constraint
 492   SAMEQ(acnt)$ACBAL(acnt)..
 493    COLSUM(acnt)      =E= SUM(acntp$ICOL(acntp), TSAM(acnt,acntp)) ;
 494   
 495  *Macro constrints
 496   MACROEQ(MACRO2)..
 497    SUM((irow,icol)$MACAGG(irow,icol,macro2),
 498    TSAM(irow,icol)) =E= MACTOTAL0(macro2) + ERR2(macro2) ;
 499   
 500  *Definition of error terms
 501   
 502   ERROR1EQ(acnt)$(ICOL2(acnt) and ACOL(acnt) and sigmay1(acnt))..
 503    ERR1(acnt)   =E= SUM(jwt, W1(acnt,jwt)*vbar1(acnt,jwt)) ;
 504   
 505   SUMW1(acnt)$(ICOL2(acnt) and ACOL(acnt) and sigmay1(acnt))..
 506    SUM(jwt, W1(acnt,jwt)) =E= 1 ;
 507   
 508   ERROR2EQ(macro2)$sigmay2(macro2)..
 509    ERR2(macro2) =E= SUM(jwt, W2(macro2,jwt)*vbar2(macro2,jwt)) ;
 510   
 511   SUMW2(macro2)$sigmay2(macro2)..
 512    SUM(jwt, W2(macro2,jwt)) =E= 1 ;
 513   
 514   ERROR3EQ(acnt,acntp)$((IVALUE(acnt,acntp) or ICOEFF(acnt,acntp))
 515                        and sigmay3(acnt,acntp))..
 516    ERR3(acnt, acntp)  =E= SUM(jwt, W3(acnt,acntp,jwt)*vbar3(acnt,acntp,jwt)) ;
 517   
 518   SUMW3(acnt,acntp)$((IVALUE(acnt,acntp) or ICOEFF(acnt,acntp))
 519                        and sigmay3(acnt,acntp))..
 520    SUM(jwt, W3(acnt,acntp,jwt)) =E= 1 ;
 521   
 522  *Objective function
 523   ENTROPY..
 524    DENTROPY =E= SUM((acnt,jwt)$(ICOL2(acnt) and ACOL(acnt) and sigmay1(acnt)),
 525                      W1(acnt,jwt)
 526                    * (LOG(W1(acnt,jwt) + epsilon)
 527                    - LOG(wbar1(acnt,jwt) + epsilon)))
 528                              +
 529                 SUM((macro2,jwt)$sigmay2(macro2),
 530                      W2(macro2,jwt)
 531                    * (LOG(W2(macro2,jwt) + epsilon)
 532                    - LOG(wbar2(macro2,jwt) + epsilon)))
 533                              +
 534                 SUM((acnt,acntp,jwt)$((IVALUE(acnt,acntp) or ICOEFF(acnt,acntp))
 535                                   and sigmay3(acnt,acntp)),
 536                      W3(acnt,acntp,jwt)
 537                    * (LOG(W3(acnt,acntp,jwt) + epsilon)
 538                    - LOG(wbar3(acnt,acntp,jwt) + epsilon)))
 539                              +
 540                 SUM((H,ACNT,jwt)$FACtorSHR(H,ACNT),
 541                      W4(H,ACNT,jwt)
 542                    * (LOG(W4(H,ACNT,jwt) + epsilon)
 543                    - LOG(wbar4(H,ACNT,jwt) + epsilon)))
 544  ;
 545   
 546   FACHHDEQ(H,ACNT)$FACtorSHR(H,ACNT)..
 547    TSAM(H,ACNT)/SUM(ACNTP$FACtorSHR(H,ACNTP), TSAM(H,ACNTP)) =E= fachhdtarg(h,ACNT) + ERR4(H,ACNT);
 548   
 549   ERROR4EQ(H,ACNT)$FACtorSHR(H,ACNT)..
 550    ERR4(H,ACNT) =E= SUM(jwt, W4(H,ACNT,jwt)*vbar4(H,ACNT,jwt)) ;
 551   
 552   SUMW4(H,ACNT)$FACtorSHR(H,ACNT)..
 553    SUM(jwt, W4(H,ACNT,jwt)) =E= 1 ;
 554   
 555   
 556  *-----------------------------------------------------------------------
 557  *SAM calibration -------------------------------------------------------
 558  *-----------------------------------------------------------------------
 559   
 560   TSAM0(acnt,acntp) = SAM(acnt,acntp);
 561   
 562  *DIAGNOSTICS
 563  *$include diagnostic.inc
 564   
 565  *Define various sets based on initial SAM, tsam0
 566   
 567  *For a SAM, which is square, ACBAL is the entire set.
 568   ACBAL(ACNT) = YES;
 569  *Make only household accounts active
 570   ACBAL(H) = YES;
 571   
 572   TSAM0('TOTAL',ACNTP)  = SUM(ACNT,  TSAM0(ACNT,ACNTP));
 573   TSAM0(ACNT,"TOTAL")   = SUM(ACNTP, TSAM0(ACNT,ACNTP));
 574   SAMBALCHK(ACNT)$ACBAL(ACNT) = TSAM0('TOTAL',ACNT) - TSAM0(ACNT,'TOTAL');
 575   
 576  DISPLAY "TSAM0 before balancing", TSAM0, SAMBALCHK;
 577   
 578  *Define column sums that can be constrained.
 579  *Might want to exclude columns with only one entry. Or, alternatively,
 580  *leave them in and define entry constraint in terms of coefficients.
 581  *Can exclude any other columns for which column constraints do not
 582  *make a lot of sense.
 583  *Balance accounts which sum to zero by definition should probably be
 584  *constrained exactly, with no error. Can be done by simply setting their
 585  *prior standard error, sigmay1, to zero, which will happen automatically if
 586  *the target column sum is zero. See section on defining sigmay1.
 587   
 588  PARAMETER
 589   COUNTCOL(AC)  number of nonzero cells in columns
 590   COUNTROW(AC)  number of nonzero cells in rows
 591  ;
 592   
 593  LOOP (ACNTP,
 594   COUNTCOL(ACNTP) = 0 ;
 595   COUNTROW(ACNTP) = 0 ;
 596   LOOP (ACNT,
 597     COUNTCOL(ACNTP)$TSAM0(ACNT,ACNTP) = COUNTCOL(ACNTP) + 1 ;
 598     COUNTROW(ACNTP)$TSAM0(ACNTP,ACNT) = COUNTROW(ACNTP) + 1 ;
 599   );
 600  );
 601   
 602  *Define column and row sets for all accounts with any nonzero elements in the
 603  *corresponding row and column. A pure balancing SAM account might have a row or
 604  *column with all zeros. It is harmless to exclude such accounts from the
 605  *balancing procedure, but they must be part of ACBAL.
 606   ICOL(ACNT)$(COUNTCOL(ACNT) OR ACBAL(ACNT)) = YES;
 607   IROW(ACNT)$(COUNTROW(ACNT) OR ACBAL(ACNT)) = YES;
 608   
 609  *Define columns and rows with nonzero sums and compute column coefficients.
 610  *Nonzero here is defined as significant absolute value so that column
 611  *coefficients can be computed safely.
 612   ICOLNZ(ACNT)$(ABS(TSAM0('TOTAL',ACNT) GT 0.00)) = YES;
 613   COEFF0(ACNT,ICOLNZ)      = TSAM0(ACNT,ICOLNZ)/TSAM0('TOTAL',ICOLNZ);
 614   COLSUM0(ACNT)$ICOL(ACNT) = TSAM0('TOTAL',ACNT);
 615   
 616  *Define column accounts that will have constraints. Start by assuming all
 617  *column accounts will be constrained. Those with zero or negative sums cannot
 618  *have column coefficients that are constrained.
 619   ICOL2(ACNT) = ICOL(ACNT);
 620   
 621  *Constrain column sums where there will be lots of coefficients. Otherwise, we
 622  *will only be constraining relative cell values, not values.
 623   ICOL2(A) = NO;
 624   ICOL2(C) = NO;
 625   
 626  *Assume all col sum errors are additive. Multiplicative column sum errors
 627  *are not yet programmed.
 628   LCOL(ICOL2) = NO;
 629   ACOL(ICOL2) = YES;
 630   
 631  *Find negative cell entries
 632   IZERO(ACNT,ACNTP)$(TSAM0(ACNT,ACNTP) EQ 0)   = YES;
 633   NONZERO(ACNT,ACNTP)$(NOT IZERO(ACNT,ACNTP))  = YES;
 634   INEG(ACNT,ACNTP)$((TSAM0(ACNT,ACNTP) LT 0) AND NONZERO(ACNT,ACNTP)) = YES;
 635   
 636  *Specify nature of cell error, whether on coefficients or on values,
 637  *and whether additive or multiplicative.
 638  *Negative cells are specified as values with additive errors.
 639  *All positive cells are initially specified with multiplicative errors
 640  *on values. This ensures that positive cells will not change sign.
 641  *Then various cells are chosen to be specified as coefficients.
 642  *All coefficient cells are specified with multiplicative errors.
 643   
 644   IVALUE(ACNT,ACNTP)$(NONZERO(ACNT,ACNTP)) = YES;
 645   
 646  *Now set cells which are naturally seen as coefficients. Do not specify as
 647  *coefficient if cell does not have a positive coefficient value, coeff0.
 648   
 649  *Set any negative cells to values
 650   IVALUE(ACNT,ACNTP)$INEG(ACNT,ACNTP) = YES;
 651   
 652  *Set cells in columns with only one cell to value
 653   IVALUE(IROW,ICOL)$((COUNTCOL(ICOL) EQ 1) AND NONZERO(IROW,ICOL)) = YES;
 654   
 655  *Set any cells in columns with negative or zero sum to values. Such cells
 656  *should not have a positive coeff0, but this is an extra check.
 657   IVALUE(ACNT,ACNTP)$(ICOL(ACNTP) AND (COLSUM0(ACNTP) LT 0)
 658                   AND ICOLNZ(ACNTP)) = YES;
 659   
 660  *Set all non-household cells to fixed
 661   IVALUE(ACNT,ACNTP)$((NOT H(ACNT)) AND (NOT H(ACNTP))) = NO;
 662  *Set household expenditures to coefficients
 663   IVALUE(ACNT,H)$(COEFF0(ACNT,H) GT 0) = NO ;
 664   
 665  *If cell error is not on values, then it will be on coefficients.
 666   ICOEFF(ACNT,ACNTP)$((NOT IZERO(ACNT,ACNTP))
 667                   AND (NOT IVALUE(ACNT,ACNTP))) = YES;
 668   
 669   ICOEFF(ACNT,ACNTP)$((NOT H(ACNT)) AND (NOT H(ACNTP))) = NO;
 670   
 671   ESTIMATE(ACNT,ACNTP)$(IVALUE(ACNT,ACNTP) or ICOEFF(ACNT,ACNTP)) = YES;
 672   
 673  *Start by assuming that all cells have additive errors.
 674   ACELL(ACNT,ACNTP)$ESTIMATE(ACNT,ACNTP) = YES;
 675   
 676  *Turn off ACELL for cells that have multiplicative errors
 677   ACELL(ACNT,ACNTP)$ICOEFF(ACNT,ACNTP) = NO;
 678  *Make sure that ACELL is on for negative cells
 679   ACELL(ACNT,ACNTP)$INEG(ACNT,ACNTP) = YES;
 680   
 681   LCELL(ACNT,ACNTP)$(NOT ACELL(ACNT,ACNTP)) = YES;
 682   
 683   IFIXV(ACNT,ACNTP)$((not IVALUE(ACNT,ACNTP)) and
 684                      (not ICOEFF(ACNT,ACNTP))) = YES;
 685   
 686  *Check for errors. Cells cannot be constrained in both values and coefficients.
 687  *All cells to be estimated must have lcell or acell.
 688  SET
 689   ICHECK(ac,acp)  Error check for cell constraints
 690  ;
 691   
 692   ICHECK(ACNT,ACNTP)$(IVALUE(ACNT,ACNTP) AND ICOEFF(ACNT,ACNTP)) = YES;
 693  DISPLAY 'Error check. Cells with both ivalue and icoeff', ICHECK ;
 694   
 695   ICHECK(ACNT,ACNTP)$(ESTIMATE(ACNT,ACNTP) AND ((NOT ACELL(ACNT,ACNTP)) AND
 696                                                  NOT LCELL(ACNT,ACNTP))) = YES;
 697  DISPLAY 'Error check. Cells to be estimated but neither acell nor lcell', ICHECK ;
 698   
 699   ICHECK(IROW,ICOL)$(ESTIMATE(IROW,ICOL) and IZERO(IROW,ICOL)) = YES;
 700  DISPLAY 'Error check. Cells to be estimated but initially zero', ICHECK ;
 701   
 702  DISPLAY
 703   COUNTROW, IROW, COUNTCOL, ICOL, ICOL2, LCOL, IZERO, NONZERO, INEG
 704   IVALUE, ICOEFF, ACELL, LCELL
 705  ;
 706   
 707  *-----------------------------------------------------------------------
 708  *Macro aggregates and other country-specific constraints ---------------
 709  *-----------------------------------------------------------------------
 710   
 711  *Define macro aggregates for household control totals
 712   MACAGG(A,H,'OWN')       = YES;
 713   MACAGG(C,H,'MKT')       = YES;
 714   MACAGG(H,FLAB,'LAB')    = YES;
 715   MACAGG(H,FCAP,'CAP')    = YES;
 716   MACAGG(H,FLND,'LND')    = YES;
 717   MACAGG(H,'ENT','ENT')   = YES;
 718   MACAGG(H,'GOV','GOV')   = YES;
 719   MACAGG(H,'ROW','ROW')   = YES;
 720   MACAGG('S-I',H,'GOV')   = YES;
 721   MACAGG('DTAX',H,'DTAX') = YES;
 722   
 723  *The included constraints ensure that column totals for the household
 724  *entries are fixed so that the balanced household block will fit cleanly
 725  *into the pre-balanced aggregate household SAM from 2balance.gms
 726  *$include 4macrocontrols.inc
 727   
 728  *Initialize values from TSAM0
 729   MACTOTAL0(MACRO) = SUM((IROW,ICOL)$MACAGG(IROW,ICOL,MACRO), TSAM0(IROW,ICOL));
 730   
 731  DISPLAY MACTOTAL0;
 732   
 733  PARAMETER
 734   TOTINC(H)       total household income
 735  ;
 736   
 737   TOTINC(H) = SUM(FP, TSAM0(H,FP)) + TSAM0(H,'ENT') + SUM(HPP, TSAM0(H,HPP)) + TSAM0(H,'ROW');
 738   
 739   FACHHDTARG(H,F)$TOTINC(H)     = TSAM0(H,F)/TOTINC(H);
 740   FACHHDTARG(H,'ENT')$TOTINC(H) = TSAM0(H,'ENT')/TOTINC(H);
 741   FACHHDTARG(H,HP)$TOTINC(H)    = TSAM0(H,HP)/TOTINC(H);
 742   FACHHDTARG(H,'ROW')$TOTINC(H) = TSAM0(H,'ROW')/TOTINC(H);
 743   
 744   FACtorSHR(H,ACNT)$FACHHDTARG(H,ACNT) = YES;
 745   
 746  DISPLAY FACtorSHR, FACHHDTARG;
 747   
 748  *-----------------------------------------------------------------------
 749  *Error bounds and support sets -----------------------------------------
 750  *-----------------------------------------------------------------------
 751   
 752  *Set sigmay1 and target column sums
 753   
 754  * JT: target consumption spending since measured more accurately in most cases
 755    COLTARGET(ACBAL) = 1.0*COLSUM0(ACBAL) + 0.0*SUM(ICOL, TSAM0(ACBAL,ICOL));
 756    COLTARGET(ACNT)$(ICOL(ACNT) AND (NOT ACBAL(ACNT))) = COLSUM0(ACNT);
 757   
 758  *Set sigmay1, standard errors for errors on column totals
 759    sigmay1(acnt)$(ICOL2(ACNT) AND ACOL(ACNT)) = 0.00001 * ABS(coltarget(ACNT));
 760    sigmay1(H)$(ICOL2(H) AND ACOL(H))          = 0.1 * ABS(coltarget(H));
 761   
 762  *Set sigmay2, standard errors for errors on macro aggregates
 763    sigmay2(macro2) = 0.01*ABS(mactotal0(macro2));
 764   
 765  *Set sigmay3, standard errors for errors on cell values
 766    sigmay3(ACNT,ACNTP)$(IVALUE(ACNT,ACNTP) AND ACELL(ACNT,ACNTP)) = 0.33 * ABS(tsam0(ACNT, ACNTP));
 767    sigmay3(ACNT,ACNTP)$(IVALUE(ACNT,ACNTP) AND LCELL(ACNT,ACNTP)) = 0.33;
 768   
 769    sigmay3(ACNT,ACNTP)$(ICOEFF(ACNT,ACNTP) AND ACELL(ACNT,ACNTP)) = 0.33 * ABS(coeff0(ACNT, ACNTP));
 770    sigmay3(ACNT,ACNTP)$(ICOEFF(ACNT,ACNTP) AND LCELL(ACNT,ACNTP)) = 0.33;
 771   
 772    sigmay3(ACNT,H)$(ICOEFF(ACNT,H) AND LCELL(ACNT,H)) = 0.5;
 773    sigmay3(H,ACNT)$(ICOEFF(H,ACNT) AND LCELL(H,ACNT)) = 0.5;
 774   
 775    sigmay4(H,ACNT)$FACtorSHR(H,ACNT)
 776      = 0.10 * ABS(TSAM0(H,ACNT)/SUM(ACNTP$FACtorSHR(H,ACNTP), TSAM0(H,ACNTP)));
 777   
      *Set sigmay3 to a large number if there are very few cells in a column and
      *you do not have a strong prior on the column total.
      *In this case, we assume that the row element constraints will be binding
        sigmay3(acnt,acntp)$(ICOEFF(acnt,acntp) and ACELL(acnt,acntp)
                                                and (count(acntp) eq 1))
          = 0.75*coeff0(acnt, acntp)   ;
        sigmay3(acnt,acntp)$(ICOEFF(acnt,acntp) and LCELL(acnt,acntp)
                                                and (count(acntp) eq 1))
          = 0.75   ;
      *SR ### This can also be handled by specifying such cells as coeff and
      * do not constrain the column sum.
       
 792   
 793  * This code assumes a prior mean of zero and a two-parameter
 794  * distribution with specified prior standard error. There are three
 795  * weights, W(acnt,jwt), to be estimated. The actual moments are estimated
 796  * as part of the estimation procedure.
 797  *$ontext
 798  * Set constants for 3-weight error distribution
 799    vbar1(ACNT,'1') = -3 * sigmay1(ACNT);
 800    vbar1(ACNT,'2') =  0;
 801    vbar1(ACNT,'3') = +3 * sigmay1(ACNT);
 802   
 803    wbar1(ACNT,'1') =  1/18;
 804    wbar1(ACNT,'2') = 16/18;
 805    wbar1(ACNT,'3') =  1/18;
 806   
 807  *$offtext
 808   
 809  * This code assumes a prior mean of zero and a prior value of kurtosis
 810  * consistent with a prior normal distribution with mean zero, variance
 811  * sigmay**2, and kurtosis equal to 3*sigmay**4. The addition of a prior
 812  * on kurtosis requires estimation of 5 weights (jwt = 5);
 813  * The prior weights wbar are specified so that:
 814  * SUM(jwt, wbar(acnt,jwt)*vbar(acnt,jwt)**4) = 3*sigmay(acnt,jwt)**4
 815  * as well as defining the variance as above.
 816  * The prior weights and support set are also symmetric, so the prior
 817  * on all odd moments is zero. The choice of +/- 1 standard error
 818  * for vbar(acnt,"2") and vbar(acnt,"4") is arbitrary.
 819  * The actual moments are estimated as part of the estimation procedure.
 820   
      * Set constants for 5-weight error distribution
        vbar1(ACNT,'1')  = -3 * sigmay1(ACNT);
        vbar1(ACNT,'2')  = -1 * sigmay1(ACNT);
        vbar1(ACNT,'3')  =  0;
        vbar1(ACNT,'4')  = +1 * sigmay1(ACNT);
        vbar1(ACNT,'5')  = +3 * sigmay1(ACNT);
       
        wbar1(ACNT,'1')  =   1/72;
        wbar1(ACNT,'2')  =  27/72;
        wbar1(ACNT,'3')  =  16/72;
        wbar1(ACNT,'4')  =  27/72;
        wbar1(ACNT,'5')  =   1/72;
 835   
 836  *$ontext
 837  * Set constants for 3-weight error distribution
 838    vbar2(MACRO,'1')  = -3 * sigmay2(MACRO);
 839    vbar2(MACRO,'2')  =  0;
 840    vbar2(MACRO,'3')  = +3 * sigmay2(MACRO);
 841   
 842    wbar2(MACRO,'1')  =  1/18;
 843    wbar2(MACRO,'2')  = 16/18;
 844    wbar2(MACRO,'3')  =  1/18;
 845  *$offtext
 846   
      * Set constants for 5-weight error distribution
        vbar2(macro,"1")  = -3 * sigmay2(macro) ;
        vbar2(macro,"2")  = -1 * sigmay2(macro) ;
        vbar2(macro,"3")  =  0                  ;
        vbar2(macro,"4")  = +1 * sigmay2(macro) ;
        vbar2(macro,"5")  = +3 * sigmay2(macro) ;
       
        wbar2(macro,"1")  =   1/72;
        wbar2(macro,"2")  =  27/72;
        wbar2(macro,"3")  =  16/72;
        wbar2(macro,"4")  =  27/72;
        wbar2(macro,"5")  =   1/72;
 861   
 862  *$ontext
 863  * Set constants for 3-weight error distribution
 864    vbar3(ACNT,ACNTP,'1')  = -3 * sigmay3(ACNT,ACNTP);
 865    vbar3(ACNT,ACNTP,'2')  =  0;
 866    vbar3(ACNT,ACNTP,'3')  = +3 * sigmay3(ACNT,ACNTP);
 867   
 868    wbar3(ACNT,ACNTP,'1')  =  1/18;
 869    wbar3(ACNT,ACNTP,'2')  = 16/18;
 870    wbar3(ACNT,ACNTP,'3')  =  1/18;
 871  *$offtext
 872   
      * Set constants for 5-weight error distribution
        vbar3(ACNT,ACNTP,'1')  = -3 * sigmay3(ACNT,ACNTP);
        vbar3(ACNT,ACNTP,'2')  = -1 * sigmay3(ACNT,ACNTP);
        vbar3(ACNT,ACNTP,'3')  =  0;
        vbar3(ACNT,ACNTP,'4')  = +1 * sigmay3(ACNT,ACNTP);
        vbar3(ACNT,ACNTP,'5')  = +3 * sigmay3(ACNT,ACNTP);
       
        wbar3(ACNT,ACNTP,'1')  =   1/72;
        wbar3(ACNT,ACNTP,'2')  =  27/72;
        wbar3(ACNT,ACNTP,'3')  =  16/72;
        wbar3(ACNT,ACNTP,'4')  =  27/72;
        wbar3(ACNT,ACNTP,'5')  =   1/72;
 887   
 888  *$ontext
 889    vbar4(H,ACNT,'1') = -3 * sigmay4(H,ACNT);
 890    vbar4(H,ACNT,'2') =  0;
 891    vbar4(H,ACNT,'3') = +3 * sigmay4(H,ACNT);
 892   
 893    wbar4(H,ACNT,'1') =  1/18;
 894    wbar4(H,ACNT,'2') = 16/18;
 895    wbar4(H,ACNT,'3') =  1/18;
 896  *$offtext
 897   
      *Error distribution set for factor income shares
      * Set constants for 5-weight error distribution
        vbar4(H,ACNT,'1')  = -3 * sigmay4(H,ACNT) ;
        vbar4(H,ACNT,'2')  = -1 * sigmay4(H,ACNT) ;
        vbar4(H,ACNT,'3')  =  0              ;
        vbar4(H,ACNT,'4')  = +1 * sigmay4(H,ACNT) ;
        vbar4(H,ACNT,'5')  = +3 * sigmay4(H,ACNT) ;
       
        wbar4(H,ACNT,'1')  =   1/72;
        wbar4(H,ACNT,'2')  =  27/72;
        wbar4(H,ACNT,'3')  =  16/72;
        wbar4(H,ACNT,'4')  =  27/72;
        wbar4(H,ACNT,'5')  =   1/72;
 913   
 914  DISPLAY
 915   sigmay1, sigmay2, sigmay3, sigmay4
 916   vbar1, vbar2, vbar3, vbar4
 917  ;
 918   
 919  *-----------------------------------------------------------------------
 920  *Define model ----------------------------------------------------------
 921  *-----------------------------------------------------------------------
 922   
 923  MODEL SAMENTROP  /
 924   SAMFLOW1
 925   SAMFLOW2
 926   SAMCOEFF1
 927   SAMCOEFF2
 928   COLSUMEQ1
 929   COLSUMDEF
 930   COEFFDEF
 931   SAMEQ
 932   MACROEQ
 933   ERROR1EQ
 934   ERROR2EQ
 935   ERROR3EQ
 936   ERROR4EQ
 937   SUMW1
 938   SUMW2
 939   SUMW3
 940   SUMW4
 941   FACHHDEQ
 942   ENTROPY
 943  /;
 944   
 945  *-----------------------------------------------------------------------
 946  *Intialize variables ---------------------------------------------------
 947  *-----------------------------------------------------------------------
 948   
 949   TSAM.L(ACNT,ACNTP)       = tsam0(ACNT,ACNTP);
 950   COEFF.L(ACNT,ACNTP)      = coeff0(ACNT,ACNTP);
 951   COLSUM.L(ICOL)           = colsum0(ICOL);
 952   ERR1.L(AC)               = 0;
 953   ERR2.L(MACRO)            = 0;
 954   ERR3.L(AC,ACP)           = 0;
 955   ERR4.L(H,ACNT)           = 0;
 956   W1.L(ACNT,JWT)           = wbar1(ACNT,JWT);
 957   W2.L(MACRO,JWT)          = wbar2(MACRO,JWT);
 958   W3.L(ACNT,ACNTP,jwt)     = wbar3(ACNT,ACNTP,JWT);
 959   W4.L(H,ACNT,JWT)         = wbar4(H,ACNT,JWT);
 960   DENTROPY.L               = 0;
 961   
 962  *-----------------------------------------------------------------------
 963  *Define bounds for cell values -----------------------------------------
 964  *-----------------------------------------------------------------------
 965   
 966  * Defining equation SAMMAKE over non-zero elements of A ($Abar1(acnt,acntp))
 967  * guarantees that the zero structure of the original SAM is maintained
 968  * in the estimated SAM. Fixing all the zero entries to zero greatly
 969  * reduces the size of the estimation problem. If it is desired to
 970  * allow a zero entry to become nonzero in the estimated SAM, then
 971  * the condition $ABAR1(acnt,acntp) must be replaced with a new set that
 972  * does not include cells which are currently zero but may be nonzero.
 973   
 974  * COEFF.LO(ACNT,ACNTP)$ICOEFF(ACNT,ACNTP)        = 0 ;
 975  * COEFF.UP(ACNT,ACNTP)$ICOEFF(ACNT,ACNTP)        = 1 ;
 976  * COEFF.FX(ACNT,ACNTP)$(NOT NONZERO(ACNT,ACNTP)) = 0;
 977   
 978  *Fix coeff to zero if it is not a ivalue
 979   COEFF.FX(ACNT,ACNTP)$IFIXV(ACNT,ACNTP) = COEFF0(ACNT,ACNTP) ;
 980   
 981  * TSAM.LO(ACNT,ACNTP)                    = 0.0 ;
 982  * TSAM.UP(ACNT,ACNTP)                    = +inf ;
 983   TSAM.FX(ACNT,ACNTP)$IFIXV(ACNT,ACNTP)  = TSAM0(ACNT,ACNTP) ;
 984   
 985  * Upper and lower bounds on the error weights
 986   W1.LO(ACNT,JWT)       = 0;
 987   W1.UP(ACNT,JWT)       = 1;
 988   W2.LO(MACRO2,JWT)     = 0;
 989   W2.UP(MACRO2,JWT)     = 1;
 990   W3.LO(ACNT,ACNTP,JWT) = 0;
 991   W3.UP(ACNT,ACNTP,JWT) = 1;
 992   W4.LO(H,ACNT,JWT)     = 0;
 993   W4.UP(H,ACNT,JWT)     = 1;
 994   
 995  *If standard deviation of errors is set to zero, fix the weights to the prior
 996  *so that the error will always be zero.
 997   W1.FX(ACNT,JWT)$(sigmay1(ACNT) EQ 0)             = wbar1(ACNT,JWT) ;
 998   W2.FX(MACRO2,JWT)$(sigmay2(MACRO2) EQ 0)         = wbar2(MACRO2,JWT) ;
 999   W3.FX(ACNT,ACNTP,JWT)$(sigmay3(ACNT,ACNTP) EQ 0) = wbar3(ACNT,ACNTP,JWT) ;
1000   W4.FX(H,ACNT,JWT)$(NOT FACtorSHR(H,ACNT))           = wbar4(H,ACNT,JWT) ;
1001   ERR1.FX(acnt)$(sigmay1(ACNT) EQ 0)               = 0 ;
1002   ERR2.FX(MACRO2)$(sigmay2(MACRO2) EQ 0)           = 0 ;
1003   ERR3.FX(ACNT,ACNTP)$(sigmay3(ACNT,ACNTP) EQ 0)   = 0 ;
1004   ERR4.FX(H,ACNT)$(NOT FACtorSHR(H,ACNT))             = 0 ;
1005   
1006   
1007  *-----------------------------------------------------------------------
1008  *Solve model -----------------------------------------------------------
1009  *-----------------------------------------------------------------------
1010   
1011  OPTION ITERLIM  = 100000;
1012  OPTION LIMROW   = 0, LIMCOL       = 0;
1013  OPTION SOLPRINT = OFF;
1014  OPTION RESLIM   = 100000;
1015   
1016  *OPTION NLP = PATHNLP ;
1017  OPTION NLP = CONOPT3;
1018   
1019   SAMENTROP.HOLDFIXED = 1 ;
1020   
1021  SOLVE SAMENTROP USING NLP MINIMIZING DENTROPY;
1022   
1023  *-----------------------------------------------------------------------
1024  *Reporting -------------------------------------------------------------
1025  *-----------------------------------------------------------------------
1026   
1027  PARAMETERS
1028   SAMCE(AC,ACP)      new balanced SAM flows from CE
1029   SEM                squared Error Measure
1030   VALDIFF(AC,ACP)    differnce btw original SAM and Final SAM in values
1031   PERDIFF(AC,ACP)    differnce btw original SAM and Final SAM in Percent
1032   BIGDIFFP(AC,ACP)   cells with large percent change
1033  ;
1034   
1035   SAMCE(ACNT,ACNTP)        = TSAM.L(ACNT,ACNTP);
1036   SAMCE('TOTAL',acntp)     = SUM(acnt, SAMCE(ACNT,ACNTP));
1037   SAMCE(acnt,'TOTAL')      = SUM(acntp, SAMCE(ACNT,ACNTP));
1038   
1039   SAMBALCHK(ACNT)$ACBAL(ACNT) = SAMCE('TOTAL',ACNT) - SAMCE(ACNT,'TOTAL');
1040   
1041   SEM = SUM((ACNT,ACNTP), SQR(COEFF.L(ACNT,ACNTP) - COEFF0(ACNT,ACNTP)))/SQR(9);
1042   
1043   VALDIFF(AC,ACP) = SAMCE(AC,ACP) - TSAM0(AC,ACP);
1044   PERDIFF(AC,ACP)$TSAM0(AC,ACP) = 100*(SAMCE(AC,ACP)/TSAM0(AC,ACP) - 1 );
1045   BIGDIFFP(AC,ACP)$(ABS(PERDIFF(AC,ACP)) GT 25) = perdiff(AC,ACP);
1046   
1047  DISPLAY
1048   'SAMCE after balancing', SAMCE
1049   'SAMBALCHK after balancing', SAMBALCHK
1050   SEM, SAMCE, VALDIFF, PERDIFF, bigdiffp, DENTROPY.L
1051  ;
1052   
1053  *Household income data (for checking)
1054   INCTAB(H,INCAC) = SAMCE(H,INCAC);
1055   EXPTAB(H,EXPAC) = SAMCE(EXPAC,H);
1056   EXPTAB(H,'AMAIZ') = SUM(A, SAMCE(A,H));
1057   EXPTAB(H,'CMAIZ') = SUM(C, SAMCE(C,H));
1058   EXPTAB(H,'CFOOD') = SUM(FOOD, SAMCE(FOOD,H));
1059   
1060  PARAMETER XLTEST;
1061  execute_unload "0households.gdx" INCTAB EXPTAB HHDDATA
1062  execute 'xlstalk.exe -m 0households.xlsx';
1063   XLTEST = ERRORLEVEL;
1064  IF(XLTEST = 1,
1065  execute 'xlstalk.exe -c 0households.xlsx';
1066  );
1067  IF(XLTEST = 2,
1068  execute 'xlstalk.exe -s 0households.xlsx';
1069  );
1070  execute 'gdxxrw.exe i=0households.gdx o=0households.xlsx index=index!a5' ;
1071  execute 'xlstalk.exe -o 0households.xlsx';
1072  DISPLAY XLTEST;
1073   
1074   SAM(AC,ACP) = SAMCE(AC,ACP)/SCALE;
1075   
1076   
1077  execute_unload "0output.gdx" SAM
1078  execute 'xlstalk.exe -m 0output.xlsx';
1079   XLTEST = ERRORLEVEL;
1080  IF(XLTEST = 1,
1081  execute 'xlstalk.exe -c 0output.xlsx';
1082  );
1083  IF(XLTEST = 2,
1084  execute 'xlstalk.exe -s 0output.xlsx';
1085  );
1086  execute 'gdxxrw.exe i=0output.gdx o=0output.xlsx index=index!a25' ;
1087  *execute 'xlstalk.exe -o %output%.xlsx';
1088  DISPLAY XLTEST;
1089   
1090   
1091   


