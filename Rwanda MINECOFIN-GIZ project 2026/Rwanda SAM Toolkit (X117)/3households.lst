C o m p i l a t i o n


   1  *s=households gdx=households
   2  *NEXUS 58 sector SAM Building Toolkit
   3  *Step 2: National SAM with disaggregated household and labor accounts
   4   
   8   
   9  *$call "xlstalk -s %input%.xlsx"
GDXIN   C:\Users\EARAGIE\IFPRI Dropbox\Emerta Aragie\Rwanda MINECOFIN-GIZ project 2026\Rwanda SAM Toolkit (X117)\3RWA_X1
        04_2017.gdx
  12  *$call "xlstalk -o %input%.xlsx"
  13   
  14  SET
  15   X                income or expenditure /inc,exp/
  16  *SAM sets
  17   AC               micro SAM accounts
  18   ACNT(AC)         micro SAM accounts without total
  19   A(AC)            activities - all
  20   ALIV(A)          activities - livestock
  21   AMIN(A)          activities - mining
  22   C(AC)            commodities
  23   F(AC)            factors - all
  24   FLAB(F)          factors - labor
  25   FLND(F)          factors - land
  26   FCAP(F)          factors - capital
  27   FREM(F)          factors - to be removed
  28   H(AC)            households
  29   T(AC)            taxes
  30   FOOD(AC)         food items (activities and commodities)
  31  *Data sets
  32   MAC              macro SAM accounts
  33   MACNT(MAC)       macro SAM accounts without total
  34   AAC(AC)          national SAM accounts (same aggregation as Step 1)
  35   AACNT(AAC)       national SAM accounts without total
  36  *Mappings
  37   MAPAC(A,C)       mapping macro-micro accounts
  38   MAPMAC(MAC,AC)   mapping activities-commodities
  39   MAPAACAC(AAC,AC) mapping national-all
  40  ;
  41   
--- LOAD  MAC = 1:mac
--- LOAD  AC = 2:ac
--- LOAD  AAC = 3:aac
--- LOAD  A = 4:a
--- LOAD  ALIV = 5:aliv
--- LOAD  AMIN = 6:amin
--- LOAD  C = 7:c
--- LOAD  F = 8:f
--- LOAD  FLAB = 9:flab
--- LOAD  FLND = 10:flnd
--- LOAD  FCAP = 11:fcap
--- LOAD  H = 12:h
--- LOAD  T = 13:t
--- LOAD  FOOD = 14:food
--- LOAD  MAPAC = 16:mapac
--- LOAD  MAPMAC = 15:mapmac
--- LOAD  MAPAACAC = 17:mapaacac
  44   
  45   ACNT(AC) = YES;
  46   ACNT('TOTAL') = NO;
  47   
  48   MACNT(MAC) = YES;
  49   MACNT('MTOT') = NO;
  50   
  51   AACNT(AAC) = YES;
  52   AACNT('TOTAL') = NO;
  53   
  54  ALIAS
  55   (MAC,MACP), (MACNT,MACNTP), (AC,ACP), (ACNT,ACNTP), (AAC,AACP), (AACNT,AACNTP)
  56   (A,AP), (ALIV,ALIVP), (AMIN,AMINP), (C,CP)
  57   (F,FP), (FLAB,FLABP), (FLND,FLNDP), (FCAP,FCAPP)
  58   (H,HP,HPP), (T,TP)
  59  ;
  60   
  61  PARAMETERS
  62   SCALE           scaling multiplier      / 1.000 /
  63  *Data parameters
  64   SAM(AC,ACP)     micro SAM
  65   FACACT(A,F)     factor income generation
  66   MISCFAC(F,X,AC) miscellaneous factor accounts
  67   HHDFAC(H,F)     factor payments to households
  68   OWNSHR(A)       own consumption share of total household consumption
  69   ACTHHD(A,H)     household own consumption
  70   COMHHD(C,H)     household market consumption
  71   MISCHHD(H,X,AC) miscellaneous household accounts
  72   HHDDATA(H,*)    survey household consumption and population data
  73  *Working parameters
  74   MSAM(MAC,MACP)  macro SAM
  75   ASAM(AAC,AACP)  aggregate national SAM
  76   FACSHR(A,F)     factor income shares
  77   ACTSHR(A,H)     own consumption shares
  78   COMSHR(C,H)     marketed consumption shares
  79  ;
  80   
--- LOAD  FACACT = 18:facact
--- LOAD  HHDFAC = 20:hhdfac
--- LOAD  OWNSHR = 21:ownshr
--- LOAD  ACTHHD = 22:acthhd
--- LOAD  COMHHD = 23:comhhd
--- LOAD  MISCFAC = 19:miscfac
--- LOAD  MISCHHD = 24:mischhd
--- LOAD  HHDDATA = 25:hhddata
  83   
  84  *$call "xlstalk -s %output%.xlsx"
GDXIN   C:\Users\EARAGIE\IFPRI Dropbox\Emerta Aragie\Rwanda MINECOFIN-GIZ project 2026\Rwanda SAM Toolkit (X117)\0output
        .gdx
  87   
--- LOAD  SAM = 1:sam
  89   
  90  *Preparation work ------
  91   
  92  *Check ranges in data tables
  93  *  Note: Returns error on negative transfers and savings rates
  94   FACACT(A,F)$(FACACT(A,F) LT 0) = 1/0;
  95   MISCFAC(F,X,AC)$(MISCFAC(F,X,AC) LT 0) = 1/0;
  96   ACTHHD(A,H)$(ACTHHD(A,H) LT 0) = 1/0;
  97   COMHHD(C,H)$(COMHHD(C,H) LT 0) = 1/0;
  98   MISCHHD(H,X,AC)$(MISCHHD(H,X,AC) LT 0) = 1/0;
  99   OWNSHR(A)$(OWNSHR(A) LT 0) = 1/0;
 100   OWNSHR(A)$(OWNSHR(A) GT 1) = 1/0;
 101   
 102  *Separate own and marketed consumption
 103   SAM(A,'HHD') = OWNSHR(A) * SUM(C$MAPAC(A,C), SAM(C,'HHD'));
 104   SAM(C,'HHD') = SAM(C,'HHD') - SUM(A$MAPAC(A,C), SAM(A,'HHD'));
 105   SAM(A,C)$MAPAC(A,C) = SAM(A,C) - SAM(A,'HHD');
 106   
 107  *Separate own and marketed consumption
 108  * SAM(A,'HHD') = OWNSHR(A) * SUM(C$MAPAC(A,C), SAM(C,'HHD'));
 109  * SAM(C,'HHD') = SAM(C,'HHD') - SUM(A$MAPAC(A,C), SAM(A,'HHD'));
 110  * SAM(A,C)$SAM(A,C) = SAM(A,C)/SUM(CP, SAM(A,CP)) * SUM(CP, SAM(A,CP)) - SAM(A,'HHD');
 111   
 112  *Scale SAM
 113   SAM(AC,ACP) = SAM(AC,ACP) * SCALE;
 114  *Calculate national and macro SAM control totals
 115   MSAM(MAC,MACP) = SUM((AC,ACP)$(MAPMAC(MAC,AC) AND MAPMAC(MACP,ACP)), SAM(AC,ACP));
 116   ASAM(AAC,AACP) = SUM((AC,ACP)$(MAPAACAC(AAC,AC) AND MAPAACAC(AACP,ACP)), SAM(AC,ACP));
 117   
 118  *Factors -----------
 119   
 120  SET
 121   FINCAC(AC)      misc factor income accounts      / GOV, ROW /
 122   FEXPAC(AC)      misc factor expenditure accounts / FTAX, GOV, ROW /
 123  ;
 124   
 125  *Calculate factor shares (assign to aggregate if missing)
 126  *  Labor
 127   FACSHR(A,FLAB)$SUM(FLABP, FACACT(A,FLABP)) = FACACT(A,FLAB) / SUM(FLABP, FACACT(A,FLABP));
 128   FACSHR(A,'FLAB')$(NOT SUM(FLABP, ABS(FACACT(A,FLABP)))) = 1.00;
 129  *  Land
 130   FACSHR(A,FLND)$SUM(FLNDP, FACACT(A,FLNDP)) = FACACT(A,FLND) / SUM(FLNDP, FACACT(A,FLNDP));
 131   FACSHR(A,'FLND')$(NOT SUM(FLNDP, ABS(FACACT(A,FLNDP)))) = 1.00;
 132  *  Capital
 133   FACSHR(A,FCAP)$SUM(FCAPP, FACACT(A,FCAPP)) = FACACT(A,FCAP) / SUM(FCAPP, FACACT(A,FCAPP));
 134   FACSHR(A,'FCAP')$(NOT SUM(FCAPP, ABS(FACACT(A,FCAPP)))) = 1.00;
 135   
 136  *Apply factor income shares to SAM
 137   SAM(FLAB,A) = FACSHR(A,FLAB) * SAM('FLAB',A);
 138   SAM(FLND,A) = FACSHR(A,FLND) * SAM('FLND',A);
 139   SAM(FCAP,A) = FACSHR(A,FCAP) * SAM('FCAP',A);
 140   
 141  *Assume aggregate factors without activity incomes are to be removed
 142   FREM('FLAB')$(NOT SUM(A, SAM('FLAB',A))) = YES;
 143   FREM('FLND')$(NOT SUM(A, SAM('FLND',A))) = YES;
 144   FREM('FCAP')$(NOT SUM(A, SAM('FCAP',A))) = YES;
 145   
 146  *Miscellaneous factor incomes
 147  *  If no information, then set default to macro SAM
 148   MISCFAC(FLAB,'INC',FINCAC)$(NOT SUM(FLABP, MISCFAC(FLABP,'INC',FINCAC))) = SUM(MAC$MAPMAC(MAC,FINCAC), MSAM('MLAB
      ',MAC))/MSAM('MLAB','MACT');
 149   MISCFAC(FLND,'INC',FINCAC)$(NOT SUM(FLNDP, MISCFAC(FLNDP,'INC',FINCAC))) = SUM(MAC$MAPMAC(MAC,FINCAC), MSAM('MLND
      ',MAC))/MSAM('MLND','MACT');
 150   MISCFAC(FCAP,'INC',FINCAC)$(NOT SUM(FCAPP, MISCFAC(FCAPP,'INC',FINCAC))) = SUM(MAC$MAPMAC(MAC,FINCAC), MSAM('MCAP
      ',MAC))/MSAM('MCAP','MACT');
 151  *  Rate-based using factor incomes from activities
 152   SAM(F,FINCAC) = MISCFAC(F,'INC',FINCAC) * SUM(A, SAM(F,A));
 153  *  Remove aggregate factors and then scale to match macro SAM totals
 154   SAM(FREM,FINCAC) = 0;
 155   SAM(FLAB,FINCAC)$SUM(FLABP, SAM(FLABP,FINCAC)) = SAM(FLAB,FINCAC) * SUM(MAC$MAPMAC(MAC,FINCAC), MSAM('MLAB',MAC))
       / SUM(FLABP, SAM(FLABP,FINCAC));
 156   SAM(FLND,FINCAC)$SUM(FLNDP, SAM(FLNDP,FINCAC)) = SAM(FLND,FINCAC) * SUM(MAC$MAPMAC(MAC,FINCAC), MSAM('MLND',MAC))
       / SUM(FLNDP, SAM(FLNDP,FINCAC));
 157   SAM(FCAP,FINCAC)$SUM(FCAPP, SAM(FCAPP,FINCAC)) = SAM(FCAP,FINCAC) * SUM(MAC$MAPMAC(MAC,FINCAC), MSAM('MCAP',MAC))
       / SUM(FCAPP, SAM(FCAPP,FINCAC));
 158   
 159  *Miscellaneous factor payments
 160  *  If no information, then set default to macro SAM
 161   MISCFAC(FLAB,'EXP',FEXPAC)$(NOT SUM(FLABP, MISCFAC(FLABP,'EXP',FEXPAC))) = SUM(MAC$MAPMAC(MAC,FEXPAC), MSAM(MAC,'
      MLAB'))/MSAM('MTOT','MLAB');
 162   MISCFAC(FLND,'EXP',FEXPAC)$(NOT SUM(FLNDP, MISCFAC(FLNDP,'EXP',FEXPAC))) = SUM(MAC$MAPMAC(MAC,FEXPAC), MSAM(MAC,'
      MLND'))/MSAM('MTOT','MLND');
 163   MISCFAC(FCAP,'EXP',FEXPAC)$(NOT SUM(FCAPP, MISCFAC(FCAPP,'EXP',FEXPAC))) = SUM(MAC$MAPMAC(MAC,FEXPAC), MSAM(MAC,'
      MCAP'))/MSAM('MTOT','MCAP');
 164  *  Rate-based using total factor incomes
 165   SAM(FEXPAC,F) = MISCFAC(F,'EXP',FEXPAC) * SUM(ACNT, SAM(F,ACNT));
 166  *  Remove aggregate factors and then scale to match macro SAM totals
 167   SAM(FEXPAC,FREM) = 0;
 168   SAM(FEXPAC,FLAB)$SUM(FLABP, SAM(FEXPAC,FLABP)) = SAM(FEXPAC,FLAB) * SUM(MAC$MAPMAC(MAC,FEXPAC), MSAM(MAC,'MLAB'))
       / SUM(FLABP, SAM(FEXPAC,FLABP));
 169   SAM(FEXPAC,FLND)$SUM(FLNDP, SAM(FEXPAC,FLNDP)) = SAM(FEXPAC,FLND) * SUM(MAC$MAPMAC(MAC,FEXPAC), MSAM(MAC,'MLND'))
       / SUM(FLNDP, SAM(FEXPAC,FLNDP));
 170   SAM(FEXPAC,FCAP)$SUM(FCAPP, SAM(FEXPAC,FCAPP)) = SAM(FEXPAC,FCAP) * SUM(MAC$MAPMAC(MAC,FEXPAC), MSAM(MAC,'MCAP'))
       / SUM(FCAPP, SAM(FEXPAC,FCAPP));
 171   
 172  *Net factor payments to households and enterprises
 173   SAM('HHD',F) = 0;
 174   SAM('ENT',F) = 0;
 175   SAM('HHD',FLAB) = SUM(ACNT, SAM(FLAB,ACNT) - SAM(ACNT,FLAB));
 176   SAM('HHD',FLND) = SUM(ACNT, SAM(FLND,ACNT) - SAM(ACNT,FLND));
 177   SAM('ENT',FCAP) = SUM(ACNT, SAM(FCAP,ACNT) - SAM(ACNT,FCAP));
 178  *  Make agricultural crop and livestock capital pay directly to households
 179   SAM('HHD','FCAP-C') = SAM('ENT','FCAP-C');
 180   SAM('HHD','FCAP-L') = SAM('ENT','FCAP-L');
 181   SAM('HHD','ENT') = SAM('HHD','ENT') - SAM('ENT','FCAP-C') - SAM('ENT','FCAP-L');
 182   SAM('ENT','FCAP-C') = 0;
 183   SAM('ENT','FCAP-L') = 0;
 184   
 185  *Households -----------
 186   
 187  SET
 188   HINCAC(AC)      misc household income accounts      / ENT, GOV, ROW /
 189   HEXPAC(AC)      misc household expenditure accounts / DTAX, GOV, S-I, ROW /
 190  ;
 191   
 192  *Household consumption shares
 193  *  Own consumption
 194   ACTSHR(A,H)$SUM(HP, ACTHHD(A,HP)) = ACTHHD(A,H)/SUM(HP, ACTHHD(A,HP));
 195   ACTSHR(A,'HHD')$(NOT SUM(HP, ACTSHR(A,HP)) AND SAM(A,'HHD')) = 1.00;
 196  *  Marketed consumption
 197   COMSHR(C,H)$SUM(HP, COMHHD(C,HP)) = COMHHD(C,H)/SUM(HP, COMHHD(C,HP));
 198   COMSHR(C,'HHD')$(NOT SUM(HP, COMSHR(C,HP)) AND SAM(C,'HHD')) = 1.00;
 199   
 200  *Apply consumption shares to SAM
 201   SAM(A,H) = ACTSHR(A,H) * SAM(A,'HHD');
 202   SAM(C,H) = COMSHR(C,H) * SAM(C,'HHD');
 203   
 204  *Miscellaneous household expenditures
 205  *  If no information, then set default to macro SAM
 206   MISCHHD(H,'EXP',HEXPAC)$(NOT SUM(HP, MISCHHD(HP,'EXP',HEXPAC))) = SUM(MAC$MAPMAC(MAC,HEXPAC), MSAM(MAC,'MHHD'))/M
      SAM('MCOM','MHHD');
 207  *  Rate-based using total consumption spending
 208   SAM(HEXPAC,H) = MISCHHD(H,'EXP',HEXPAC) * (SUM(A, SAM(A,H)) + SUM(C, SAM(C,H)));
 209  *  Scale to match macro SAM totals
 210   SAM(HEXPAC,H)$SUM(HP, SAM(HEXPAC,HP)) = SAM(HEXPAC,H) * SUM(MAC$MAPMAC(MAC,HEXPAC), MSAM(MAC,'MHHD')) / SUM(HP, S
      AM(HEXPAC,HP));
 211   
 212  *Household incomes from factors (share-based)
 213  *  If no information, then set default to macro SAM
 214   HHDFAC('HHD',F)$(NOT SUM(HP, HHDFAC(HP,F))) = 1.00;
 215  *  Rate-based using total factor income payments to aggregate households
 216   SAM(H,F)$SUM(HP, HHDFAC(HP,F)) = HHDFAC(H,F)/SUM(HP, HHDFAC(HP,F)) * SAM('HHD',F);
 217   
 218  *Miscellaneous household incomes
 219  *  If no information, then set default to macro SAM
 220   MISCHHD(H,'INC',HINCAC)$(NOT SUM(HP, MISCHHD(HP,'INC',HINCAC))) = SUM(MAC$MAPMAC(MAC,HINCAC), MSAM('MHHD',MAC))/M
      SAM('MHHD','MTOT');
 221  *  Rate-based using total household spending
 222   SAM(H,HINCAC) = MISCHHD(H,'INC',HINCAC) * SUM(ACNT, SAM(ACNT,H));
 223  *  Scale to match macro SAM totals
 224   SAM(H,HINCAC)$SUM(HP, SAM(HP,HINCAC)) = SAM(H,HINCAC) * SUM(MAC$MAPMAC(MAC,HINCAC), MSAM('MHHD',MAC)) / SUM(HP, S
      AM(HP,HINCAC));
 225   
 226  *Scale down household incomes from enterprises
 227   SAM(H,'ENT') = SAM(H,'ENT') * (MSAM('MHHD','MENT')-SUM((HP,FCAP), SAM(HP,FCAP)))/SUM(HP, SAM(HP,'ENT'));
 228   
 229  *Optional RAS balancing -------
 230  *   RAS household incomes to match expenditures (retain income source pattern)
 231   
 232  SET  COUNT / 1*100 /;
 233  PARAMETER
 234   RAS       / 0 /
 235   HHDINC(AC)
 236  ;
 237  IF(RAS = 1,
 238   LOOP(COUNT,
 239    HHDINC(ACNT) = SUM(H, SAM(H,ACNT));
 240    SAM(H,ACNT)$SUM(ACNTP, SAM(H,ACNTP)) = SAM(H,ACNT) * SUM(ACNTP, SAM(ACNTP,H)) / SUM(ACNTP, SAM(H,ACNTP));
 241    SAM(H,ACNT)$SUM(HP, SAM(HP,ACNT)) = SAM(H,ACNT) * HHDINC(ACNT) / SUM(HP, SAM(HP,ACNT));
 242   );
 243  );
 244   
 245   
 246  *Check balances -------
 247   
 248  PARAMETER
 249   DIFF(AC,*)
 250   MDIFF(MAC,MACP)
 251   ADIFF(AAC,AACP)
 252  ;
 253   
 254  *Check totals for prior micro SAM
 255   SAM(ACNT,'TOTAL') = SUM(ACNTP, SAM(ACNT,ACNTP));
 256   SAM('TOTAL',ACNT) = SUM(ACNTP, SAM(ACNTP,ACNT));
 257   DIFF(ACNT,'DIFF') = SAM(ACNT,'TOTAL')-SAM('TOTAL',ACNT);
 258   DIFF(ACNT,'DIFF')$(ABS(DIFF(ACNT,'DIFF')) LT 1E-6) = 0;
 259   DIFF(ACNT,'PDIFF')$SAM('TOTAL',ACNT) = DIFF(ACNT,'DIFF') / SAM('TOTAL',ACNT) * 100;
 260   
 261  *Differences between original and final macro SAM
 262   MDIFF(MACNT,MACNTP) = SUM((ACNT,ACNTP)$(MAPMAC(MACNT,ACNT) AND MAPMAC(MACNTP,ACNTP)), SAM(ACNT,ACNTP)) - MSAM(MAC
      NT,MACNTP);
 263   MDIFF(MACNT,MACNTP)$(ABS(MDIFF(MACNT,MACNTP)) lt 1E-6) = 0;
 264   
 265  *Differences between original and final micro SAM
 266   ADIFF(AACNT,AACNTP) = SUM((ACNT,ACNTP)$(MAPAACAC(AACNT,ACNT) AND MAPAACAC(AACNTP,ACNTP)), SAM(ACNT,ACNTP)) - ASAM
      (AACNT,AACNTP);
 267   ADIFF(AACNT,AACNTP)$(ABS(ADIFF(AACNT,AACNTP)) lt 1E-6) = 0;
 268   
 269  OPTION ADIFF:2:1:1, MDIFF:2:1:1, DIFF:2:1:1;
 270  DISPLAY
 271   ADIFF, MDIFF
 272   "Income - Expenditure"
 273   DIFF
 274  ;
 275   
 276  SET
 277   INCAC(AC)       permissable household income accounts
 278   EXPAC(AC)       permissable household expenditure accounts
 279  ;
 280   
 281   INCAC(F) = YES;
 282   INCAC('ENT') = YES;
 283   INCAC('GOV') = YES;
 284   INCAC('ROW') = YES;
 285   INCAC('TOTAL') = YES;
 286   
 287   EXPAC('AMAIZ') = YES;
 288   EXPAC('CMAIZ') = YES;
 289   EXPAC('CFOOD') = YES;
 290   EXPAC('GOV') = YES;
 291   EXPAC('DTAX') = YES;
 292   EXPAC('S-I') = YES;
 293   EXPAC('ROW') = YES;
 294   EXPAC('TOTAL') = YES;
 295   
 296  PARAMETER
 297   INCTAB(H,AC)    household income table
 298   EXPTAB(H,AC)    household expennditure table
 299   POPTAB(H,*)
 300  ;
 301   
 302  *Household income data (for checking)
 303   INCTAB(H,INCAC) = SAM(H,INCAC);
 304   EXPTAB(H,EXPAC) = SAM(EXPAC,H);
 305   EXPTAB(H,'AMAIZ') = SUM(A, SAM(A,H));
 306   EXPTAB(H,'CMAIZ') = SUM(C, SAM(C,H));
 307   EXPTAB(H,'CFOOD') = SUM(FOOD, SAM(FOOD,H));
 308   
 309  *$call "xlstalk -s %check%.xlsx"
 310  *execute_unload "%check%.gdx" INCTAB EXPTAB HHDDATA
 311  *execute 'gdxxrw.exe i=%check%.gdx o=%check%.xlsx index=index!a5'
 312  *$call "xlstalk -o %check%.xlsx"
 313   
 314   
 315   
 316  PARAMETER XLTEST;
 317  execute_unload "0households.gdx" INCTAB EXPTAB HHDDATA
 318  execute 'xlstalk.exe -m 0households.xlsx';
 319   XLTEST = ERRORLEVEL;
 320  IF(XLTEST = 1,
 321  execute 'xlstalk.exe -c 0households.xlsx';
 322  );
 323  IF(XLTEST = 2,
 324  execute 'xlstalk.exe -s 0households.xlsx';
 325  );
 326  execute 'gdxxrw.exe i=0households.gdx o=0households.xlsx index=index!a5' ;
 327  execute 'xlstalk.exe -o 0households.xlsx';
 328  DISPLAY XLTEST;
 329   
 330   
 331  *Diagnostics ---
 332   
 333  PARAMETER
 334   CHKNEG(AC,ACP)
 335   
 336  ;
 337   
 338   CHKNEG(A,C)$(SAM(A,C) LT 0) = 1/0;
 339   CHKNEG(C,A)$(SAM(C,A) LT 0) = 1/0;
 340   CHKNEG(F,A)$(SAM(F,A) LT 0) = 1/0;
 341   CHKNEG(A,H)$(SAM(A,H) LT 0) = 1/0;
 342  * CHKNEG(C,H)$(SAM(C,H) LT 0) = 1/0;
 343   CHKNEG(C,'S-I')$(SAM(C,'S-I') LT 0) = 1/0;
 344   CHKNEG(C,'GOV')$(SAM(C,'GOV') LT 0) = 1/0;
 345   CHKNEG(C,'ROW')$(SAM(C,'ROW') LT 0) = 1/0;
 346  * CHKNEG('ROW',C)$(SAM('ROW',C) LT 0) = 1/0;
 347   CHKNEG('TRC',C)$(SAM('TRC',C) LT 0) = 1/0;
 348   
 349  DISPLAY CHKNEG;
 350   
 351   
 352   
