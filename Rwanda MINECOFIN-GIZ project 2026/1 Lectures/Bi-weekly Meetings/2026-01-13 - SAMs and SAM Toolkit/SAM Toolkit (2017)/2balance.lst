 127   
 128  SETS
 129   ACBAL(AC)        accounts with row-column balance
 130  ;
 131   
 132  ALIAS (AC,ACP,ACPP,ACPPP), (ACNT,ACNTP,ACNTPP,ACNTPPP), (ACBAL,ACBALP);
 133   
 134  SETS
 135   SMLCELL(AC,ACP)  SAM cells with abs value < cutoff are removed
 136   INEG(AC,ACP)     cells with negative values in data
 137   IZERO(AC,ACP)    cells with zero entry
 138   NONZERO(AC,ACP)  cells with nonzero entry
 139   ICOEFF(AC,ACP)   cell coefficients to be estimated
 140   IVALUE(AC,ACP)   cell values to be estimated
 141   ESTIMATE(AC,ACP) cells to be estimated and not fixed
 142   IFIXC(AC,ACP)    cell coefficient fixed with no error
 143   IFIXV(AC,ACP)    cell value fixed with no error
 144   ACELL(AC,ACP)    additive error for cells
 145   LCELL(AC,ACP)    logarithmic error for cells
 146   ICOL(AC)         columns with non zero elements
 147   ICOL2(AC)        column sums to be constrained with or without error
 148   ICOLNZ(AC)       columns with nonzero sum
 149   IROW(AC)         rows with non zero elements
 150   ACOL(AC)         additive errors for column sum constraints
 151   LCOL(AC)         multiplicative errors for column sum constraints
 152   MACRO            potential macro control totals
 153      /
 154      LABACT, LNDACT, KAPACT
 155      ATXACT, ETXCOM, MTXCOM, STXCOM, DTXLAB, DTXLND, DTXCAP, DTXHHD, DTXENT
 156      COMHHD, COMGOV, COMINV, COMROW, ROWCOM
 157      GOVLAB, GOVLND, GOVCAP
 158      ROWLAB, ROWLND, ROWCAP
 159      HHDENT, GOVENT, SAVENT, ROWENT
 160      ENTHHD, GOVHHD, SAVHHD, ROWHHD
 161      SAVROW
 162      AGR, MIN, MAN, UTL, CON, TRD, TRN, HOT, COM, FBS, GOV, OSV
 163      /
 164   MACRO2(MACRO)    macro constraints actually imposed
 165      /
 166      LABACT, LNDACT, KAPACT
 167      ATXACT, ETXCOM, MTXCOM, STXCOM, DTXLAB, DTXLND, DTXCAP, DTXHHD, DTXENT
 168      COMHHD, COMGOV, COMINV, COMROW, ROWCOM
 169      GOVLAB, GOVLND, GOVCAP
 170      ROWLAB, ROWLND, ROWCAP
 171      HHDENT, GOVENT, SAVENT, ROWENT
 172      ENTHHD, GOVHHD, SAVHHD, ROWHHD
