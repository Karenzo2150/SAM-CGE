 175      /
 176   AGR(A) / asorg,amaiz,awhea,arice,aocer,aipot,aspot,acass,aroot,abean,apeas,avege,abanb,abanc,abans,afrui,agnut,asoya,aoils,acoff,ateal,atoba,asugr,apyre,aocrp,acatt,asmlr,apoul,aoliv,amilk,aeggs,ahony,ahunt,afuel,achar,afore,afish /
 177   MIN(A) / angas,amore,aomin,ameat /
 178   MAN(A) / afsea,afveg,afoil,adair,agmll,abake,afeed,afood,aalco,abeve,aptob,atext,awood,aprnt,apetr,achem,aphar,aprub,anmet,aceme,aclay,ametl,amach,avehi,afurn,aoman,arepr /
 179   UTL(A) / aelec,awatr,awast /
 180   CON(A) / acons,acont /
 181   TRD(A) / avehr,aveht,atrdw,atrdr /
 182   TRN(A) / atrnl,atrna,atrns,apost /
 183   HOT(A) / ahotl /
 184   COM(A) / apubl,acomm,ainfo /
 185   FBS(A) / abank,ainsu,aofsv,arent,areal,alegl,aenga,aprod,atrvl,aobsv /
 186   GOV(A) / apadm,aeduc,aheal,asocw /
 187   OSV(A) / acult,aarts,aosrv,adsrv,atrdc /
 188   MACAGG(ac,acp,macro) Macro aggregator matrix
 189   AMAC(MACRO)      additive error for macro constraints
 190   LMAC(MACRO)      multiplicative error for macro constraints
 191   JWT              Weights for error support set  /1*3/
 192  ;
 193   
 194  SCALAR
 195   cutoff            lower bound on absolute cell values
 196   epsilon           epsilon value for cross-entropy minimand     /.000001 /
 197   ;
 198   cutoff = 0 ;
 199   
 200  PARAMETER
 201   tsam0(AC,ACP)     initial SAM
 202   sambalchk(ac)     col sums minus row sums
 203   coeff0(AC,ACP)    column coefficients
 204   colsum0(AC)       initial column sum
 205   coltarget(AC)     target column sum
 206   mactotal0(MACRO)  initial macro totals
 207   vbar1(ac,jwt)     Error support set 1 for column constraints
 208   vbar2(macro,jwt)  Error support set 2 for macro constraints
 209   vbar3(ac,acp,jwt) Error support set 3 for cell constraints
 210   wbar1(ac,jwt)     Weights on error support set 1
 211   wbar2(macro,jwt)  Weights on error support set 2
 212   wbar3(ac,acp,jwt) Weights on error support set 3
 213   sigmay1(ac)       Prior standard error of column sums
 214   sigmay2(macro)    Prior standard error of macro aggregates
 215   sigmay3(ac,acp)   Prior standard error for cell constraints
 216   ;
 217   
 218  VARIABLES
 219   TSAM(AC,ACP)      SAM values
 220   COEFF(AC,ACP)     SAM coefficients
 221   COLSUM(AC)        column sums
 222   ERR1(AC)          Error value on column sums
 223   ERR2(MACRO)       Error value for macro aggregates
 224   ERR3(AC,ACP)      Error value for cell constraint
 225   W1(AC,jwt)        Error weights
 226   W2(macro,jwt)     Error weights
 227   W3(AC,ACP,jwt)    Error weights
 228   DENTROPY          Entropy difference (objective)
 229   ;
 230   
 231  EQUATIONS
 232   SAMFLOW1(ac,acp)  SAM flows with additive errors
 233   SAMFLOW2(ac,acp)  SAM flows with logarithmic errors
 234   SAMCOEFF1(ac,acp) SAM coefficients with additive errors
 235   SAMCOEFF2(ac,acp) SAM coefficients with logarithmic errors
 236   COLSUMEQ1(ac)     column sums with additive errors
 237   
 238   COLSUMDEF(ac)     define column sums
 239   COEFFDEF(ac,acp)  define coefficients
 240   
 241   SAMEQ(ac)          row and column sum constraint
 242   
 243  *macro constraints
 244   MACROEQ(macro)    macro aggregation constraints
 245   
 246   ERROR1EQ(ac)      definition of error term 1
 247   ERROR2EQ(macro)   definition of error term 2
 248   ERROR3EQ(ac,acp)  definition of error term 3
 249   SUMW1(ac)         Sum of weights 1
 250   SUMW2(macro)      Sum of weights 2
 251   SUMW3(ac,acp)     Sum of weights 3
 252   ENTROPY           Entropy difference definition
 253   ;
 254   
 255  *SAM value and coefficient constraints
 256   SAMFLOW1(acnt,acntp)$(IVALUE(acnt,acntp) and ACELL(acnt,acntp))..
 257    TSAM(acnt,acntp)  =E= tsam0(acnt,acntp) + ERR3(acnt,acntp) ;
 258   
 259   SAMFLOW2(acnt,acntp)$(IVALUE(acnt,acntp) and LCELL(acnt,acntp))..
 260    TSAM(acnt,acntp)  =E= tsam0(acnt,acntp)*EXP(ERR3(acnt,acntp)) ;
 261   
 262   SAMCOEFF1(acnt,acntp)$(ICOEFF(acnt,acntp) and ACELL(acnt,acntp))..
 263    COEFF(acnt,acntp) =E= coeff0(acnt,acntp) + ERR3(acnt,acntp) ;
 264   
 265   SAMCOEFF2(acnt,acntp)$(ICOEFF(acnt,acntp) and LCELL(acnt,acntp))..
 266    COEFF(acnt,acntp) =E= coeff0(acnt,acntp)*EXP(ERR3(acnt,acntp)) ;
 267   
 268  *Column sum constraints
 269   COLSUMEQ1(acnt)$(ICOL2(acnt) and ACOL(acnt))..
 270    COLSUM(acnt)      =E= coltarget(acnt) + ERR1(acnt) ;
 271   
 272  *Define column sums and coefficients
 273   COLSUMDEF(acnt)$ICOL(acnt)..
 274    COLSUM(acnt)      =E= SUM(acntp$IROW(acntp), TSAM(acntp,acnt)) ;
 275   
 276  *Only compute coefficients for nonzero cells
 277   COEFFDEF(acnt,acntp)$((NOT IFIXV(acnt,acntp)) and ICOL(acntp) and IROW(acnt) and ICOLNZ(acntp))..
 278    COEFF(acnt,acntp)*COLSUM(acntp) =E= TSAM(acnt,acntp);
 279   
 280  *Row and column sum equality constraint
 281   SAMEQ(acnt)$ACBAL(acnt)..
 282    COLSUM(acnt)      =E= SUM(acntp$ICOL(acntp), TSAM(acnt,acntp)) ;
 283   
 284  *Macro constrints
 285   MACROEQ(MACRO2)..
 286    SUM((irow,icol)$MACAGG(irow,icol,macro2),
 287    TSAM(irow,icol)) =E= MACTOTAL0(macro2) + ERR2(macro2) ;
 288   
 289  *Definition of error terms
 290   
 291   ERROR1EQ(acnt)$(ICOL2(acnt) and ACOL(acnt) and sigmay1(acnt))..
 292    ERR1(acnt)   =E= SUM(jwt, W1(acnt,jwt)*vbar1(acnt,jwt)) ;
 293   
 294   SUMW1(acnt)$(ICOL2(acnt) and ACOL(acnt) and sigmay1(acnt))..
 295    SUM(jwt, W1(acnt,jwt)) =E= 1 ;
 296   
 297   ERROR2EQ(macro2)$sigmay2(macro2)..
 298    ERR2(macro2) =E= SUM(jwt, W2(macro2,jwt)*vbar2(macro2,jwt)) ;
 299   
 300   SUMW2(macro2)$sigmay2(macro2)..
 301    SUM(jwt, W2(macro2,jwt)) =E= 1 ;
 302   
 303   ERROR3EQ(acnt,acntp)$((IVALUE(acnt,acntp) or ICOEFF(acnt,acntp))
 304                        and sigmay3(acnt,acntp))..
 305    ERR3(acnt, acntp)  =E= SUM(jwt, W3(acnt,acntp,jwt)*vbar3(acnt,acntp,jwt)) ;
 306   
 307   SUMW3(acnt,acntp)$((IVALUE(acnt,acntp) or ICOEFF(acnt,acntp))
 308                        and sigmay3(acnt,acntp))..
 309    SUM(jwt, W3(acnt,acntp,jwt)) =E= 1 ;
 310   
 311  *Objective function
 312   ENTROPY..
 313    DENTROPY =E= SUM((acnt,jwt)$(ICOL2(acnt) and ACOL(acnt) and sigmay1(acnt)),
 314                      W1(acnt,jwt)
 315                    * (LOG(W1(acnt,jwt) + epsilon)
 316                    - LOG(wbar1(acnt,jwt) + epsilon)))
 317                              +
 318                 SUM((macro2,jwt)$sigmay2(macro2),
 319                      W2(macro2,jwt)
 320                    * (LOG(W2(macro2,jwt) + epsilon)
 321                    - LOG(wbar2(macro2,jwt) + epsilon)))
 322                              +
 323                 SUM((acnt,acntp,jwt)$((IVALUE(acnt,acntp) or ICOEFF(acnt,acntp))
 324                                   and sigmay3(acnt,acntp)),
 325                      W3(acnt,acntp,jwt)
 326                    * (LOG(W3(acnt,acntp,jwt) + epsilon)
 327                    - LOG(wbar3(acnt,acntp,jwt) + epsilon)))
 328  ;
 329   
 330   
 331  *Country-specific data and set definitions
 332  *SETS and DATA======================
 333   
 334   TSAM0(acnt,acntp) = SAM(acnt,acntp)*SCALE;
 335   
 336  *DIAGNOSTICS
 337  *$include diagnostic.inc
 338   
 339  *Define various sets based on initial SAM, tsam0
 340   
 341  *For a SAM, which is square, ACBAL is the entire set.
 342   ACBAL(acnt) = YES ;
 343   
 344   TSAM0("TOTAL",acntp)  = sum(acnt,  TSAM0(acnt,acntp));
 345   TSAM0(acnt,"TOTAL")   = sum(acntp, TSAM0(acnt,acntp));
 346   SAMBALCHK(ACNT)$ACBAL(ACNT) = TSAM0('TOTAL',ACNT) - TSAM0(ACNT,'TOTAL');
 347   
 348   display " tsam0 before balancing", tsam0, sambalchk;
 349   
 350  *Define column sums that can be constrained.
 351  *Might want to exclude columns with only one entry. Or, alternatively,
 352  *leave them in and define entry constraint in terms of coefficients.
 353  *Can exclude any other columns for which column constraints do not
 354  *make a lot of sense.
 355  *Balance accounts which sum to zero by definition should probably be
 356  *constrained exactly, with no error. Can be done by simply setting their
 357  *prior standard error, sigmay1, to zero, which will happen automatically if
 358  *the target column sum is zero. See section on defining sigmay1.
 359   
 360   Parameter countcol(ac)  number of nonzero cells in columns
 361             countrow(ac)  number of nonzero cells in rows ;
 362   loop(acntp,
 363   countcol(acntp) = 0 ;
 364   countrow(acntp) = 0 ;
 365     loop(acnt,
 366     countcol(acntp)$TSAM0(acnt,acntp) = countcol(acntp) + 1 ;
 367     countrow(acntp)$TSAM0(acntp,acnt) = countrow(acntp) + 1 ;
 368     );
 369   );
 370   
 371  *Define column and row sets for all accounts with any nonzero elements in the
 372  *corresponding row and column. A pure balancing SAM account might have a row or
 373  *column with all zeros. It is harmless to exclude such accounts from the
 374  *balancing procedure, but they must be part of ACBAL.
 375   ICOL(acnt)$(countcol(acnt) or ACBAL(acnt))   = yes ;
 376   IROW(acnt)$(countrow(acnt) or ACBAL(acnt))   = yes ;
 377   
 378   display icol, countcol, irow, countrow ;
 379   
 380  *Define columns and rows with nonzero sums and compute column coefficients.
 381  *Nonzero here is defined as significant absolute value so that column
 382  *coefficients can be computed safely.
 383   ICOLNZ(acnt)$(ABS(TSAM0("TOTAL",acnt) gt 0.00)) = yes ;
 384   coeff0(acnt,icolnz)      = TSAM0(acnt,icolnz)/TSAM0("TOTAL",icolnz) ;
 385   colsum0(acnt)$icol(acnt) = TSAM0("TOTAL",acnt) ;
 386   
 387  *Define column accounts that will have constraints. Start by assuming all
 388  *column accounts will be constrained. Those with zero or negative sums cannot
 389  *have column coefficients that are constrained.
 390   ICOL2(acnt)    = ICOL(acnt) ;
 391   
 392  *Constrain column sums where there will be lots of coefficients. Otherwise, we
 393  *will only be constraining relative cell values, not values.
 394   ICOL2(A)       = NO ;
 395   ICOL2(C)       = NO ;
 396   
 397  *Assume all col sum errors are additive. Multiplicative column sum errors
 398  *are not yet programmed.
 399   LCOL(ICOL2)    = no ;
 400   ACOL(ICOL2)    = yes ;
 401   
 402   display countrow, irow, countcol, icol, icol2, lcol ;
 403   
 404  *Find negative cell entries
 405   IZERO(acnt,acntp)$(TSAM0(acnt,acntp) eq 0)   = yes ;
 406   NONZERO(acnt,acntp)$(not IZERO(acnt,acntp))  = yes ;
 407   INEG(acnt,acntp)$((TSAM0(acnt,acntp) lt 0) and nonzero(acnt,acntp)) = yes ;
 408   
 409   display izero, nonzero ;
 410   display ineg ;
 411   
 412  *Specify nature of cell error, whether on coefficients or on values,
 413  *and whether additive or multiplicative.
 414  *Negative cells are specified as values with additive errors.
 415  *All positive cells are initially specified with multiplicative errors
 416  *on values. This ensures that positive cells will not change sign.
 417  *Then various cells are chosen to be specified as coefficients.
 418  *All coefficient cells are specified with multiplicative errors.
 419   
 420   IVALUE(acnt,acntp)$(nonzero(acnt,acntp))          = yes ;
 421   
 422  *Now set cells which are naturally seen as coefficients. Do not specify as
 423  *coefficient if cell does not have a positive coefficient value, coeff0.
 424  *JT: Set all household cells to coefficients
 425   IVALUE(acnt,'HHD')$(coeff0(acnt,'HHD') gt 0)              = yes ;
 426   
 427  *Set any negative cells to values
 428   IVALUE(acnt,acntp)$ineg(acnt,acntp)               = yes ;
 429   
 430  *Set cells in columns with only one cell to value
 431   IVALUE(irow,icol)$((countcol(icol) eq 1) and nonzero(irow,icol)) = yes ;
 432   
 433  *Set any cells in columns with negative or zero sum to values. Such cells
 434  *should not have a positive coeff0, but this is an extra check.
 435   IVALUE(acnt,acntp)$(icol(acntp) and (colsum0(acntp) lt 0)
 436                   and ICOLNZ(acntp))                = yes ;
 437   
 438  *If cell error is not on values, then it will be on coefficients.
 439   
 440   ICOEFF(acnt,acntp)$((not izero(acnt,acntp)) and
 441                       (not ivalue(acnt,acntp)))    = yes ;
 442   
 443   ESTIMATE(acnt,acntp)$(ivalue(acnt,acntp) or icoeff(acnt,acntp)) = yes ;
 444   
 445  *Start by assuming that all cells have additive errors.
 446   ACELL(acnt,acntp)$ESTIMATE(acnt,acntp)    = yes ;
 447   
 448  *Turn off ACELL for cells that have multiplicative errors
 449   ACELL(acnt,acntp)$ICOEFF(acnt,acntp)      = no ;
 450  *Make sure that ACELL is on for negative cells
 451   ACELL(acnt,acntp)$ineg(acnt,acntp)         = yes ;
 452   
 453   LCELL(acnt,acntp)$(NOT ACELL(acnt,acntp)) = yes ;
 454   
 455   IFIXV(acnt,acntp)$((not ivalue(acnt,acntp)) and
 456                      (not icoeff(acnt,acntp))) = yes ;
 457   
 458  *Check for errors. Cells cannot be constrained in both values and coefficients.
 459  *All cells to be estimated must have lcell or acell.
 460   SET ICHECK(ac,acp)  Error check for cell constraints;
 461   ICHECK(acnt,acntp)$(ivalue(acnt,acntp) and icoeff(acnt,acntp)) = yes ;
 462   display "Error check. Cells with both ivalue and icoeff", ICHECK ;
 463   ICHECK(acnt,acntp)$(estimate(acnt,acntp) and ((not acell(acnt,acntp)) and
 464                                                  not lcell(acnt,acntp))) = yes ;
 465   display "Error check. Cells to be estimated but neither acell nor lcell",
 466        ICHECK ;
 467   ICHECK(irow,icol)$(estimate(irow,icol) and izero(irow,icol)) = yes ;
 468   display "Error check. Cells to be estimated but initially zero", ICHECK ;
 469   
 470   display ivalue, icoeff, acell, lcell ;
 471   
 472  *Define macro aggregates for household control totals
 473      MACAGG('FLAB',A,'LABACT')       = YES;
 474      MACAGG('FLND',A,'LNDACT')       = YES;
 475      MACAGG('FCAP',A,'KAPACT')       = YES;
 476      MACAGG('ATAX',A,'ATXACT')     = YES;
 477      MACAGG('ETAX',C,'ETXCOM')     = YES;
 478      MACAGG('MTAX',C,'MTXCOM')     = YES;
 479      MACAGG('STAX',C,'STXCOM')     = YES;
 480      MACAGG('DTAX','FLAB','DTXLAB')  = YES;
 481      MACAGG('DTAX','FLND','DTXLND')  = YES;
 482      MACAGG('DTAX','FCAP','DTXCAP')  = YES;
 483      MACAGG('DTAX','HHD','DTXHHD') = YES;
 484      MACAGG('DTAX','ENT','DTXENT') = YES;
 485      MACAGG(C,'HHD','COMHHD')      = YES;
 486      MACAGG(C,'GOV','COMGOV')      = YES;
 487      MACAGG(C,'S-I','COMINV')      = YES;
 488      MACAGG(C,'ROW','COMROW')      = YES;
 489      MACAGG('ROW',C,'ROWCOM')      = YES;
 490      MACAGG('GOV','FLAB','GOVLAB')   = YES;
 491      MACAGG('GOV','FLND','GOVLND')   = YES;
 492      MACAGG('GOV','FCAP','GOVCAP')   = YES;
 493      MACAGG('ROW','FLAB','ROWLAB')   = YES;
 494      MACAGG('ROW','FLND','ROWLND')   = YES;
 495      MACAGG('ROW','FCAP','ROWCAP')   = YES;
 496      MACAGG('HHD','ENT','HHDENT')  = YES;
 497      MACAGG('GOV','ENT','GOVENT')  = YES;
 498      MACAGG('S-I','ENT','SAVENT')  = YES;
 499      MACAGG('ROW','ENT','ROWENT')  = YES;
 500      MACAGG('ENT','HHD','ENTHHD')  = YES;
 501      MACAGG('GOV','HHD','GOVHHD')  = YES;
 502      MACAGG('S-I','HHD','SAVHHD')  = YES;
 503      MACAGG('ROW','HHD','ROWHHD')  = YES;
 504      MACAGG('S-I','ROW','SAVROW')  = YES;
 505   
 506      MACAGG(F,AGR,'AGR') = YES;
 507      MACAGG(F,MIN,'MIN') = YES;
 508      MACAGG(F,MAN,'MAN') = YES;
 509      MACAGG(F,UTL,'UTL') = YES;
 510      MACAGG(F,CON,'CON') = YES;
 511      MACAGG(F,TRD,'TRD') = YES;
 512      MACAGG(F,TRN,'TRN') = YES;
 513      MACAGG(F,HOT,'HOT') = YES;
 514      MACAGG(F,COM,'COM') = YES;
 515      MACAGG(F,FBS,'FBS') = YES;
 516      MACAGG(F,GOV,'GOV') = YES;
 517      MACAGG(F,OSV,'OSV') = YES;
 518   
 519  *Initialize values from TSAM0
 520   MACTOTAL0(macro)           = SUM((irow,icol)$MACAGG(irow,icol,macro),
 521                                TSAM0(irow,icol)) ;
 522   Display  mactotal0, ESTIMATE ;
 523   
 524  *Set error  bounds and support sets. Assume a prior on standard deviation
 525  *of the errors, sigma.
 526   
 527  *############### Define variable bounds on errors #####################
 528  * Start from assumed prior knowledge of the standard error (perhaps due
 529  * to measurement error) of the column sums. Below, we assume that all
 530  * column sums have a standard error of 5%. This is a Bayesian prior,
 531  * not a maintaned hypothesis.
 532  * The estimated error is weighted sum of elements in an error support
 533  * set:
 534  *   ERR(acnt) = SUM(jwt, W(acnt,jwt)*VBAR(acnt,jwt))
 535  * where the W's are estimated in the CE procedure.
 536  * The prior variance of these errors is given by:
 537  *   (sigmay(acnt))**2 = SUM(jwt, WBAR(acnt,jwt)*(VBAR(acnt,jwt))**2 )
 538  * where the WBAR's are the prior on the weights.
 539  * The VBARs are chosen to define a domain for the support set of +/- 3
 540  * standard errors. The prior on the weights, WBAR, are then calculated
 541  * to yield the specified prior on the standard error, sigmay.
 542  * In Robinson, Cattaneo, and El-Said (2001), we specify prior weights
 543  * (WBAR) that are uniform and set the prior standard error by the
 544  * choice of support set, VBAR. In that paper, we use a three-weight
 545  * specification (jwt /1*3/);
 546  *
 547  * We define three sets of errors with separate weights, W1, W2, and W3. The
 548  * first is for specifying errors on column sums, the second for errors
 549  * on macro aggregates (defined in the set macro), and the third for errors
 550  * in cell values.
 551   
 552  * If sigmay is set to zero, the corresponding constraint is assumed to be
 553  * exact, with no error.
 554   
 555  * Define standard errors for errors on column sums, sigmay1. Also set coltarget
 556  * to average of initial column and row sums. Column sum can be zero or
 557  * negative. Using an average of protosam column and row sums is arbitrary. If
 558  * better prior information about column sums is known, use it. In this version,
 559  * if the initial column sum is zero, then sigmay2 will also be zero and the
 560  * account will be constrained to sum to zero. This is appropriate for a
 561  * "balancing" account. However, a nonzero sum with or without error can also
 562  * be specified.
 563   
 564  *Set sigmay1 and target column sums
 565   
 566    coltarget(acbal) = 0.5*(colsum0(acbal) + SUM(icol, TSAM0(acbal,icol))) ;
 567  *  coltarget(acbal) = colsum0(acbal);
 568   
 569  *Set sigmay1, standard errors for errors on column totals
 570   
 571    sigmay1(acnt)$(ICOL2(acnt) and ACOL(acnt)) = 0.05*ABS(coltarget(acnt)) ;
 572   
 573  *Set sigmay2, standard errors for errors on macro aggregates
 574    sigmay2(macro2)      = 0.1*ABS(mactotal0(macro2)) ;
 575  SET
 576   MACRO3(MACRO2) / AGR, MIN, MAN, UTL, CON, TRD, TRN, HOT, COM, FBS, GOV, OSV /
 577  ;
 578    sigmay2(macro3)       = 0.005*ABS(mactotal0(macro3)) ;
 579   
 580  * Set errors on cell elements, sigmay3. They can be on values or coefficients,
 581  * and can be specified as additive or multiplicative. If multiplicative, the
 582  * prior is implicitly specified as lognormal. That is, log(error) is
 583  * distributed as a normal with mean zero and standard deviation sigmay3.
 584  * Then EXP(error), which is the multiplicative error, has mean one.
 585   
 586  *Set sigmay3, standard errors for errors on cell values
 587   
 588    sigmay3(acnt,acntp)$(IVALUE(acnt,acntp) and ACELL(acnt,acntp)) = 0.2*ABS(tsam0(acnt, acntp))   ;
 589    sigmay3(acnt,acntp)$(IVALUE(acnt,acntp) and LCELL(acnt,acntp)) = 0.2   ;
 590   
 591    sigmay3(acnt,acntp)$(ICOEFF(acnt,acntp) and ACELL(acnt,acntp)) = 0.2*ABS(coeff0(acnt, acntp))   ;
 592    sigmay3(acnt,acntp)$(ICOEFF(acnt,acntp) and LCELL(acnt,acntp)) = 0.2   ;
 593   
 594    sigmay3(ACNT,ACNTP)$((NOT ACBAL(ACNT)) AND (NOT ACBAL(ACNTP))) = 0;
 595   
 596    sigmay3(C,A)$(ICOEFF(C,A) and ACELL(C,A)) = 0.2*ABS(coeff0(C,A))   ;
 597   
 598   
 599   
      *Set sigmay3 to a large number if there are very few cells in a column and
      *you do not have a strong prior on the column total.
      *In this case, we assume that the row element constraints will be binding
        sigmay3(acnt,acntp)$(ICOEFF(acnt,acntp) and ACELL(acnt,acntp)
                                                and (count(acntp) eq 1))
          = 0.75*coeff0(acnt, acntp)   ;
        sigmay3(acnt,acntp)$(ICOEFF(acnt,acntp) and LCELL(acnt,acntp)
                                                and (count(acntp) eq 1))
          = 0.75   ;
      *SR ### This can also be handled by specifying such cells as coeff and
      * do not constrain the column sum.
       
 614   
 615  * This code assumes a prior mean of zero and a two-parameter
 616  * distribution with specified prior standard error. There are three
 617  * weights, W(acnt,jwt), to be estimated. The actual moments are estimated
 618  * as part of the estimation procedure.
 619  *$ontext
 620  * Set constants for 3-weight error distribution
 621    vbar1(acnt,"1")  = -3 * sigmay1(acnt);
 622    vbar1(acnt,"2")  =  0             ;
 623    vbar1(acnt,"3")  = +3 * sigmay1(acnt);
 624   
 625    wbar1(acnt,"1")  =  1/18  ;
 626    wbar1(acnt,"2")  = 16/18  ;
 627    wbar1(acnt,"3")  =  1/18  ;
 628   
 629  *$offtext
 630   
 631  * This code assumes a prior mean of zero and a prior value of kurtosis
 632  * consistent with a prior normal distribution with mean zero, variance
 633  * sigmay**2, and kurtosis equal to 3*sigmay**4. The addition of a prior
 634  * on kurtosis requires estimation of 5 weights (jwt = 5);
 635  * The prior weights wbar are specified so that:
 636  * SUM(jwt, wbar(acnt,jwt)*vbar(acnt,jwt)**4) = 3*sigmay(acnt,jwt)**4
 637  * as well as defining the variance as above.
 638  * The prior weights and support set are also symmetric, so the prior
 639  * on all odd moments is zero. The choice of +/- 1 standard error
 640  * for vbar(acnt,"2") and vbar(acnt,"4") is arbitrary.
 641  * The actual moments are estimated as part of the estimation procedure.
 642   
      * Set constants for 5-weight error distribution
        vbar1(acnt,"1")  = -3 * sigmay1(acnt) ;
        vbar1(acnt,"2")  = -1 * sigmay1(acnt) ;
        vbar1(acnt,"3")  =  0              ;
        vbar1(acnt,"4")  = +1 * sigmay1(acnt) ;
        vbar1(acnt,"5")  = +3 * sigmay1(acnt) ;
       
        wbar1(acnt,"1")  =   1/72;
        wbar1(acnt,"2")  =  27/72;
        wbar1(acnt,"3")  =  16/72;
        wbar1(acnt,"4")  =  27/72;
        wbar1(acnt,"5")  =   1/72;
 657   
 658  *$ontext
 659  * Set constants for 3-weight error distribution
 660    vbar2(macro,"1")  = -3 * sigmay2(macro);
 661    vbar2(macro,"2")  =  0             ;
 662    vbar2(macro,"3")  = +3 * sigmay2(macro);
 663   
 664    wbar2(macro,"1")  =  1/18  ;
 665    wbar2(macro,"2")  = 16/18  ;
 666    wbar2(macro,"3")  =  1/18  ;
 667  *$offtext
 668   
      * Set constants for 5-weight error distribution
        vbar2(macro,"1")  = -3 * sigmay2(macro) ;
        vbar2(macro,"2")  = -1 * sigmay2(macro) ;
        vbar2(macro,"3")  =  0                  ;
        vbar2(macro,"4")  = +1 * sigmay2(macro) ;
        vbar2(macro,"5")  = +3 * sigmay2(macro) ;
       
        wbar2(macro,"1")  =   1/72;
        wbar2(macro,"2")  =  27/72;
        wbar2(macro,"3")  =  16/72;
        wbar2(macro,"4")  =  27/72;
        wbar2(macro,"5")  =   1/72;
 683   
 684  *$ontext
 685  * Set constants for 3-weight error distribution
 686    vbar3(acnt,acntp,"1")  = -3 * sigmay3(acnt,acntp);
 687    vbar3(acnt,acntp,"2")  =  0             ;
 688    vbar3(acnt,acntp,"3")  = +3 * sigmay3(acnt,acntp);
 689   
 690    wbar3(acnt,acntp,"1")  =  1/18  ;
 691    wbar3(acnt,acntp,"2")  = 16/18  ;
 692    wbar3(acnt,acntp,"3")  =  1/18  ;
 693  *$offtext
 694   
      * Set constants for 5-weight error distribution
        vbar3(acnt,acntp,"1")  = -3 * sigmay3(acnt,acntp);
        vbar3(acnt,acntp,"2")  = -1 * sigmay3(acnt,acntp);
        vbar3(acnt,acntp,"3")  =  0                  ;
        vbar3(acnt,acntp,"4")  = +1 * sigmay3(acnt,acntp);
        vbar3(acnt,acntp,"5")  = +3 * sigmay3(acnt,acntp);
       
        wbar3(acnt,acntp,"1")  =   1/72;
        wbar3(acnt,acntp,"2")  =  27/72;
        wbar3(acnt,acntp,"3")  =  16/72;
        wbar3(acnt,acntp,"4")  =  27/72;
        wbar3(acnt,acntp,"5")  =   1/72;
 709   
 710   Display sigmay1, sigmay2, sigmay3, icol2;
 711   Display vbar1, vbar2, vbar3;
 712   
 713  *######################## DEFINE MODEL ############################
 714   
 715   MODEL SAMENTROP
 716   /
 717   SAMFLOW1
 718   SAMFLOW2
 719   SAMCOEFF1
 720   SAMCOEFF2
 721   COLSUMEQ1
 722   COLSUMDEF
 723   COEFFDEF
 724   SAMEQ
 725   MACROEQ
 726   ERROR1EQ
 727   ERROR2EQ
 728   ERROR3EQ
 729   SUMW1
 730   SUMW2
 731   SUMW3
 732   ENTROPY
 733   / ;
 734   
 735  DISPLAY "141",COLSUM0;
 736   
 737   
 738  *Initialize variables
 739   TSAM.L(acnt,acntp)       = tsam0(acnt,acntp) ;
 740   COEFF.L(acnt,acntp)      = coeff0(acnt,acntp) ;
 741   COLSUM.L(icol)           = colsum0(icol) ;
 742   ERR1.L(AC)               = 0 ;
 743   ERR2.L(MACRO)            = 0 ;
 744   ERR3.L(AC,ACP)           = 0 ;
 745   W1.L(acnt,jwt)           = wbar1(acnt,jwt) ;
 746   W2.L(macro,jwt)          = wbar2(macro,jwt) ;
 747   W3.L(acnt,acntp,jwt)     = wbar3(acnt,acntp,jwt) ;
 748   DENTROPY.L               = 0 ;
 749   
 750  *Set bounds and fix variables that need to be fixed
 751  *###############  Define bounds for cell values  ####################
 752   
 753  * Defining equation SAMMAKE over non-zero elements of A ($Abar1(acnt,acntp))
 754  * guarantees that the zero structure of the original SAM is maintained
 755  * in the estimated SAM. Fixing all the zero entries to zero greatly
 756  * reduces the size of the estimation problem. If it is desired to
 757  * allow a zero entry to become nonzero in the estimated SAM, then
 758  * the condition $ABAR1(acnt,acntp) must be replaced with a new set that
 759  * does not include cells which are currently zero but may be nonzero.
 760   
 761  * COEFF.LO(acnt,acntp)$icoeff(acnt,acntp)      = 0 ;
 762  * COEFF.UP(acnt,acntp)$icoeff(acnt,acntp)      = 1 ;
 763  *COEFF.FX(acnt,acntp)$(NOT nonzero(acnt,acntp))= 0;
 764   
 765  *Fix coeff to zero if it is not a ivalue
 766    COEFF.FX(acnt,acntp)$IFIXV(acnt,acntp)       = coeff0(acnt,acntp) ;
 767   
 768  *TSAM.LO(acnt,acntp)                           = 0.0 ;
 769  *TSAM.UP(acnt,acntp)                           = +inf ;
 770   
 771   TSAM.FX(acnt,acntp)$IFIXV(acnt,acntp)         = tsam0(acnt,acntp) ;
 772   
 773  * Upper and lower bounds on the error weights
 774   W1.LO(acnt,jwt)                            = 0   ;
 775   W1.UP(acnt,jwt)                            = 1   ;
 776   W2.LO(macro2,jwt)                          = 0   ;
 777   W2.UP(macro2,jwt)                          = 1   ;
 778   W3.LO(acnt,acntp,jwt)                      = 0   ;
 779   W3.UP(acnt,acntp,jwt)                      = 1   ;
 780   
 781  *If standard deviation of errors is set to zero, fix the weights to the prior
 782  *so that the error will always be zero.
 783  *   Note that it should not be necessary to fix W if ERR is fixed. I now
 784  *   exclude equations for errors and error weights when sigmay is zero.
 785   W1.FX(acnt, jwt)$(sigmay1(acnt) eq 0)            = wbar1(acnt,jwt) ;
 786   W2.FX(macro2,jwt)$(sigmay2(macro2) eq 0)         = wbar2(macro2,jwt) ;
 787   W3.FX(acnt,acntp,jwt)$(sigmay3(acnt,acntp) eq 0) = wbar3(acnt,acntp,jwt) ;
 788   
 789   ERR1.FX(acnt)$(sigmay1(acnt) eq 0)               = 0 ;
 790   ERR2.FX(macro2)$(sigmay2(macro2) eq 0)           = 0 ;
 791   ERR3.FX(acnt,acntp)$(sigmay3(acnt,acntp) eq 0)   = 0 ;
 792   
 793  *######################## SOLVE MODEL #############################
 794   
 795   OPTION ITERLIM       = 100000;
 796   OPTION LIMROW        = 150 ,    LIMCOL       = 150;
 797   OPTION SOLPRINT      = OFF ;
 798   OPTION RESLIM        = 100000;
 799   
 800    SAMENTROP.HOLDFIXED = 1 ;
 801  * OPTION NLP          = PATHNLP ;
 802    OPTION NLP          = CONOPT3;
 803   
 804   
 805  *########################### Solve statenment ######################
 806   
 807    SOLVE SAMENTROP using nlp minimizing dentropy ;
 808   
 809  *###################################################################
 810   
 811  *---------------- Parameters for reporting results
 812  Parameters
 813   SAMCE(ac,acp)      New balanced SAM flows from CE
 814   SEM                Squared Error Measure
 815   VALDIFF(ac,acp)    Differnce btw original SAM and Final SAM in values
 816   PERDIFF(ac,acp)    Differnce btw original SAM and Final SAM in Percent
 817   bigdiffp(ac,acp)   Cells with large percent change
 818   NormEntrop         Normalized Entropy a measure of total uncertainty
 819   ;
 820   
 821   valdiff(acnt,acntp)               = TSAM.l(acnt,acntp) - tsam0(acnt,acntp) ;
 822   perdiff(acnt,acntp)$tsam0(acnt,acntp) = 100*(TSAM.l(acnt,acntp)/tsam0(acnt,acntp) - 1 ) ;
 823   bigdiffp(ac,acp)$(abs(perdiff(ac,acp)) gt 25) = perdiff(ac,acp) ;
 824   
 825   SAMCE(acnt,acntp)        = TSAM.l(acnt,acntp);
 826   SAMCE("total",acntp)     = SUM(acnt, SAMCE(acnt,acntp)) ;
 827   SAMCE(acnt,"total")      = SUM(acntp, SAMCE(acnt,acntp)) ;
 828   SAMBALCHK(ACNT)          = SAMCE('TOTAL',ACNT) - SAMCE(ACNT,'TOTAL');
 829   SAMBALCHK(ACNT)$(ABS(SAMBALCHK(ACNT)) LT 1E-6) = 0;
 830   
 831   display " SAMCE after balancing", samce;
 832   display " SAMBALCHK after balancing", sambalchk ;
 833   
 834   SEM = Sum((acnt,acntp), SQR(COEFF.L(acnt,acntp) - coeff0(acnt,acntp)))/SQR(9);
 835  *r=national
       NormEntrop             = SUM((acnt,acntp)$((coeff0(acnt,acntp) gt 0)
                                         and (ACOEF.L(acnt,acntp) gt 0)),
                                ACOEF.L(acnt,acntp)* LOG(ACOEF.L(acnt,acntp))) /
                                SUM((acnt,acntp)$(Abar1(acnt,acntp)),
                                         Abar1(acnt,acntp)* LOG (Abar1(acnt,acntp)))
       ;
 844   
 845   
 846   
 847   display SEM, SAMCE, VALDIFF, PERDIFF, bigdiffp, DENTROPY.L, SAMBALCHK , ERR1.L   ;
 848   
 849   
 850   SAM(AC,ACP) = SAMCE(AC,ACP)/SCALE;
 851   
 852  PARAMETER XLTEST;
 853  execute_unload "0output.gdx" SAM
 854  execute 'xlstalk.exe -m 0output.xlsx';
 855   XLTEST = ERRORLEVEL;
 856  IF(XLTEST = 1,
 857  execute 'xlstalk.exe -c 0output.xlsx';
 858  );
 859  IF(XLTEST = 2,
 860  execute 'xlstalk.exe -s 0output.xlsx';
 861  );
 862  execute 'gdxxrw.exe i=0output.gdx o=0output.xlsx index=index!a5' ;
 863  execute 'xlstalk.exe -o 0output.xlsx';
 864  DISPLAY XLTEST;


